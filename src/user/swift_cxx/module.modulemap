// The C++ headers Swift programs in FEATHEROS_SWIFT_CXX_PROGRAMS can import.
module HttpMessage {
    header "../http_message.h"
    requires cplusplus
    export *
}

module CxxInterop {
    header "../cxx_interop.h"
    requires cplusplus
    export *
}

module FeatherGraphics {
    header "../graphics/dirty_region.h"
    header "../graphics/surface.h"
    header "../graphics/display.h"
    header "../graphics/tile_sheet.h"
    requires cplusplus
    export *
}

module GfxCheck {
    header "../gfx_check.h"
    requires cplusplus
    export *
}
