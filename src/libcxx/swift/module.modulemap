// The C++ library as the Clang module std, which Swift imports as CxxStdlib, so upstream's overlay
// (String(std.string), std.string from String literals, ==, +, hashing, std.chrono durations from
// Duration) builds over it, with the toolchain's own CxxStdlibShim.
module std [system] {
    header "../include/algorithm"
    header "../include/array"
    header "../include/atomic"
    header "../include/barrier"
    header "../include/bit"
    header "../include/bitset"
    textual header "../include/cassert"
    header "../include/cctype"
    header "../include/cerrno"
    header "../include/cfloat"
    header "../include/charconv"
    header "../include/chrono"
    header "../include/cinttypes"
    header "../include/climits"
    header "../include/cmath"
    header "../include/compare"
    header "../include/concepts"
    header "../include/condition_variable"
    header "../include/csetjmp"
    header "../include/csignal"
    header "../include/cstdarg"
    header "../include/cstddef"
    header "../include/cstdint"
    header "../include/cstdio"
    header "../include/cstdlib"
    header "../include/cstring"
    header "../include/ctime"
    header "../include/cuchar"
    header "../include/deque"
    header "../include/exception"
    header "../include/expected"
    header "../include/format"
    header "../include/functional"
    header "../include/initializer_list"
    header "../include/iterator"
    header "../include/latch"
    header "../include/limits"
    header "../include/map"
    header "../include/memory"
    header "../include/mutex"
    header "../include/new"
    header "../include/numeric"
    header "../include/optional"
    header "../include/print"
    header "../include/queue"
    header "../include/ratio"
    header "../include/semaphore"
    header "../include/set"
    header "../include/shared_mutex"
    header "../include/span"
    header "../include/stack"
    header "../include/stop_token"
    header "../include/string"
    header "../include/string_view"
    header "../include/thread"
    header "../include/tuple"
    header "../include/type_traits"
    header "../include/unordered_map"
    header "../include/unordered_set"
    header "../include/utility"
    header "../include/variant"
    header "../include/vector"
    requires cplusplus
    export *
}
