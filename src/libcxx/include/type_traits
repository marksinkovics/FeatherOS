namespace __detail
{
// Void, functions and arrays of unknown bound have no destructor; references are destructible.
template <class T> consteval bool IsDestructible(bool nothrow)
{
    if constexpr (is_void_v<T> || is_function_v<T> || is_unbounded_array_v<T>)
    {
        return false;
    }
    else if constexpr (is_reference_v<T>)
    {
        return true;
    }
    else
    {
        using Element = remove_all_extents_t<T>;
        if (nothrow)
        {
            return requires(Element& object) {
                { object.~Element() } noexcept;
            };
        }
        return requires(Element& object) { object.~Element(); };
    }
}
} // namespace __detail

template <class T> struct is_destructible : bool_constant<__detail::IsDestructible<T>(false)>
