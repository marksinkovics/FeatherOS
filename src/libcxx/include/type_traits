template <class T> struct is_nothrow_swappable;

template <class T>
    requires is_move_constructible_v<T> && is_move_assignable_v<T>
constexpr void swap(T& left, T& right) noexcept(is_nothrow_move_constructible_v<T> &&
                                                is_nothrow_move_assignable_v<T>)
{
    T saved = _FSTD::move(left);
    left = _FSTD::move(right);
    right = _FSTD::move(saved);
}

template <class T, size_t Size>
    requires is_swappable<T>::value
constexpr void swap(T (&left)[Size], T (&right)[Size]) noexcept(is_nothrow_swappable<T>::value)
{
    for (size_t index = 0; index < Size; ++index)
    {
        swap(left[index], right[index]);
    }
}

namespace __detail::swap_lookup
{
using _FSTD::swap;

template <class T, class U, class = void> struct SwappableWith : false_type
{
};
template <class T, class U>
struct SwappableWith<
    T, U,
    void_t<decltype(swap(declval<T>(), declval<U>())), decltype(swap(declval<U>(), declval<T>()))>>
    : true_type
{
};

template <class T, class U, bool = SwappableWith<T, U>::value>
struct NothrowSwappableWith : bool_constant<noexcept(swap(declval<T>(), declval<U>())) &&
                                            noexcept(swap(declval<U>(), declval<T>()))>
{
};
template <class T, class U> struct NothrowSwappableWith<T, U, false> : false_type
{
};
} // namespace __detail::swap_lookup

template <class T, class U> struct is_swappable_with : __detail::swap_lookup::SwappableWith<T, U>
{
};
template <class T, class U>
inline constexpr bool is_swappable_with_v = is_swappable_with<T, U>::value;
template <class T>
struct is_swappable
    : __detail::swap_lookup::SwappableWith<add_lvalue_reference_t<T>, add_lvalue_reference_t<T>>
{
};
template <class T> inline constexpr bool is_swappable_v = is_swappable<T>::value;

template <class T, class U>
struct is_nothrow_swappable_with : __detail::swap_lookup::NothrowSwappableWith<T, U>
{
};
template <class T, class U>
inline constexpr bool is_nothrow_swappable_with_v = is_nothrow_swappable_with<T, U>::value;
template <class T>
struct is_nothrow_swappable : __detail::swap_lookup::NothrowSwappableWith<add_lvalue_reference_t<T>,
                                                                          add_lvalue_reference_t<T>>
{
};
template <class T> inline constexpr bool is_nothrow_swappable_v = is_nothrow_swappable<T>::value;

