template <class Result, class Callable, class... Args> consteval bool IsInvocableR(bool nothrow)
{
    if constexpr (requires { typename InvokeResult<void, Callable, Args...>::type; })
    {
        using Invoked = typename InvokeResult<void, Callable, Args...>::type;
        const bool invokes_nothrow =
            !nothrow || noexcept(__detail::Invoke(declval<Callable>(), declval<Args>()...));
        if constexpr (is_void_v<Result>)
        {
            return invokes_nothrow;
        }
        else
        {
            bool converts = nothrow ? is_nothrow_convertible_v<Invoked, Result>
                                    : is_convertible_v<Invoked, Result>;
#if __has_builtin(__reference_converts_from_temporary)
            converts = converts && !__reference_converts_from_temporary(Result, Invoked);
#endif
            return invokes_nothrow && converts;
        }
    }
    else
    {
        return false;
    }
}
