template <class T, class U> [[nodiscard]] constexpr auto&& forward_like(U&& value) noexcept
{
    constexpr bool adds_const = is_const_v<remove_reference_t<T>>;
    if constexpr (is_lvalue_reference_v<T&&>)
    {
        if constexpr (adds_const)
        {
            return static_cast<const remove_reference_t<U>&>(value);
        }
        else
        {
            return static_cast<remove_reference_t<U>&>(value);
        }
    }
    else
    {
        if constexpr (adds_const)
        {
            return static_cast<const remove_reference_t<U>&&>(value);
        }
        else
        {
            return static_cast<remove_reference_t<U>&&>(value);
        }
    }
}

template <class T>
[[nodiscard]] constexpr conditional_t<
    !is_nothrow_move_constructible_v<T> && is_copy_constructible_v<T>, const T&, T&&>
move_if_noexcept(T& value) noexcept
{
    return _FSTD::move(value);
}

template <class T> [[nodiscard]] constexpr add_const_t<T>& as_const(T& value) noexcept
{
    return value;
}
template <class T> void as_const(const T&&) = delete;

template <class T, class U = T>
constexpr T exchange(T& target, U&& replacement) noexcept(is_nothrow_move_constructible_v<T> &&
                                                          is_nothrow_assignable_v<T&, U>)
{
    T previous = _FSTD::move(target);
    target = _FSTD::forward<U>(replacement);
    return previous;
}

template <class Enum>
[[nodiscard]] constexpr underlying_type_t<Enum> to_underlying(Enum value) noexcept
{
    return static_cast<underlying_type_t<Enum>>(value);
}

[[noreturn]] inline void unreachable()
{
    __builtin_unreachable();
}

// Integer comparisons that compare values, not converted bit patterns, across signedness.
namespace __detail
{
template <class T>
concept StandardInteger =
    is_integral_v<T> && !is_same_v<remove_cv_t<T>, bool> && !is_same_v<remove_cv_t<T>, char> &&
    !is_same_v<remove_cv_t<T>, wchar_t> && !is_same_v<remove_cv_t<T>, char8_t> &&
    !is_same_v<remove_cv_t<T>, char16_t> && !is_same_v<remove_cv_t<T>, char32_t>;
} // namespace __detail

template <__detail::StandardInteger T, __detail::StandardInteger U>
constexpr bool cmp_equal(T left, U right) noexcept
{
    if constexpr (is_signed_v<T> == is_signed_v<U>)
    {
        return left == right;
    }
    else if constexpr (is_signed_v<T>)
    {
        return left >= 0 && make_unsigned_t<T>(left) == right;
    }
    else
    {
        return right >= 0 && make_unsigned_t<U>(right) == left;
    }
}

template <__detail::StandardInteger T, __detail::StandardInteger U>
constexpr bool cmp_not_equal(T left, U right) noexcept
{
    return !cmp_equal(left, right);
}

template <__detail::StandardInteger T, __detail::StandardInteger U>
constexpr bool cmp_less(T left, U right) noexcept
{
    if constexpr (is_signed_v<T> == is_signed_v<U>)
    {
        return left < right;
    }
    else if constexpr (is_signed_v<T>)
    {
        return left < 0 || make_unsigned_t<T>(left) < right;
    }
    else
    {
        return right >= 0 && left < make_unsigned_t<U>(right);
    }
}

template <__detail::StandardInteger T, __detail::StandardInteger U>
constexpr bool cmp_greater(T left, U right) noexcept
{
    return cmp_less(right, left);
}

template <__detail::StandardInteger T, __detail::StandardInteger U>
constexpr bool cmp_less_equal(T left, U right) noexcept
{
    return !cmp_less(right, left);
}

template <__detail::StandardInteger T, __detail::StandardInteger U>
constexpr bool cmp_greater_equal(T left, U right) noexcept
{
    return !cmp_less(left, right);
}

template <__detail::StandardInteger Result, __detail::StandardInteger T>
constexpr bool in_range(T value) noexcept
{
    return cmp_greater_equal(value, numeric_limits<Result>::min()) &&
           cmp_less_equal(value, numeric_limits<Result>::max());
}

template <class T, T... Values> struct integer_sequence
{
    using value_type = T;
    static constexpr size_t size() noexcept
    {
        return sizeof...(Values);
    }
};

// Clang and GCC each have a builtin that builds the sequence without recursion.
#if __has_builtin(__make_integer_seq)
template <class T, T Count>
using make_integer_sequence = __make_integer_seq<integer_sequence, T, Count>;
#else
template <class T, T Count>
using make_integer_sequence = integer_sequence<T, __integer_pack(Count)...>;
#endif

template <size_t... Values> using index_sequence = integer_sequence<size_t, Values...>;
template <size_t Count> using make_index_sequence = make_integer_sequence<size_t, Count>;
template <class... T> using index_sequence_for = make_index_sequence<sizeof...(T)>;

// Pack helpers for tuple and variant.
namespace __detail
{
#if __has_builtin(__type_pack_element)
// Wrapped, since GCC rejects the builtin itself in a function signature.
template <size_t Index, class... T> struct PackElementOf
{
    using type = __type_pack_element<Index, T...>;
};
template <size_t Index, class... T> using PackElement = typename PackElementOf<Index, T...>::type;
#else
template <size_t Index, class T> struct IndexedType
{
    using type = T;
};
template <class Indices, class... T> struct IndexedTypes;
template <size_t... Index, class... T>
struct IndexedTypes<index_sequence<Index...>, T...> : IndexedType<Index, T>...
{
};
template <size_t Index, class T> IndexedType<Index, T> SelectIndexed(const IndexedType<Index, T>&);
template <size_t Index, class... T>
using PackElement =
    typename decltype(SelectIndexed<Index>(IndexedTypes<index_sequence_for<T...>, T...>{}))::type;
#endif

template <class T, class... Types>
inline constexpr size_t PackCount = (size_t{is_same_v<T, Types>} + ... + 0);

// The index of T's first occurrence, or sizeof...(Types) when it does not occur.
template <class T, class... Types> consteval size_t PackIndex()
{
    constexpr bool matches[] = {is_same_v<T, Types>..., true};
    size_t index = 0;
    while (!matches[index])
    {
        ++index;
    }
    return index;
}
} // namespace __detail

