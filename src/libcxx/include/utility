constexpr T& get(pair<T, U>& value) noexcept
    requires(!is_same_v<T, U>)
{
    return value.first;
}

template <class T, class U>
constexpr const T& get(const pair<T, U>& value) noexcept
    requires(!is_same_v<T, U>)
{
    return value.first;
}

template <class T, class U>
constexpr T&& get(pair<T, U>&& value) noexcept
    requires(!is_same_v<T, U>)
{
    return static_cast<T&&>(value.first);
}

template <class T, class U>
constexpr const T&& get(const pair<T, U>&& value) noexcept
    requires(!is_same_v<T, U>)
{
