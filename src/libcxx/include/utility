namespace __detail
{
template <size_t Index, class Pair> constexpr auto&& PairElement(Pair&& value) noexcept
{
    if constexpr (Index == 0)
    {
        return _FSTD::forward<Pair>(value).first;
    }
    else
    {
        return _FSTD::forward<Pair>(value).second;
    }
}
} // namespace __detail

template <size_t Index, class T1, class T2>
constexpr tuple_element_t<Index, pair<T1, T2>>& get(pair<T1, T2>& value) noexcept
{
    return __detail::PairElement<Index>(value);
}

template <size_t Index, class T1, class T2>
constexpr const tuple_element_t<Index, pair<T1, T2>>& get(const pair<T1, T2>& value) noexcept
{
    return __detail::PairElement<Index>(value);
}

template <size_t Index, class T1, class T2>
constexpr tuple_element_t<Index, pair<T1, T2>>&& get(pair<T1, T2>&& value) noexcept
{
    return static_cast<tuple_element_t<Index, pair<T1, T2>>&&>(__detail::PairElement<Index>(value));
}

template <size_t Index, class T1, class T2>
