// The tuple protocol, which structured bindings use: <tuple> and <array> add their types.
template <class T> struct tuple_size;
template <class T>
    requires requires { tuple_size<T>::value; }
struct tuple_size<const T> : integral_constant<size_t, tuple_size<T>::value>
{
};
template <class T> inline constexpr size_t tuple_size_v = tuple_size<T>::value;

template <size_t Index, class T> struct tuple_element;
template <size_t Index, class T> struct tuple_element<Index, const T>
{
    using type = add_const_t<typename tuple_element<Index, T>::type>;
};
template <size_t Index, class T> using tuple_element_t = typename tuple_element<Index, T>::type;

namespace __detail
{
template <class T> void CopyListInitialize(const T&);

// Whether T{} works as an implicit conversion, which makes pair's default constructor implicit.
template <class T>
concept ImplicitlyDefaultConstructible = requires { CopyListInitialize<T>({}); };
} // namespace __detail

namespace __detail
{
// The converts-from-any-cvref of [optional.ctor], which expected shares.
template <class T, class W>
concept ConvertsFromAnyCvref =
    is_constructible_v<T, W&> || is_convertible_v<W&, T> || is_constructible_v<T, W> ||
    is_convertible_v<W, T> || is_constructible_v<T, const W&> || is_convertible_v<const W&, T> ||
    is_constructible_v<T, const W> || is_convertible_v<const W, T>;
} // namespace __detail

// <tuple> defines these; pair's piecewise constructor needs them declared before it.
template <class... T> class tuple;
template <size_t Index, class... T>
constexpr tuple_element_t<Index, tuple<T...>>& get(tuple<T...>& value) noexcept;

template <class First, class Second> struct pair
{
    using first_type = First;
    using second_type = Second;

    First first;
    Second second;

    explicit(!__detail::ImplicitlyDefaultConstructible<First> ||
             !__detail::ImplicitlyDefaultConstructible<Second>) constexpr pair()
        requires is_default_constructible_v<First> && is_default_constructible_v<Second>
        : first(), second()
    {
    }

    explicit(!is_convertible_v<const First&, First> ||
             !is_convertible_v<const Second&, Second>) constexpr pair(const First& first_value,
                                                                      const Second& second_value)
        requires is_copy_constructible_v<First> && is_copy_constructible_v<Second>
        : first(first_value), second(second_value)
    {
    }

    template <class U1 = First, class U2 = Second>
        requires is_constructible_v<First, U1> && is_constructible_v<Second, U2>
    explicit(!is_convertible_v<U1, First> ||
             !is_convertible_v<U2, Second>) constexpr pair(U1&& first_value, U2&& second_value)
        : first(_FSTD::forward<U1>(first_value)), second(_FSTD::forward<U2>(second_value))
    {
    }

    template <class U1, class U2>
        requires is_constructible_v<First, U1&> && is_constructible_v<Second, U2&>
    explicit(!is_convertible_v<U1&, First> ||
             !is_convertible_v<U2&, Second>) constexpr pair(pair<U1, U2>& other)
        : first(other.first), second(other.second)
    {
    }

    template <class U1, class U2>
        requires is_constructible_v<First, const U1&> && is_constructible_v<Second, const U2&>
    explicit(!is_convertible_v<const U1&, First> ||
             !is_convertible_v<const U2&, Second>) constexpr pair(const pair<U1, U2>& other)
        : first(other.first), second(other.second)
    {
    }

    template <class U1, class U2>
        requires is_constructible_v<First, U1> && is_constructible_v<Second, U2>
    explicit(!is_convertible_v<U1, First> ||
             !is_convertible_v<U2, Second>) constexpr pair(pair<U1, U2>&& other)
        : first(_FSTD::forward<U1>(other.first)), second(_FSTD::forward<U2>(other.second))
    {
    }

    template <class U1, class U2>
        requires is_constructible_v<First, const U1> && is_constructible_v<Second, const U2>
    explicit(!is_convertible_v<const U1, First> ||
             !is_convertible_v<const U2, Second>) constexpr pair(const pair<U1, U2>&& other)
        : first(_FSTD::forward<const U1>(other.first)),
          second(_FSTD::forward<const U2>(other.second))
    {
    }

    template <class... Args1, class... Args2>
        requires is_constructible_v<First, Args1...> && is_constructible_v<Second, Args2...>
    constexpr pair(piecewise_construct_t, tuple<Args1...> first_args, tuple<Args2...> second_args)
        : pair(first_args, second_args, index_sequence_for<Args1...>{},
               index_sequence_for<Args2...>{})
    {
    }

    pair(const pair&) = default;
    pair(pair&&) = default;

    // Assignment goes through the members, so a pair of references assigns what they refer to.
    constexpr pair& operator=(const pair& other)
        requires is_copy_assignable_v<First> && is_copy_assignable_v<Second>
    {
        first = other.first;
        second = other.second;
        return *this;
    }

    constexpr pair& operator=(pair&& other) noexcept(is_nothrow_move_assignable_v<First> &&
                                                     is_nothrow_move_assignable_v<Second>)
        requires is_move_assignable_v<First> && is_move_assignable_v<Second>
    {
        first = _FSTD::forward<First>(other.first);
        second = _FSTD::forward<Second>(other.second);
        return *this;
    }

    template <class U1, class U2>
        requires is_assignable_v<First&, const U1&> && is_assignable_v<Second&, const U2&>
    constexpr pair& operator=(const pair<U1, U2>& other)
    {
        first = other.first;
        second = other.second;
        return *this;
    }

    template <class U1, class U2>
        requires is_assignable_v<First&, U1> && is_assignable_v<Second&, U2>
    constexpr pair& operator=(pair<U1, U2>&& other)
    {
        first = _FSTD::forward<U1>(other.first);
        second = _FSTD::forward<U2>(other.second);
        return *this;
    }

    constexpr void swap(pair& other) noexcept(is_nothrow_swappable_v<First> &&
                                              is_nothrow_swappable_v<Second>)
        requires is_swappable_v<First> && is_swappable_v<Second>
    {
        using _FSTD::swap;
        swap(first, other.first);
        swap(second, other.second);
    }

private:
    template <class... Args1, class... Args2, size_t... Index1, size_t... Index2>
    constexpr pair(tuple<Args1...>& first_args, tuple<Args2...>& second_args,
                   index_sequence<Index1...>, index_sequence<Index2...>)
        : first(_FSTD::forward<Args1>(_FSTD::get<Index1>(first_args))...),
          second(_FSTD::forward<Args2>(_FSTD::get<Index2>(second_args))...)
    {
    }
};

template <class First, class Second> pair(First, Second) -> pair<First, Second>;

template <class T1, class T2, class U1, class U2>
constexpr bool operator==(const pair<T1, T2>& left, const pair<U1, U2>& right)
    requires requires {
        { left.first == right.first } -> __detail::BooleanTestable;
        { left.second == right.second } -> __detail::BooleanTestable;
    }
{
    return left.first == right.first && left.second == right.second;
}

template <class T1, class T2, class U1, class U2>
constexpr common_comparison_category_t<__detail::SynthThreeWayResult<T1, U1>,
                                       __detail::SynthThreeWayResult<T2, U2>>
operator<=>(const pair<T1, T2>& left, const pair<U1, U2>& right)
{
    if (auto order = __detail::synth_three_way(left.first, right.first); order != 0)
    {
        return order;
    }
    return __detail::synth_three_way(left.second, right.second);
}

template <class T1, class T2>
    requires is_swappable_v<T1> && is_swappable_v<T2>
constexpr void swap(pair<T1, T2>& left, pair<T1, T2>& right) noexcept(noexcept(left.swap(right)))
{
    left.swap(right);
}

template <class T1, class T2>
constexpr pair<unwrap_ref_decay_t<T1>, unwrap_ref_decay_t<T2>> make_pair(T1&& first, T2&& second)
{
    return pair<unwrap_ref_decay_t<T1>, unwrap_ref_decay_t<T2>>(_FSTD::forward<T1>(first),
                                                                _FSTD::forward<T2>(second));
}

template <class T1, class T2, class U1, class U2, template <class> class TQualifiers,
          template <class> class UQualifiers>
    requires requires {
        typename pair<common_reference_t<TQualifiers<T1>, UQualifiers<U1>>,
                      common_reference_t<TQualifiers<T2>, UQualifiers<U2>>>;
    }
struct basic_common_reference<pair<T1, T2>, pair<U1, U2>, TQualifiers, UQualifiers>
{
    using type = pair<common_reference_t<TQualifiers<T1>, UQualifiers<U1>>,
                      common_reference_t<TQualifiers<T2>, UQualifiers<U2>>>;
};

template <class T1, class T2, class U1, class U2>
    requires requires { typename pair<common_type_t<T1, U1>, common_type_t<T2, U2>>; }
struct common_type<pair<T1, T2>, pair<U1, U2>>
{
    using type = pair<common_type_t<T1, U1>, common_type_t<T2, U2>>;
};

