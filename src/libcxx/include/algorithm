// Heaps: a max-heap by compare, rooted at first.

namespace __detail
{
template <class R, class C>
constexpr void SiftDown(R first, IterDifference<R> length, IterDifference<R> hole, C& compare)
{
    IterValue<R> value = _FSTD::move(first[hole]);
    for (;;)
    {
        IterDifference<R> child = 2 * hole + 1;
        if (child >= length)
        {
            break;
        }
        if (child + 1 < length && compare(first[child], first[child + 1]))
        {
            ++child;
        }
        if (!compare(value, first[child]))
        {
            break;
        }
        first[hole] = _FSTD::move(first[child]);
        hole = child;
    }
    first[hole] = _FSTD::move(value);
}

template <class R, class C> constexpr void SiftUp(R first, IterDifference<R> hole, C& compare)
{
    IterValue<R> value = _FSTD::move(first[hole]);
    while (hole > 0)
    {
        const IterDifference<R> parent = (hole - 1) / 2;
        if (!compare(first[parent], value))
        {
            break;
        }
        first[hole] = _FSTD::move(first[parent]);
        hole = parent;
    }
    first[hole] = _FSTD::move(value);
}

template <class R, class C> constexpr void PopHeap(R first, R last, C& compare)
{
    const auto length = last - first;
    if (length > 1)
    {
        _FSTD::iter_swap(first, last - 1);
        SiftDown(first, length - 1, IterDifference<R>(0), compare);
    }
}

template <class R, class C> constexpr void MakeHeap(R first, R last, C& compare)
{
    const auto length = last - first;
    for (auto parent = length / 2; parent > 0;)
    {
        --parent;
        SiftDown(first, length, parent, compare);
    }
}

template <class R, class C> constexpr void SortHeap(R first, R last, C& compare)
{
    for (; last - first > 1; --last)
    {
        PopHeap(first, last, compare);
    }
}
} // namespace __detail

template <class R, class C> constexpr void push_heap(R first, R last, C compare)
{
