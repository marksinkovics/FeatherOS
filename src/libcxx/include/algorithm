// Uninitialized storage for up to a requested number of T, or none when memory is short.
template <class T> class TemporaryBuffer
{
public:
    explicit TemporaryBuffer(ptrdiff_t wanted) noexcept
    {
        if (wanted <= 0)
        {
            return;
        }
        const auto bytes = static_cast<size_t>(wanted) * sizeof(T);
        if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__)
        {
            m_data = static_cast<T*>(::operator new(bytes, align_val_t(alignof(T)), nothrow));
        }
        else
        {
            m_data = static_cast<T*>(::operator new(bytes, nothrow));
        }
        if (m_data != nullptr)
        {
            m_capacity = wanted;
        }
    }

    TemporaryBuffer(const TemporaryBuffer&) = delete;
    TemporaryBuffer& operator=(const TemporaryBuffer&) = delete;

    ~TemporaryBuffer()
    {
        if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__)
        {
            ::operator delete(m_data, align_val_t(alignof(T)), nothrow);
        }
        else
        {
            ::operator delete(m_data, nothrow);
        }
    }

    T* Data() const noexcept
    {
        return m_data;
    }
    ptrdiff_t Capacity() const noexcept
    {
        return m_capacity;
    }

private:
    T* m_data = nullptr;
    ptrdiff_t m_capacity = 0;
};

template <class B, class P, class T>
B StablePartitionWithBuffer(B first, B last, P& predicate, T* buffer)
{
    T* rejected = buffer;
    B kept = first;
    for (; first != last; ++first)
    {
        if (predicate(*first))
        {
            *kept = _FSTD::move(*first);
            ++kept;
        }
        else
        {
            ::new (static_cast<void*>(rejected)) T(_FSTD::move(*first));
            ++rejected;
        }
    }
    B out = kept;
    for (T* element = buffer; element != rejected; ++element, (void)++out)
    {
        *out = _FSTD::move(*element);
        _FSTD::destroy_at(element);
    }
    return kept;
}

template <class F, class P, class Distance>
F StablePartitionInPlace(F first, F last, P& predicate, Distance length)
{
    if (length == 1)
    {
        return predicate(*first) ? last : first;
    }
    F middle = _FSTD::next(first, length / 2);
    F left = StablePartitionInPlace(first, middle, predicate, length / 2);
    F right = StablePartitionInPlace(middle, last, predicate, length - length / 2);
    return _FSTD::rotate(left, middle, right);
}
} // namespace __detail

template <class B, class P> B stable_partition(B first, B last, P predicate)
{
    first = _FSTD::find_if_not(first, last, predicate);
    if (first == last)
    {
        return first;
    }
    const auto length = _FSTD::distance(first, last);
    __detail::TemporaryBuffer<__detail::IterValue<B>> buffer(length);
    if (buffer.Capacity() >= length)
    {
        return __detail::StablePartitionWithBuffer(first, last, predicate, buffer.Data());
    }
    return __detail::StablePartitionInPlace(first, last, predicate, length);
}

