// The classic algorithms of C++23, without execution policies. The ranges:: forms are left out.
// stable_sort, stable_partition and inplace_merge use a temporary buffer when operator new
// (nothrow) gives one, and work in place, more slowly, when it does not.

namespace FEATHEROS_STD_NAMESPACE
{

namespace __detail
{
struct Less
{
    template <class T, class U> constexpr bool operator()(T&& left, U&& right) const
    {
        return _FSTD::forward<T>(left) < _FSTD::forward<U>(right);
    }
};

struct EqualTo
{
    template <class T, class U> constexpr bool operator()(T&& left, U&& right) const
    {
        return _FSTD::forward<T>(left) == _FSTD::forward<U>(right);
    }
};

template <class I> using IterDifference = typename iterator_traits<I>::difference_type;
template <class I> using IterValue = typename iterator_traits<I>::value_type;

// Both ends pointers to the same trivially copyable type, so copying is a memmove.
template <class In, class Out>
concept TriviallyCopyablePointers =
    is_pointer_v<In> && is_pointer_v<Out> &&
    is_same_v<remove_const_t<remove_pointer_t<In>>, remove_pointer_t<Out>> &&
    is_trivially_copyable_v<remove_pointer_t<Out>> && !is_volatile_v<remove_pointer_t<Out>>;
} // namespace __detail

// Non-modifying sequence operations.

template <class I, class P> constexpr bool all_of(I first, I last, P predicate)
{
    for (; first != last; ++first)
    {
        if (!predicate(*first))
        {
            return false;
        }
    }
    return true;
}

template <class I, class P> constexpr bool any_of(I first, I last, P predicate)
{
    for (; first != last; ++first)
    {
        if (predicate(*first))
        {
            return true;
        }
    }
    return false;
}

template <class I, class P> constexpr bool none_of(I first, I last, P predicate)
{
    return !_FSTD::any_of(first, last, predicate);
}

template <class I, class F> constexpr F for_each(I first, I last, F function)
{
    for (; first != last; ++first)
    {
        function(*first);
    }
    return function;
}

template <class I, class Size, class F> constexpr I for_each_n(I first, Size count, F function)
{
    for (; count > 0; ++first, (void)--count)
    {
        function(*first);
    }
    return first;
}

template <class I, class T = __detail::IterValue<I>>
constexpr I find(I first, I last, const T& value)
{
    for (; first != last; ++first)
    {
        if (*first == value)
        {
            return first;
        }
    }
    return last;
}

template <class I, class P> constexpr I find_if(I first, I last, P predicate)
{
    for (; first != last; ++first)
    {
        if (predicate(*first))
        {
            return first;
        }
    }
    return last;
}

template <class I, class P> constexpr I find_if_not(I first, I last, P predicate)
{
    for (; first != last; ++first)
    {
        if (!predicate(*first))
        {
            return first;
        }
    }
    return last;
}

template <class I1, class I2, class P>
constexpr I1 search(I1 first, I1 last, I2 pattern_first, I2 pattern_last, P predicate)
{
    for (;; ++first)
    {
        I1 candidate = first;
        I2 pattern = pattern_first;
        for (;; ++candidate, ++pattern)
        {
            if (pattern == pattern_last)
            {
                return first;
            }
            if (candidate == last)
            {
                return last;
            }
            if (!predicate(*candidate, *pattern))
            {
                break;
            }
        }
    }
}

template <class I1, class I2>
constexpr I1 search(I1 first, I1 last, I2 pattern_first, I2 pattern_last)
{
    return _FSTD::search(first, last, pattern_first, pattern_last, __detail::EqualTo());
}

template <class I, class Searcher> constexpr I search(I first, I last, const Searcher& searcher)
{
    return searcher(first, last).first;
}

template <class I, class Size, class T, class P>
constexpr I search_n(I first, I last, Size count, const T& value, P predicate)
{
    if (count <= 0)
    {
        return first;
    }
    for (; first != last; ++first)
    {
        if (!predicate(*first, value))
        {
            continue;
        }
        I start = first;
        Size matched = 1;
        for (;;)
        {
            if (matched == count)
            {
                return start;
            }
            if (++first == last)
            {
                return last;
            }
            if (!predicate(*first, value))
            {
                break;
            }
            ++matched;
        }
    }
    return last;
}

template <class I, class Size, class T = __detail::IterValue<I>>
constexpr I search_n(I first, I last, Size count, const T& value)
{
    return _FSTD::search_n(first, last, count, value, __detail::EqualTo());
}

template <class I1, class I2, class P>
constexpr I1 find_end(I1 first, I1 last, I2 pattern_first, I2 pattern_last, P predicate)
{
    if (pattern_first == pattern_last)
    {
        return last;
    }
    I1 result = last;
    for (;;)
    {
        I1 found = _FSTD::search(first, last, pattern_first, pattern_last, predicate);
        if (found == last)
        {
            return result;
        }
        result = found;
        first = found;
        ++first;
    }
}

template <class I1, class I2>
constexpr I1 find_end(I1 first, I1 last, I2 pattern_first, I2 pattern_last)
{
    return _FSTD::find_end(first, last, pattern_first, pattern_last, __detail::EqualTo());
}

template <class I1, class I2, class P>
constexpr I1 find_first_of(I1 first, I1 last, I2 set_first, I2 set_last, P predicate)
{
    for (; first != last; ++first)
    {
        for (I2 candidate = set_first; candidate != set_last; ++candidate)
        {
            if (predicate(*first, *candidate))
            {
                return first;
            }
        }
    }
    return last;
}

template <class I1, class I2>
constexpr I1 find_first_of(I1 first, I1 last, I2 set_first, I2 set_last)
{
    return _FSTD::find_first_of(first, last, set_first, set_last, __detail::EqualTo());
}

template <class I, class P> constexpr I adjacent_find(I first, I last, P predicate)
{
    if (first == last)
    {
        return last;
    }
    for (I next = first; ++next != last; first = next)
    {
        if (predicate(*first, *next))
        {
            return first;
        }
    }
    return last;
}

template <class I> constexpr I adjacent_find(I first, I last)
{
    return _FSTD::adjacent_find(first, last, __detail::EqualTo());
}

template <class I, class P>
constexpr __detail::IterDifference<I> count_if(I first, I last, P predicate)
{
    __detail::IterDifference<I> result = 0;
    for (; first != last; ++first)
    {
        if (predicate(*first))
        {
            ++result;
        }
    }
    return result;
}

template <class I, class T = __detail::IterValue<I>>
constexpr __detail::IterDifference<I> count(I first, I last, const T& value)
{
    __detail::IterDifference<I> result = 0;
    for (; first != last; ++first)
    {
        if (*first == value)
        {
            ++result;
        }
    }
    return result;
}

template <class I1, class I2, class P>
constexpr pair<I1, I2> mismatch(I1 first1, I1 last1, I2 first2, P predicate)
{
    for (; first1 != last1 && predicate(*first1, *first2); ++first1, (void)++first2)
    {
    }
    return pair<I1, I2>(first1, first2);
}

template <class I1, class I2> constexpr pair<I1, I2> mismatch(I1 first1, I1 last1, I2 first2)
{
    return _FSTD::mismatch(first1, last1, first2, __detail::EqualTo());
}

template <class I1, class I2, class P>
constexpr pair<I1, I2> mismatch(I1 first1, I1 last1, I2 first2, I2 last2, P predicate)
{
    for (; first1 != last1 && first2 != last2 && predicate(*first1, *first2);
         ++first1, (void)++first2)
    {
    }
    return pair<I1, I2>(first1, first2);
}

template <class I1, class I2>
constexpr pair<I1, I2> mismatch(I1 first1, I1 last1, I2 first2, I2 last2)
{
    return _FSTD::mismatch(first1, last1, first2, last2, __detail::EqualTo());
}

template <class I1, class I2, class P>
constexpr bool equal(I1 first1, I1 last1, I2 first2, P predicate)
{
    for (; first1 != last1; ++first1, (void)++first2)
    {
        if (!predicate(*first1, *first2))
        {
            return false;
        }
    }
    return true;
}

template <class I1, class I2> constexpr bool equal(I1 first1, I1 last1, I2 first2)
{
    return _FSTD::equal(first1, last1, first2, __detail::EqualTo());
}

template <class I1, class I2, class P>
constexpr bool equal(I1 first1, I1 last1, I2 first2, I2 last2, P predicate)
{
    if constexpr (__detail::ClassicRandomAccess<I1> && __detail::ClassicRandomAccess<I2>)
    {
        if (last1 - first1 != last2 - first2)
        {
            return false;
        }
        return _FSTD::equal(first1, last1, first2, predicate);
    }
    else
    {
        for (; first1 != last1 && first2 != last2; ++first1, (void)++first2)
        {
            if (!predicate(*first1, *first2))
            {
                return false;
            }
        }
        return first1 == last1 && first2 == last2;
    }
}

template <class I1, class I2> constexpr bool equal(I1 first1, I1 last1, I2 first2, I2 last2)
{
    return _FSTD::equal(first1, last1, first2, last2, __detail::EqualTo());
}

template <class I1, class I2, class P>
constexpr bool is_permutation(I1 first1, I1 last1, I2 first2, I2 last2, P predicate)
{
    auto [rest1, rest2] = _FSTD::mismatch(first1, last1, first2, last2, predicate);
    if (_FSTD::distance(rest1, last1) != _FSTD::distance(rest2, last2))
    {
        return false;
    }
    for (I1 current = rest1; current != last1; ++current)
    {
        auto same = [&](auto&& other) { return predicate(*current, other); };
        if (_FSTD::find_if(rest1, current, same) != current)
        {
            continue;
        }
        const auto in_second = _FSTD::count_if(rest2, last2, same);
        if (in_second == 0 || _FSTD::count_if(current, last1, same) != in_second)
        {
            return false;
        }
    }
    return true;
}

template <class I1, class I2>
constexpr bool is_permutation(I1 first1, I1 last1, I2 first2, I2 last2)
{
    return _FSTD::is_permutation(first1, last1, first2, last2, __detail::EqualTo());
}

template <class I1, class I2, class P>
constexpr bool is_permutation(I1 first1, I1 last1, I2 first2, P predicate)
{
    return _FSTD::is_permutation(first1, last1, first2,
                                 _FSTD::next(first2, _FSTD::distance(first1, last1)), predicate);
}

template <class I1, class I2> constexpr bool is_permutation(I1 first1, I1 last1, I2 first2)
{
    return _FSTD::is_permutation(first1, last1, first2, __detail::EqualTo());
}

// Modifying sequence operations.

template <class I, class O> constexpr O copy(I first, I last, O out)
{
    if constexpr (__detail::TriviallyCopyablePointers<I, O>)
    {
        if (!__builtin_is_constant_evaluated())
        {
            const auto count = static_cast<size_t>(last - first);
            if (count != 0)
            {
                __builtin_memmove(out, first, count * sizeof(*out));
            }
            return out + count;
        }
    }
    for (; first != last; ++first, (void)++out)
    {
        *out = *first;
    }
    return out;
}

template <class I, class Size, class O> constexpr O copy_n(I first, Size count, O out)
{
    for (; count > 0; ++first, (void)++out, --count)
    {
        *out = *first;
    }
    return out;
}

template <class I, class O, class P> constexpr O copy_if(I first, I last, O out, P predicate)
{
    for (; first != last; ++first)
    {
        if (predicate(*first))
        {
            *out = *first;
            ++out;
        }
    }
    return out;
}

template <class B1, class B2> constexpr B2 copy_backward(B1 first, B1 last, B2 out_last)
{
    if constexpr (__detail::TriviallyCopyablePointers<B1, B2>)
    {
        if (!__builtin_is_constant_evaluated())
        {
            const auto count = static_cast<size_t>(last - first);
            if (count != 0)
            {
                __builtin_memmove(out_last - count, first, count * sizeof(*out_last));
            }
            return out_last - count;
        }
    }
    while (first != last)
    {
        *--out_last = *--last;
    }
    return out_last;
}

template <class I, class O> constexpr O move(I first, I last, O out)
{
    if constexpr (__detail::TriviallyCopyablePointers<I, O>)
    {
        return _FSTD::copy(first, last, out);
    }
    else
    {
        for (; first != last; ++first, (void)++out)
        {
            *out = _FSTD::move(*first);
        }
        return out;
    }
}

template <class B1, class B2> constexpr B2 move_backward(B1 first, B1 last, B2 out_last)
{
    if constexpr (__detail::TriviallyCopyablePointers<B1, B2>)
    {
        return _FSTD::copy_backward(first, last, out_last);
    }
    else
    {
        while (first != last)
        {
            *--out_last = _FSTD::move(*--last);
        }
        return out_last;
    }
}

template <class F, class T = __detail::IterValue<F>>
constexpr void fill(F first, F last, const T& value)
{
    for (; first != last; ++first)
    {
        *first = value;
    }
}

template <class O, class Size, class T = typename iterator_traits<O>::value_type>
constexpr O fill_n(O first, Size count, const T& value)
{
    for (; count > 0; ++first, (void)--count)
    {
        *first = value;
    }
    return first;
}

template <class I, class O, class F> constexpr O transform(I first, I last, O out, F operation)
{
    for (; first != last; ++first, (void)++out)
    {
        *out = operation(*first);
    }
    return out;
}

template <class I1, class I2, class O, class F>
constexpr O transform(I1 first1, I1 last1, I2 first2, O out, F operation)
{
    for (; first1 != last1; ++first1, (void)++first2, ++out)
    {
        *out = operation(*first1, *first2);
    }
    return out;
}

template <class F, class G> constexpr void generate(F first, F last, G generator)
{
    for (; first != last; ++first)
    {
        *first = generator();
    }
}

template <class O, class Size, class G> constexpr O generate_n(O first, Size count, G generator)
{
    for (; count > 0; ++first, (void)--count)
    {
        *first = generator();
    }
    return first;
}

template <class F, class P> constexpr F remove_if(F first, F last, P predicate)
{
    first = _FSTD::find_if(first, last, predicate);
    if (first == last)
    {
        return first;
    }
    for (F current = first; ++current != last;)
    {
        if (!predicate(*current))
        {
            *first = _FSTD::move(*current);
            ++first;
        }
    }
    return first;
}

template <class F, class T = __detail::IterValue<F>>
constexpr F remove(F first, F last, const T& value)
{
    return _FSTD::remove_if(first, last,
                            [&value](const auto& element) { return element == value; });
}

template <class I, class O, class P> constexpr O remove_copy_if(I first, I last, O out, P predicate)
{
    for (; first != last; ++first)
    {
        if (!predicate(*first))
        {
            *out = *first;
            ++out;
        }
    }
    return out;
}

template <class I, class O, class T = __detail::IterValue<I>>
constexpr O remove_copy(I first, I last, O out, const T& value)
{
    return _FSTD::remove_copy_if(first, last, out,
                                 [&value](const auto& element) { return element == value; });
}

template <class F, class P, class T = __detail::IterValue<F>>
constexpr void replace_if(F first, F last, P predicate, const T& replacement)
{
    for (; first != last; ++first)
    {
        if (predicate(*first))
        {
            *first = replacement;
        }
    }
}

template <class F, class T = __detail::IterValue<F>>
constexpr void replace(F first, F last, const T& old_value, const T& new_value)
{
    for (; first != last; ++first)
    {
        if (*first == old_value)
        {
            *first = new_value;
        }
    }
}

template <class I, class O, class P, class T = typename iterator_traits<O>::value_type>
constexpr O replace_copy_if(I first, I last, O out, P predicate, const T& replacement)
{
    for (; first != last; ++first, (void)++out)
    {
        if (predicate(*first))
        {
            *out = replacement;
        }
        else
        {
            *out = *first;
        }
    }
    return out;
}

template <class I, class O, class T>
constexpr O replace_copy(I first, I last, O out, const T& old_value, const T& new_value)
{
    for (; first != last; ++first, (void)++out)
    {
        if (*first == old_value)
        {
            *out = new_value;
        }
        else
        {
            *out = *first;
        }
    }
    return out;
}

template <class F1, class F2> constexpr void iter_swap(F1 left, F2 right)
{
    using _FSTD::swap;
    swap(*left, *right);
}

template <class F1, class F2> constexpr F2 swap_ranges(F1 first1, F1 last1, F2 first2)
{
    for (; first1 != last1; ++first1, (void)++first2)
    {
        _FSTD::iter_swap(first1, first2);
    }
    return first2;
}

template <class B> constexpr void reverse(B first, B last)
{
    if constexpr (__detail::ClassicRandomAccess<B>)
    {
        if (first == last)
        {
            return;
        }
        for (--last; first < last; ++first, (void)--last)
        {
            _FSTD::iter_swap(first, last);
        }
    }
    else
    {
        while (first != last && first != --last)
        {
            _FSTD::iter_swap(first, last);
            ++first;
        }
    }
}

template <class B, class O> constexpr O reverse_copy(B first, B last, O out)
{
    while (first != last)
    {
        *out = *--last;
        ++out;
    }
    return out;
}

// Swaps blocks forward, so it needs only forward iterators, and returns where *first went.
template <class F> constexpr F rotate(F first, F middle, F last)
{
    if (first == middle)
    {
        return last;
    }
    if (middle == last)
    {
        return first;
    }
    F next = middle;
    do
    {
        _FSTD::iter_swap(first, next);
        ++first;
        ++next;
        if (first == middle)
        {
            middle = next;
        }
    } while (next != last);
    F result = first;
    next = middle;
    while (next != last)
    {
        _FSTD::iter_swap(first, next);
        ++first;
        ++next;
        if (first == middle)
        {
            middle = next;
        }
        else if (next == last)
        {
            next = middle;
        }
    }
    return result;
}

template <class F, class O> constexpr O rotate_copy(F first, F middle, F last, O out)
{
    return _FSTD::copy(first, middle, _FSTD::copy(middle, last, out));
}

template <class F> constexpr F shift_left(F first, F last, __detail::IterDifference<F> count)
{
    if (count <= 0)
    {
        return last;
    }
    F middle = first;
    for (; count > 0; --count, ++middle)
    {
        if (middle == last)
        {
            return first;
        }
    }
    return _FSTD::move(middle, last, first);
}

template <class F> constexpr F shift_right(F first, F last, __detail::IterDifference<F> count)
{
    if (count <= 0)
    {
        return first;
    }
    if constexpr (__detail::ClassicBidirectional<F>)
    {
        F middle = last;
        for (auto steps = count; steps > 0; --steps, --middle)
        {
            if (middle == first)
            {
                return last;
            }
        }
        return _FSTD::move_backward(first, middle, last);
    }
    else
    {
        const auto length = _FSTD::distance(first, last);
        if (count >= length)
        {
            return last;
        }
        _FSTD::rotate(first, _FSTD::next(first, length - count), last);
        return _FSTD::next(first, count);
    }
}

template <class F, class P> constexpr F unique(F first, F last, P predicate)
{
    first = _FSTD::adjacent_find(first, last, predicate);
    if (first == last)
    {
        return last;
    }
    F current = first;
    while (++current != last)
    {
        if (!predicate(*first, *current))
        {
            *++first = _FSTD::move(*current);
        }
    }
    return ++first;
}

template <class F> constexpr F unique(F first, F last)
{
    return _FSTD::unique(first, last, __detail::EqualTo());
}

template <class I, class O, class P> constexpr O unique_copy(I first, I last, O out, P predicate)
{
    if (first == last)
    {
        return out;
    }
    if constexpr (__detail::ClassicForward<I>)
    {
        I kept = first;
        *out = *first;
        ++out;
        while (++first != last)
        {
            if (!predicate(*kept, *first))
            {
                kept = first;
                *out = *first;
                ++out;
            }
        }
    }
    else
    {
        // An input iterator cannot be read twice, so the last value written is kept aside.
        __detail::IterValue<I> kept = *first;
        *out = kept;
        ++out;
        while (++first != last)
        {
            if (!predicate(kept, *first))
            {
                kept = *first;
                *out = kept;
                ++out;
            }
        }
    }
    return out;
}

template <class I, class O> constexpr O unique_copy(I first, I last, O out)
{
    return _FSTD::unique_copy(first, last, out, __detail::EqualTo());
}

