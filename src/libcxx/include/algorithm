template <class I, class R, class C>
constexpr R partial_sort_copy(I first, I last, R out_first, R out_last, C compare)
{
    R out = out_first;
    for (; first != last && out != out_last; ++first, (void)++out)
    {
        *out = *first;
    }
    if (out == out_first)
    {
        return out;
    }
    __detail::MakeHeap(out_first, out, compare);
    for (; first != last; ++first)
    {
        if (compare(*first, *out_first))
        {
            *out_first = *first;
            __detail::SiftDown(out_first, out - out_first, __detail::IterDifference<R>(0), compare);
        }
    }
    __detail::SortHeap(out_first, out, compare);
    return out;
}

