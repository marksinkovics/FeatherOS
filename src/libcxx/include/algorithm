// Merging.

template <class I1, class I2, class O, class C>
constexpr O merge(I1 first1, I1 last1, I2 first2, I2 last2, O out, C compare)
{
    for (; first1 != last1; ++out)
    {
        if (first2 == last2)
        {
            return _FSTD::copy(first1, last1, out);
        }
        if (compare(*first2, *first1))
        {
            *out = *first2;
            ++first2;
        }
        else
        {
            *out = *first1;
            ++first1;
        }
    }
    return _FSTD::copy(first2, last2, out);
}

template <class I1, class I2, class O>
constexpr O merge(I1 first1, I1 last1, I2 first2, I2 last2, O out)
{
    return _FSTD::merge(first1, last1, first2, last2, out, __detail::Less());
}

namespace __detail
{
// Moves the first run into the buffer, then merges both runs forward into place; equal
// elements come from the first run first, which keeps the merge stable.
template <class B, class C, class T>
void MergeWithBuffer(B first, B middle, B last, C& compare, T* buffer)
{
    T* buffered = buffer;
    for (B current = first; current != middle; ++current, (void)++buffered)
    {
        ::new (static_cast<void*>(buffered)) T(_FSTD::move(*current));
    }
    T* next = buffer;
    B out = first;
    for (; next != buffered && middle != last; ++out)
    {
        if (compare(*middle, *next))
        {
            *out = _FSTD::move(*middle);
            ++middle;
        }
        else
        {
            *out = _FSTD::move(*next);
            ++next;
        }
    }
    for (; next != buffered; ++next, (void)++out)
    {
        *out = _FSTD::move(*next);
    }
    for (T* element = buffer; element != buffered; ++element)
    {
        _FSTD::destroy_at(element);
    }
}

template <class B, class C>
void MergeInPlace(B first, B middle, B last, IterDifference<B> length1, IterDifference<B> length2,
                  C& compare)
{
    if (length1 == 0 || length2 == 0)
    {
        return;
    }
    if (length1 + length2 == 2)
    {
        if (compare(*middle, *first))
        {
            _FSTD::iter_swap(first, middle);
        }
        return;
    }
    B cut1 = first;
    B cut2 = middle;
    IterDifference<B> length11 = 0;
    IterDifference<B> length22 = 0;
    if (length1 > length2)
    {
        length11 = length1 / 2;
        _FSTD::advance(cut1, length11);
        cut2 = _FSTD::lower_bound(middle, last, *cut1, compare);
        length22 = _FSTD::distance(middle, cut2);
    }
    else
    {
        length22 = length2 / 2;
        _FSTD::advance(cut2, length22);
        cut1 = _FSTD::upper_bound(first, middle, *cut2, compare);
        length11 = _FSTD::distance(first, cut1);
    }
    B new_middle = _FSTD::rotate(cut1, middle, cut2);
    MergeInPlace(first, cut1, new_middle, length11, length22, compare);
    MergeInPlace(new_middle, cut2, last, length1 - length11, length2 - length22, compare);
}

template <class R, class C, class T>
void MergeSort(R first, R last, C& compare, T* buffer, ptrdiff_t capacity)
{
    const auto length = last - first;
    if (length <= InsertionSortLimit)
    {
        InsertionSort(first, last, compare);
        return;
    }
    R middle = first + length / 2;
    MergeSort(first, middle, compare, buffer, capacity);
    MergeSort(middle, last, compare, buffer, capacity);
    if (!compare(*middle, *(middle - 1)))
    {
        return;
    }
    if (middle - first <= capacity)
    {
        MergeWithBuffer(first, middle, last, compare, buffer);
    }
    else
    {
        MergeInPlace(first, middle, last, middle - first, last - middle, compare);
    }
}
} // namespace __detail

template <class B, class C> void inplace_merge(B first, B middle, B last, C compare)
{
    const auto length1 = _FSTD::distance(first, middle);
    const auto length2 = _FSTD::distance(middle, last);
    __detail::TemporaryBuffer<__detail::IterValue<B>> buffer(length1);
    if (buffer.Capacity() >= length1)
    {
        __detail::MergeWithBuffer(first, middle, last, compare, buffer.Data());
    }
    else
    {
        __detail::MergeInPlace(first, middle, last, length1, length2, compare);
    }
}

template <class B> void inplace_merge(B first, B middle, B last)
{
    _FSTD::inplace_merge(first, middle, last, __detail::Less());
}

template <class R, class C> void stable_sort(R first, R last, C compare)
{
    const auto length = last - first;
    if (length < 2)
    {
        return;
    }
    __detail::TemporaryBuffer<__detail::IterValue<R>> buffer(
        length > __detail::InsertionSortLimit ? (length + 1) / 2 : 0);
    __detail::MergeSort(first, last, compare, buffer.Data(), buffer.Capacity());
}

template <class R> void stable_sort(R first, R last)
{
    _FSTD::stable_sort(first, last, __detail::Less());
}

// Set operations on sorted ranges.

template <class I1, class I2, class C>
constexpr bool includes(I1 first1, I1 last1, I2 first2, I2 last2, C compare)
{
    for (; first2 != last2; ++first1)
    {
        if (first1 == last1 || compare(*first2, *first1))
        {
            return false;
        }
        if (!compare(*first1, *first2))
        {
            ++first2;
        }
    }
    return true;
}

template <class I1, class I2> constexpr bool includes(I1 first1, I1 last1, I2 first2, I2 last2)
{
    return _FSTD::includes(first1, last1, first2, last2, __detail::Less());
}

template <class I1, class I2, class O, class C>
constexpr O set_union(I1 first1, I1 last1, I2 first2, I2 last2, O out, C compare)
{
    for (; first1 != last1; ++out)
    {
        if (first2 == last2)
        {
            return _FSTD::copy(first1, last1, out);
        }
        if (compare(*first2, *first1))
        {
            *out = *first2;
            ++first2;
        }
        else
        {
            *out = *first1;
            if (!compare(*first1, *first2))
            {
                ++first2;
            }
            ++first1;
        }
    }
    return _FSTD::copy(first2, last2, out);
}

template <class I1, class I2, class O>
constexpr O set_union(I1 first1, I1 last1, I2 first2, I2 last2, O out)
{
    return _FSTD::set_union(first1, last1, first2, last2, out, __detail::Less());
}

template <class I1, class I2, class O, class C>
constexpr O set_intersection(I1 first1, I1 last1, I2 first2, I2 last2, O out, C compare)
{
    while (first1 != last1 && first2 != last2)
    {
        if (compare(*first1, *first2))
        {
            ++first1;
        }
        else
        {
            if (!compare(*first2, *first1))
            {
                *out = *first1;
                ++out;
                ++first1;
            }
            ++first2;
        }
    }
    return out;
}

template <class I1, class I2, class O>
constexpr O set_intersection(I1 first1, I1 last1, I2 first2, I2 last2, O out)
{
    return _FSTD::set_intersection(first1, last1, first2, last2, out, __detail::Less());
}

template <class I1, class I2, class O, class C>
constexpr O set_difference(I1 first1, I1 last1, I2 first2, I2 last2, O out, C compare)
{
    while (first1 != last1)
    {
        if (first2 == last2)
        {
            return _FSTD::copy(first1, last1, out);
        }
        if (compare(*first1, *first2))
        {
            *out = *first1;
            ++out;
            ++first1;
        }
        else
        {
            if (!compare(*first2, *first1))
            {
                ++first1;
            }
            ++first2;
        }
    }
    return out;
}

template <class I1, class I2, class O>
constexpr O set_difference(I1 first1, I1 last1, I2 first2, I2 last2, O out)
{
    return _FSTD::set_difference(first1, last1, first2, last2, out, __detail::Less());
}

template <class I1, class I2, class O, class C>
constexpr O set_symmetric_difference(I1 first1, I1 last1, I2 first2, I2 last2, O out, C compare)
{
    while (first1 != last1)
    {
        if (first2 == last2)
        {
            return _FSTD::copy(first1, last1, out);
        }
        if (compare(*first1, *first2))
        {
            *out = *first1;
            ++out;
            ++first1;
        }
        else
        {
            if (compare(*first2, *first1))
            {
                *out = *first2;
                ++out;
            }
            else
            {
                ++first1;
            }
            ++first2;
        }
    }
    return _FSTD::copy(first2, last2, out);
}

template <class I1, class I2, class O>
constexpr O set_symmetric_difference(I1 first1, I1 last1, I2 first2, I2 last2, O out)
{
    return _FSTD::set_symmetric_difference(first1, last1, first2, last2, out, __detail::Less());
}

// Minimum and maximum.

template <class T, class C> constexpr const T& min(const T& left, const T& right, C compare)
{
    return compare(right, left) ? right : left;
}

template <class T> constexpr const T& min(const T& left, const T& right)
{
    return right < left ? right : left;
}

template <class T, class C> constexpr const T& max(const T& left, const T& right, C compare)
{
    return compare(left, right) ? right : left;
}

template <class T> constexpr const T& max(const T& left, const T& right)
{
    return left < right ? right : left;
}

template <class F, class C> constexpr F min_element(F first, F last, C compare)
{
    if (first == last)
    {
        return last;
    }
    F smallest = first;
    while (++first != last)
    {
        if (compare(*first, *smallest))
        {
            smallest = first;
        }
    }
    return smallest;
}

template <class F> constexpr F min_element(F first, F last)
{
    return _FSTD::min_element(first, last, __detail::Less());
}

template <class F, class C> constexpr F max_element(F first, F last, C compare)
{
    if (first == last)
    {
        return last;
    }
    F largest = first;
    while (++first != last)
    {
        if (compare(*largest, *first))
        {
            largest = first;
        }
    }
    return largest;
}

template <class F> constexpr F max_element(F first, F last)
{
    return _FSTD::max_element(first, last, __detail::Less());
}

// The first smallest and the last largest, as the standard asks.
template <class F, class C> constexpr pair<F, F> minmax_element(F first, F last, C compare)
{
    F smallest = first;
    F largest = first;
    if (first == last)
    {
        return pair<F, F>(smallest, largest);
    }
    while (++first != last)
    {
        if (compare(*first, *smallest))
        {
            smallest = first;
        }
        else if (!compare(*first, *largest))
        {
            largest = first;
        }
    }
    return pair<F, F>(smallest, largest);
}

template <class F> constexpr pair<F, F> minmax_element(F first, F last)
{
    return _FSTD::minmax_element(first, last, __detail::Less());
}

template <class T, class C> constexpr T min(initializer_list<T> values, C compare)
{
    return *_FSTD::min_element(values.begin(), values.end(), compare);
}

template <class T> constexpr T min(initializer_list<T> values)
{
    return *_FSTD::min_element(values.begin(), values.end());
}

template <class T, class C> constexpr T max(initializer_list<T> values, C compare)
{
    return *_FSTD::max_element(values.begin(), values.end(), compare);
}

template <class T> constexpr T max(initializer_list<T> values)
{
    return *_FSTD::max_element(values.begin(), values.end());
}

template <class T, class C>
constexpr pair<const T&, const T&> minmax(const T& left, const T& right, C compare)
{
    return compare(right, left) ? pair<const T&, const T&>(right, left)
                                : pair<const T&, const T&>(left, right);
}

template <class T> constexpr pair<const T&, const T&> minmax(const T& left, const T& right)
{
    return _FSTD::minmax(left, right, __detail::Less());
}

template <class T, class C> constexpr pair<T, T> minmax(initializer_list<T> values, C compare)
{
    auto [smallest, largest] = _FSTD::minmax_element(values.begin(), values.end(), compare);
    return pair<T, T>(*smallest, *largest);
}

template <class T> constexpr pair<T, T> minmax(initializer_list<T> values)
{
    return _FSTD::minmax(values, __detail::Less());
}

template <class T, class C>
constexpr const T& clamp(const T& value, const T& low, const T& high, C compare)
{
    if (compare(value, low))
    {
        return low;
    }
    return compare(high, value) ? high : value;
}

template <class T> constexpr const T& clamp(const T& value, const T& low, const T& high)
{
    return _FSTD::clamp(value, low, high, __detail::Less());
}

// Comparison and permutations.

template <class I1, class I2, class C>
constexpr bool lexicographical_compare(I1 first1, I1 last1, I2 first2, I2 last2, C compare)
{
    for (; first2 != last2; ++first1, (void)++first2)
    {
        if (first1 == last1 || compare(*first1, *first2))
        {
            return true;
        }
        if (compare(*first2, *first1))
        {
            return false;
        }
    }
    return false;
}

template <class I1, class I2>
constexpr bool lexicographical_compare(I1 first1, I1 last1, I2 first2, I2 last2)
{
    return _FSTD::lexicographical_compare(first1, last1, first2, last2, __detail::Less());
}

template <class I1, class I2, class C>
constexpr auto lexicographical_compare_three_way(I1 first1, I1 last1, I2 first2, I2 last2,
                                                 C compare) -> decltype(compare(*first1, *first2))
{
    for (; first1 != last1 && first2 != last2; ++first1, (void)++first2)
    {
        if (auto order = compare(*first1, *first2); order != 0)
        {
            return order;
        }
    }
    return first1 != last1   ? strong_ordering::greater
           : first2 != last2 ? strong_ordering::less
                             : strong_ordering::equal;
}

template <class I1, class I2>
constexpr auto lexicographical_compare_three_way(I1 first1, I1 last1, I2 first2, I2 last2)
{
    return _FSTD::lexicographical_compare_three_way(first1, last1, first2, last2,
                                                    compare_three_way());
}

template <class B, class C> constexpr bool next_permutation(B first, B last, C compare)
{
    B current = last;
    if (first == last || first == --current)
    {
        return false;
    }
    for (;;)
    {
        B after = current;
        if (compare(*--current, *after))
        {
            B swap_with = last;
            while (!compare(*current, *--swap_with))
            {
            }
            _FSTD::iter_swap(current, swap_with);
            _FSTD::reverse(after, last);
            return true;
        }
        if (current == first)
        {
            _FSTD::reverse(first, last);
            return false;
        }
    }
}

template <class B> constexpr bool next_permutation(B first, B last)
{
    return _FSTD::next_permutation(first, last, __detail::Less());
}

template <class B, class C> constexpr bool prev_permutation(B first, B last, C compare)
{
    B current = last;
    if (first == last || first == --current)
    {
        return false;
    }
    for (;;)
    {
        B after = current;
        if (compare(*after, *--current))
        {
            B swap_with = last;
            while (!compare(*--swap_with, *current))
            {
            }
            _FSTD::iter_swap(current, swap_with);
            _FSTD::reverse(after, last);
            return true;
        }
        if (current == first)
        {
            _FSTD::reverse(first, last);
            return false;
        }
    }
}

template <class B> constexpr bool prev_permutation(B first, B last)
{
    return _FSTD::prev_permutation(first, last, __detail::Less());
}

