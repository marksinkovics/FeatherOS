// A uniformly distributed number below bound from a uniform random bit generator, by rejection
// and, where the generator's range is too narrow, by combining draws.
template <class G> unsigned long long UniformBelow(G& generator, unsigned long long bound)
{
    using Bits = typename remove_reference_t<G>::result_type;
    constexpr auto lowest = static_cast<unsigned long long>(remove_reference_t<G>::min());
    constexpr auto span = static_cast<unsigned long long>(remove_reference_t<G>::max()) - lowest;
    auto draw = [&generator]
    { return static_cast<unsigned long long>(static_cast<Bits>(generator())) - lowest; };
    if (bound - 1 <= span)
    {
        const unsigned long long rejected = (span % bound + 1) % bound;
        for (;;)
        {
            const unsigned long long value = draw();
            if (rejected == 0 || value <= span - rejected)
            {
                return value % bound;
            }
        }
    }
    const unsigned long long scale = span + 1;
    for (;;)
    {
        const unsigned long long high = UniformBelow(generator, (bound - 1) / scale + 1) * scale;
        const unsigned long long value = high + draw();
        if (value >= high && value < bound)
        {
            return value;
        }
    }
}
} // namespace __detail

template <class R, class G> void shuffle(R first, R last, G&& generator)
{
    const auto length = last - first;
    for (decltype(last - first) index = length - 1; index > 0; --index)
    {
        const auto chosen = static_cast<decltype(last - first)>(
            __detail::UniformBelow(generator, static_cast<unsigned long long>(index) + 1));
        _FSTD::iter_swap(first + index, first + chosen);
    }
}

template <class I, class O, class Distance, class G>
O sample(I first, I last, O out, Distance count, G&& generator)
{
    if constexpr (__detail::ClassicForward<I>)
    {
        // Selection sampling keeps the chosen elements in order.
        auto remaining = static_cast<unsigned long long>(_FSTD::distance(first, last));
        auto wanted = count > 0 ? static_cast<unsigned long long>(count) : 0ULL;
        for (; wanted != 0 && first != last; ++first, --remaining)
        {
            if (__detail::UniformBelow(generator, remaining) < wanted)
            {
                *out = *first;
                ++out;
                --wanted;
            }
        }
        return out;
    }
    else
    {
        // Reservoir sampling, into an output that must allow random access.
        Distance filled = 0;
        for (; first != last && filled < count; ++first, (void)++filled)
        {
            out[filled] = *first;
        }
        for (auto seen = static_cast<unsigned long long>(filled); first != last; ++first, ++seen)
        {
            const auto chosen = __detail::UniformBelow(generator, seen + 1);
            if (chosen < static_cast<unsigned long long>(count))
            {
                out[static_cast<Distance>(chosen)] = *first;
            }
        }
        return out + filled;
    }
}

// Partitioning.

template <class I, class P> constexpr bool is_partitioned(I first, I last, P predicate)
{
    first = _FSTD::find_if_not(first, last, predicate);
    return _FSTD::none_of(first, last, predicate);
}

template <class F, class P> constexpr F partition(F first, F last, P predicate)
{
    if constexpr (__detail::ClassicBidirectional<F>)
    {
        for (;;)
        {
            for (;; ++first)
            {
                if (first == last)
                {
                    return first;
                }
                if (!predicate(*first))
                {
                    break;
                }
            }
            do
            {
                if (first == --last)
                {
                    return first;
                }
            } while (!predicate(*last));
            _FSTD::iter_swap(first, last);
            ++first;
        }
    }
    else
    {
        first = _FSTD::find_if_not(first, last, predicate);
        if (first == last)
        {
            return first;
        }
        for (F current = _FSTD::next(first); current != last; ++current)
        {
            if (predicate(*current))
            {
                _FSTD::iter_swap(current, first);
                ++first;
            }
        }
        return first;
    }
}

template <class I, class O1, class O2, class P>
constexpr pair<O1, O2> partition_copy(I first, I last, O1 out_true, O2 out_false, P predicate)
{
    for (; first != last; ++first)
    {
        if (predicate(*first))
        {
            *out_true = *first;
            ++out_true;
        }
        else
        {
            *out_false = *first;
            ++out_false;
        }
    }
    return pair<O1, O2>(out_true, out_false);
}

template <class F, class P> constexpr F partition_point(F first, F last, P predicate)
{
    auto length = _FSTD::distance(first, last);
    while (length > 0)
    {
        const auto half = length / 2;
        F middle = _FSTD::next(first, half);
        if (predicate(*middle))
        {
            first = ++middle;
            length -= half + 1;
        }
        else
        {
            length = half;
        }
    }
    return first;
}

