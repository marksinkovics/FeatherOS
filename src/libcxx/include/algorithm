namespace __detail
{
inline constexpr ptrdiff_t InsertionSortLimit = 16;

// Stable, so stable_sort uses it for short runs too.
template <class B, class C> constexpr void InsertionSort(B first, B last, C& compare)
{
    if (first == last)
    {
        return;
    }
    for (B current = _FSTD::next(first); current != last; ++current)
    {
        IterValue<B> value = _FSTD::move(*current);
        B hole = current;
        if (compare(value, *first))
        {
            _FSTD::move_backward(first, current, _FSTD::next(current));
            hole = first;
        }
        else
        {
            for (B before = _FSTD::prev(hole); compare(value, *before); --before)
            {
                *hole = _FSTD::move(*before);
                hole = before;
            }
        }
        *hole = _FSTD::move(value);
    }
}

template <class R, class C> constexpr void MoveMedianToFirst(R result, R a, R b, R c, C& compare)
{
    if (compare(*a, *b))
    {
        if (compare(*b, *c))
        {
            _FSTD::iter_swap(result, b);
        }
        else if (compare(*a, *c))
        {
            _FSTD::iter_swap(result, c);
        }
        else
        {
            _FSTD::iter_swap(result, a);
        }
    }
    else if (compare(*a, *c))
    {
        _FSTD::iter_swap(result, a);
    }
    else if (compare(*b, *c))
    {
        _FSTD::iter_swap(result, c);
    }
    else
    {
        _FSTD::iter_swap(result, b);
    }
}

// Hoare partition around *first, the median of three, so the scans need no bounds checks: the
// other two candidates stop them.
template <class R, class C> constexpr R PartitionAroundMedian(R first, R last, C& compare)
{
    R middle = first + (last - first) / 2;
    MoveMedianToFirst(first, first + 1, middle, last - 1, compare);
    R left = first + 1;
    R right = last;
    for (;;)
    {
        while (compare(*left, *first))
        {
            ++left;
        }
        --right;
        while (compare(*first, *right))
        {
            --right;
        }
        if (!(left < right))
        {
            return left;
        }
        _FSTD::iter_swap(left, right);
        ++left;
    }
}

template <class R> constexpr IterDifference<R> IntroDepth(R first, R last)
{
    IterDifference<R> depth = 0;
    for (auto length = last - first; length > 1; length /= 2)
    {
        depth += 2;
    }
    return depth;
}

// Quicksort that switches to heapsort when it recurses too deep, leaving short runs for one
// insertion sort at the end.
template <class R, class C>
constexpr void IntroSort(R first, R last, IterDifference<R> depth, C& compare)
{
    while (last - first > InsertionSortLimit)
    {
        if (depth == 0)
        {
            MakeHeap(first, last, compare);
            SortHeap(first, last, compare);
            return;
        }
        --depth;
        R cut = PartitionAroundMedian(first, last, compare);
        IntroSort(cut, last, depth, compare);
        last = cut;
    }
}

template <class R, class C>
constexpr void IntroSelect(R first, R nth, R last, IterDifference<R> depth, C& compare)
{
    while (last - first > 3)
    {
        if (depth == 0)
        {
            // Heap selection: the smallest nth - first + 1 elements, then the largest of them.
            R end = nth + 1;
            MakeHeap(first, end, compare);
            for (R current = end; current != last; ++current)
            {
                if (compare(*current, *first))
                {
                    _FSTD::iter_swap(current, first);
                    SiftDown(first, end - first, IterDifference<R>(0), compare);
                }
            }
            _FSTD::iter_swap(first, nth);
            return;
        }
        --depth;
        R cut = PartitionAroundMedian(first, last, compare);
        if (cut <= nth)
        {
            first = cut;
        }
        else
        {
            last = cut;
        }
    }
    InsertionSort(first, last, compare);
}
} // namespace __detail

template <class R, class C> constexpr void sort(R first, R last, C compare)
{
    if (last - first < 2)
    {
        return;
    }
    __detail::IntroSort(first, last, __detail::IntroDepth(first, last), compare);
    __detail::InsertionSort(first, last, compare);
}

template <class R> constexpr void sort(R first, R last)
{
    _FSTD::sort(first, last, __detail::Less());
}

template <class R, class C> constexpr void partial_sort(R first, R middle, R last, C compare)
{
    if (first == middle)
    {
        return;
    }
    __detail::MakeHeap(first, middle, compare);
    for (R current = middle; current != last; ++current)
    {
        if (compare(*current, *first))
        {
            _FSTD::iter_swap(current, first);
            __detail::SiftDown(first, middle - first, __detail::IterDifference<R>(0), compare);
        }
    }
    __detail::SortHeap(first, middle, compare);
}

