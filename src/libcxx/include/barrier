// -*- C++ -*-
#ifndef FEATHEROS_LIBCXX_BARRIER
#define FEATHEROS_LIBCXX_BARRIER

#include "__featheros_config"
#include "atomic"
#include "limits"
#include "type_traits"
#include "utility"

namespace FEATHEROS_STD_NAMESPACE
{

namespace __detail
{

struct BarrierNoCompletion
{
    void operator()() noexcept {}
};

} // namespace __detail

// One counter that the phase's last arrival resets. Only that thread touches m_expected: the
// release store of m_remaining reaches the next phase's last arrival through the arrivals'
// read-modify-writes, and the release store of m_phase reaches the waiters, with the completion
// function's effects.
template <class CompletionFunction = __detail::BarrierNoCompletion> class barrier
{
    static_assert(is_nothrow_invocable_v<CompletionFunction&>,
                  "a barrier's completion function must be noexcept");

public:
    class arrival_token
    {
    private:
        friend class barrier;
        explicit arrival_token(uint32_t phase) noexcept : m_phase(phase) {}

        uint32_t m_phase;
    };

    static constexpr ptrdiff_t max() noexcept
    {
        return numeric_limits<ptrdiff_t>::max();
    }

    constexpr explicit barrier(ptrdiff_t expected, CompletionFunction f = CompletionFunction())
        : m_expected(expected), m_remaining(expected), m_completion(_FSTD::move(f))
    {
    }
    ~barrier() = default;
    barrier(const barrier&) = delete;
    barrier& operator=(const barrier&) = delete;

    [[nodiscard]] arrival_token arrive(ptrdiff_t update = 1) noexcept
    {
        // The phase cannot end before this arrival counts, so it is still the one read here.
        const uint32_t phase = m_phase.load(memory_order::acquire);
        if (m_remaining.fetch_sub(update, memory_order::acq_rel) == update)
        {
            m_completion();
            m_expected -= m_dropped.exchange(0, memory_order::relaxed);
            m_remaining.store(m_expected, memory_order::release);
            m_phase.store(phase + 1, memory_order::release);
            __detail::AtomicNotify(&m_phase);
        }
        return arrival_token(phase);
    }

    void wait(arrival_token&& arrival) const noexcept
    {
        __detail::AtomicWaitUntil(&m_phase, [this, phase = arrival.m_phase]() noexcept
                                  { return m_phase.load(memory_order::acquire) != phase; });
    }

    void arrive_and_wait() noexcept
    {
        wait(arrive());
    }

    void arrive_and_drop() noexcept
    {
        m_dropped.fetch_add(1, memory_order::relaxed);
        (void)arrive();
    }

private:
    ptrdiff_t m_expected;
    atomic<ptrdiff_t> m_remaining;
    atomic<ptrdiff_t> m_dropped{0};
    atomic<uint32_t> m_phase{0};
    [[no_unique_address]] CompletionFunction m_completion;
};

} // namespace FEATHEROS_STD_NAMESPACE

#endif
