namespace __detail
{
template <class T, class U>
concept EqualityTestable = requires(const T& left, const U& right) {
    { left == right } -> BooleanTestable;
};

template <class Left, class Right, size_t... Index>
constexpr bool TupleEqual([[maybe_unused]] const Left& left, [[maybe_unused]] const Right& right,
                          index_sequence<Index...>)
{
    return ((_FSTD::get<Index>(left) == _FSTD::get<Index>(right)) && ...);
}

template <class Result, size_t Index, class Left, class Right>
constexpr Result TupleCompare(const Left& left, const Right& right)
{
    if constexpr (Index == tuple_size_v<Left>)
    {
        return Result::equivalent;
    }
    else
    {
        if (auto order = synth_three_way(_FSTD::get<Index>(left), _FSTD::get<Index>(right));
            order != 0)
        {
            return order;
        }
        return TupleCompare<Result, Index + 1>(left, right);
    }
}
} // namespace __detail

template <class... T, class... U>
    requires(sizeof...(T) == sizeof...(U)) && (__detail::EqualityTestable<T, U> && ...)
constexpr bool operator==(const tuple<T...>& left, const tuple<U...>& right)
{
    return __detail::TupleEqual(left, right, index_sequence_for<T...>{});
}

template <class... T, class... U>
    requires(sizeof...(T) == sizeof...(U))
constexpr common_comparison_category_t<__detail::SynthThreeWayResult<T, U>...>
operator<=>(const tuple<T...>& left, const tuple<U...>& right)
{
    using Result = common_comparison_category_t<__detail::SynthThreeWayResult<T, U>...>;
    return __detail::TupleCompare<Result, 0>(left, right);
}

template <class... T> constexpr tuple<unwrap_ref_decay_t<T>...> make_tuple(T&&... values)
{
    return tuple<unwrap_ref_decay_t<T>...>(_FSTD::forward<T>(values)...);
}

template <class... T> constexpr tuple<T&&...> forward_as_tuple(T&&... values) noexcept
{
    return tuple<T&&...>(_FSTD::forward<T>(values)...);
}

template <class... T> constexpr tuple<T&...> tie(T&... values) noexcept
{
    return tuple<T&...>(values...);
}

