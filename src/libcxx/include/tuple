// Defined after tuple; <memory>'s uses_allocator_construction_args calls it too.
template <class T> struct UsesAllocatorConstruction;

// Each element lives in a base of its own, indexed so that equal types stay distinct, and
// [[no_unique_address]] lets empty elements take no space.
template <size_t Index, class T> struct TupleLeaf
{
    [[no_unique_address]] T __value;

    constexpr TupleLeaf() : __value() {}
    template <class U>
    constexpr TupleLeaf(TupleFromElements, U&& value) : __value(_FSTD::forward<U>(value))
    {
    }

    template <class Alloc, class... U>
    constexpr TupleLeaf(TupleWithAllocator, const Alloc& allocator, U&&... values)
        : TupleLeaf(TupleFromArguments{}, UsesAllocatorConstruction<remove_cv_t<T>>::Arguments(
                                              allocator, _FSTD::forward<U>(values)...))
    {
    }

private:
    template <class Arguments>
    constexpr TupleLeaf(TupleFromArguments tag, Arguments&& arguments)
        : TupleLeaf(tag, _FSTD::move(arguments),
                    make_index_sequence<tuple_size_v<remove_cvref_t<Arguments>>>{})
    {
    }

    // Only the lvalue get is declared yet, so each element is forwarded by its own type.
    template <class Arguments, size_t... Position>
    constexpr TupleLeaf(TupleFromArguments, Arguments&& arguments, index_sequence<Position...>)
        : __value(_FSTD::forward<tuple_element_t<Position, remove_cvref_t<Arguments>>>(
              _FSTD::get<Position>(arguments))...)
    {
    }
};

template <class Indices, class... T> struct TupleStorage;
template <size_t... Index, class... T>
struct TupleStorage<index_sequence<Index...>, T...> : TupleLeaf<Index, T>...
{
    constexpr TupleStorage() = default;
    template <class... U>
    constexpr explicit TupleStorage(TupleFromElements tag, U&&... values)
        : TupleLeaf<Index, T>(tag, _FSTD::forward<U>(values))...
    {
    }

    template <class Alloc>
    constexpr TupleStorage(TupleWithAllocator tag, const Alloc& allocator)
        : TupleLeaf<Index, T>(tag, allocator)...
    {
    }
    template <class Alloc, class... U>
    constexpr TupleStorage(TupleWithAllocator tag, const Alloc& allocator, U&&... values)
        : TupleLeaf<Index, T>(tag, allocator, _FSTD::forward<U>(values))...
    {
    }
};

template <size_t Index, class T> constexpr T& LeafValue(TupleLeaf<Index, T>& leaf) noexcept
{
    return leaf.__value;
}
template <size_t Index, class T>
constexpr const T& LeafValue(const TupleLeaf<Index, T>& leaf) noexcept
{
    return leaf.__value;
}
