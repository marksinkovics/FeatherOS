{
    return __detail::LeafValue<Index>(value.__elements);
}

template <size_t Index, class... T>
constexpr tuple_element_t<Index, tuple<T...>>&& get(tuple<T...>&& value) noexcept
{
    return static_cast<tuple_element_t<Index, tuple<T...>>&&>(
        __detail::LeafValue<Index>(value.__elements));
}

