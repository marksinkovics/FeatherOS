template <class... T, class... U>
    requires(sizeof...(T) == sizeof...(U)) && requires { typename tuple<common_type_t<T, U>...>; }
struct common_type<tuple<T...>, tuple<U...>>
{
    using type = tuple<common_type_t<T, U>...>;
};

template <class... T, class... U, template <class> class TQualifiers,
          template <class> class UQualifiers>
    requires(sizeof...(T) == sizeof...(U)) &&
            requires { typename tuple<common_reference_t<TQualifiers<T>, UQualifiers<U>>...>; }
struct basic_common_reference<tuple<T...>, tuple<U...>, TQualifiers, UQualifiers>
{
    using type = tuple<common_reference_t<TQualifiers<T>, UQualifiers<U>>...>;
};

