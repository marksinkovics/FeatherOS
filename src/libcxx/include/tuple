template <class T> inline constexpr bool IsTupleLike = false;
template <class T, size_t Size> inline constexpr bool IsTupleLike<array<T, Size>> = true;
template <class First, class Second> inline constexpr bool IsTupleLike<pair<First, Second>> = true;
template <class... T> inline constexpr bool IsTupleLike<tuple<T...>> = true;

template <class T>
concept TupleLike = IsTupleLike<remove_cvref_t<T>>;

template <class T> inline constexpr bool IsPair = false;
template <class First, class Second> inline constexpr bool IsPair<pair<First, Second>> = true;

template <class T> inline constexpr bool IsTupleOrPair = false;
