// Element k of tuple_cat's result is element Inner[k] of argument Outer[k].
template <size_t... Sizes> constexpr auto TupleCatOuter()
{
    constexpr size_t sizes[] = {Sizes..., 0};
    array<size_t, (Sizes + ... + 0)> outer{};
    size_t position = 0;
    for (size_t argument = 0; argument != sizeof...(Sizes); ++argument)
    {
        for (size_t element = 0; element < sizes[argument]; ++element)
        {
            outer[position++] = argument;
        }
    }
    return outer;
}

template <size_t... Sizes> constexpr auto TupleCatInner()
{
    constexpr size_t sizes[] = {Sizes..., 0};
    array<size_t, (Sizes + ... + 0)> inner{};
    size_t position = 0;
    for (size_t argument = 0; argument != sizeof...(Sizes); ++argument)
    {
        for (size_t element = 0; element < sizes[argument]; ++element)
        {
            inner[position++] = element;
        }
    }
    return inner;
}

template <class Result, size_t... Sizes, class Arguments, size_t... Position>
constexpr Result TupleCat([[maybe_unused]] Arguments&& arguments, index_sequence<Position...>)
{
    [[maybe_unused]] constexpr auto outer = TupleCatOuter<Sizes...>();
    [[maybe_unused]] constexpr auto inner = TupleCatInner<Sizes...>();
    return Result(_FSTD::get<inner[Position]>(
        _FSTD::get<outer[Position]>(_FSTD::forward<Arguments>(arguments)))...);
}
} // namespace __detail

template <__detail::TupleLike... Tuples>
constexpr typename __detail::TupleConcat<typename __detail::TupleOfElements<
    remove_cvref_t<Tuples>, __detail::TupleIndices<Tuples>>::type...>::type
tuple_cat(Tuples&&... tuples)
{
    using Result = typename __detail::TupleConcat<typename __detail::TupleOfElements<
        remove_cvref_t<Tuples>, __detail::TupleIndices<Tuples>>::type...>::type;
    return __detail::TupleCat<Result, tuple_size_v<remove_cvref_t<Tuples>>...>(
        _FSTD::forward_as_tuple(_FSTD::forward<Tuples>(tuples)...),
        make_index_sequence<tuple_size_v<Result>>{});
}

