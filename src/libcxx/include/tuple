template <class Source, class Indices, class... Types> struct ElementwiseConstructible : false_type
{
};
template <class Source, size_t... Index, class... Types>
    requires(sizeof...(Index) == sizeof...(Types))
struct ElementwiseConstructible<Source, index_sequence<Index...>, Types...>
    : bool_constant<(is_constructible_v<Types, decltype(_FSTD::get<Index>(declval<Source>()))> &&
                     ...)>
{
};

template <class Source, class Indices, class... Types> struct ElementwiseConvertible : false_type
{
};
template <class Source, size_t... Index, class... Types>
    requires(sizeof...(Index) == sizeof...(Types))
struct ElementwiseConvertible<Source, index_sequence<Index...>, Types...>
    : bool_constant<(is_convertible_v<decltype(_FSTD::get<Index>(declval<Source>())), Types> &&
                     ...)>
{
};

template <class Source, class Indices, class... Types> struct ElementwiseAssignable : false_type
{
};
template <class Source, size_t... Index, class... Types>
    requires(sizeof...(Index) == sizeof...(Types))
struct ElementwiseAssignable<Source, index_sequence<Index...>, Types...>
    : bool_constant<(is_assignable_v<Types&, decltype(_FSTD::get<Index>(declval<Source>()))> &&
                     ...)>
{
};

template <class Source>
using TupleIndices = make_index_sequence<tuple_size_v<remove_cvref_t<Source>>>;

// The constraints of tuple's constructors from another tuple-like object: element by element,
// and for a one-element tuple, only where the source would not initialize that element whole.
template <class Source, class... Types>
concept TupleConstructibleFrom =
    tuple_size_v<remove_cvref_t<Source>> == sizeof...(Types) &&
    ElementwiseConstructible<Source, TupleIndices<Source>, Types...>::value &&
    (sizeof...(Types) != 1 ||
     ((!is_convertible_v<Source, Types> && !is_constructible_v<Types, Source>) && ...));

template <class Source, class... Types>
inline constexpr bool TupleConvertibleFrom =
    ElementwiseConvertible<Source, TupleIndices<Source>, Types...>::value;

template <class Source, class... Types>
concept TupleAssignableFrom = tuple_size_v<remove_cvref_t<Source>> == sizeof...(Types) &&
                              ElementwiseAssignable<Source, TupleIndices<Source>, Types...>::value;
} // namespace __detail

template <class... Types> class tuple
{
    using Indices = index_sequence_for<Types...>;

public:
    __detail::TupleStorage<Indices, Types...> __elements;

    explicit(!(__detail::ImplicitlyDefaultConstructible<Types> && ...)) constexpr tuple()
        requires(is_default_constructible_v<Types> && ...)
        : __elements()
    {
    }

    explicit(!(is_convertible_v<const Types&, Types> &&
               ...)) constexpr tuple(const Types&... values)
        requires(is_copy_constructible_v<Types> && ...)
        : __elements(__detail::TupleFromElements{}, values...)
    {
    }

    template <class... U>
        requires(sizeof...(U) == sizeof...(Types)) &&
                (sizeof...(Types) != 1 || (!is_same_v<remove_cvref_t<U>, tuple> && ...)) &&
                (is_constructible_v<Types, U> && ...)
    explicit(!(is_convertible_v<U, Types> && ...)) constexpr tuple(U&&... values)
        : __elements(__detail::TupleFromElements{}, _FSTD::forward<U>(values)...)
    {
    }

    tuple(const tuple&) = default;
    tuple(tuple&&) = default;

    template <class... U>
        requires __detail::TupleConstructibleFrom<tuple<U...>&, Types...> &&
                 (sizeof...(Types) != 1 || (!is_same_v<Types, U> && ...))
    explicit(!__detail::TupleConvertibleFrom<tuple<U...>&, Types...>) constexpr tuple(
        tuple<U...>& other)
        : tuple(__detail::TupleFromTuple{}, other, Indices{})
    {
    }

    template <class... U>
        requires __detail::TupleConstructibleFrom<const tuple<U...>&, Types...> &&
                 (sizeof...(Types) != 1 || (!is_same_v<Types, U> && ...))
    explicit(!__detail::TupleConvertibleFrom<const tuple<U...>&, Types...>) constexpr tuple(
        const tuple<U...>& other)
        : tuple(__detail::TupleFromTuple{}, other, Indices{})
    {
    }

    template <class... U>
        requires __detail::TupleConstructibleFrom<tuple<U...>&&, Types...> &&
                 (sizeof...(Types) != 1 || (!is_same_v<Types, U> && ...))
    explicit(!__detail::TupleConvertibleFrom<tuple<U...>&&, Types...>) constexpr tuple(
        tuple<U...>&& other)
        : tuple(__detail::TupleFromTuple{}, _FSTD::move(other), Indices{})
    {
    }

    template <class... U>
        requires __detail::TupleConstructibleFrom<const tuple<U...>&&, Types...> &&
                 (sizeof...(Types) != 1 || (!is_same_v<Types, U> && ...))
    explicit(!__detail::TupleConvertibleFrom<const tuple<U...>&&, Types...>) constexpr tuple(
        const tuple<U...>&& other)
        : tuple(__detail::TupleFromTuple{}, _FSTD::move(other), Indices{})
    {
    }

    template <class U1, class U2>
        requires __detail::TupleConstructibleFrom<pair<U1, U2>&, Types...>
    explicit(!__detail::TupleConvertibleFrom<pair<U1, U2>&, Types...>) constexpr tuple(
        pair<U1, U2>& other)
        : tuple(__detail::TupleFromTuple{}, other, Indices{})
    {
    }

    template <class U1, class U2>
        requires __detail::TupleConstructibleFrom<const pair<U1, U2>&, Types...>
    explicit(!__detail::TupleConvertibleFrom<const pair<U1, U2>&, Types...>) constexpr tuple(
        const pair<U1, U2>& other)
        : tuple(__detail::TupleFromTuple{}, other, Indices{})
    {
    }

    template <class U1, class U2>
        requires __detail::TupleConstructibleFrom<pair<U1, U2>&&, Types...>
    explicit(!__detail::TupleConvertibleFrom<pair<U1, U2>&&, Types...>) constexpr tuple(
        pair<U1, U2>&& other)
        : tuple(__detail::TupleFromTuple{}, _FSTD::move(other), Indices{})
    {
    }

    template <class U1, class U2>
        requires __detail::TupleConstructibleFrom<const pair<U1, U2>&&, Types...>
    explicit(!__detail::TupleConvertibleFrom<const pair<U1, U2>&&, Types...>) constexpr tuple(
        const pair<U1, U2>&& other)
        : tuple(__detail::TupleFromTuple{}, _FSTD::move(other), Indices{})
    {
    }

    // Other tuple-like types, which are arrays until ranges::subrange exists.
    template <__detail::TupleLike Other>
        requires(!__detail::IsTupleOrPair<remove_cvref_t<Other>>) &&
                __detail::TupleConstructibleFrom<Other, Types...>
    explicit(!__detail::TupleConvertibleFrom<Other, Types...>) constexpr tuple(Other&& other)
        : tuple(__detail::TupleFromTuple{}, _FSTD::forward<Other>(other), Indices{})
    {
    }

    // The allocator-extended constructors build each element with uses-allocator construction.
    // One template covers copies, moves and every tuple-like source.
    template <class Alloc>
        requires(is_default_constructible_v<Types> && ...)
    explicit(!(__detail::ImplicitlyDefaultConstructible<Types> &&
               ...)) constexpr tuple(allocator_arg_t, const Alloc& allocator)
        : __elements(__detail::TupleWithAllocator{}, allocator)
    {
    }

    template <class Alloc>
        requires(is_copy_constructible_v<Types> && ...)
    explicit(!(is_convertible_v<const Types&, Types> &&
               ...)) constexpr tuple(allocator_arg_t, const Alloc& allocator,
                                     const Types&... values)
        : __elements(__detail::TupleWithAllocator{}, allocator, values...)
    {
    }

    template <class Alloc, class... U>
        requires(sizeof...(U) == sizeof...(Types)) &&
                (sizeof...(Types) != 1 || (!is_same_v<remove_cvref_t<U>, tuple> && ...)) &&
                (is_constructible_v<Types, U> && ...)
    explicit(!(is_convertible_v<U, Types> &&
               ...)) constexpr tuple(allocator_arg_t, const Alloc& allocator, U&&... values)
        : __elements(__detail::TupleWithAllocator{}, allocator, _FSTD::forward<U>(values)...)
    {
    }

    template <class Alloc, __detail::TupleLike Other>
        requires __detail::TupleConstructibleFrom<Other, Types...>
    explicit(!__detail::TupleConvertibleFrom<Other, Types...>) constexpr tuple(
        allocator_arg_t, const Alloc& allocator, Other&& other)
        : tuple(__detail::TupleWithAllocator{}, allocator, _FSTD::forward<Other>(other), Indices{})
    {
    }

    // Assignment goes through the elements, so a tuple of references assigns what they refer to.
    constexpr tuple& operator=(const tuple& other)
        requires(is_copy_assignable_v<Types> && ...)
    {
        AssignFrom(other, Indices{});
        return *this;
    }

    constexpr tuple& operator=(tuple&& other) noexcept((is_nothrow_move_assignable_v<Types> && ...))
        requires(is_move_assignable_v<Types> && ...)
    {
        AssignFrom(_FSTD::move(other), Indices{});
        return *this;
    }

    template <class... U>
        requires __detail::TupleAssignableFrom<const tuple<U...>&, Types...>
    constexpr tuple& operator=(const tuple<U...>& other)
    {
        AssignFrom(other, Indices{});
        return *this;
    }

    template <class... U>
        requires __detail::TupleAssignableFrom<tuple<U...>&&, Types...>
    constexpr tuple& operator=(tuple<U...>&& other)
    {
        AssignFrom(_FSTD::move(other), Indices{});
        return *this;
    }

    template <class U1, class U2>
        requires __detail::TupleAssignableFrom<const pair<U1, U2>&, Types...>
    constexpr tuple& operator=(const pair<U1, U2>& other)
    {
        AssignFrom(other, Indices{});
        return *this;
    }

    template <class U1, class U2>
        requires __detail::TupleAssignableFrom<pair<U1, U2>&&, Types...>
    constexpr tuple& operator=(pair<U1, U2>&& other)
    {
        AssignFrom(_FSTD::move(other), Indices{});
        return *this;
    }

    template <__detail::TupleLike Other>
        requires(!__detail::IsTupleOrPair<remove_cvref_t<Other>>) &&
                __detail::TupleAssignableFrom<Other, Types...>
    constexpr tuple& operator=(Other&& other)
    {
        AssignFrom(_FSTD::forward<Other>(other), Indices{});
        return *this;
    }

    constexpr void swap(tuple& other) noexcept((is_nothrow_swappable_v<Types> && ...))
    {
        SwapWith(other, Indices{});
    }

private:
    template <class Source, size_t... Index>
    constexpr tuple(__detail::TupleFromTuple, Source&& source, index_sequence<Index...>)
        : __elements(__detail::TupleFromElements{},
                     _FSTD::get<Index>(_FSTD::forward<Source>(source))...)
    {
    }

    template <class Alloc, class Source, size_t... Index>
    constexpr tuple(__detail::TupleWithAllocator tag, const Alloc& allocator, Source&& source,
                    index_sequence<Index...>)
        : __elements(tag, allocator, _FSTD::get<Index>(_FSTD::forward<Source>(source))...)
    {
    }

    template <class Source, size_t... Index>
    constexpr void AssignFrom(Source&& source, index_sequence<Index...>)
    {
        ((_FSTD::get<Index>(*this) = _FSTD::get<Index>(_FSTD::forward<Source>(source))), ...);
    }

    template <size_t... Index> constexpr void SwapWith(tuple& other, index_sequence<Index...>)
    {
        using _FSTD::swap;
        (swap(_FSTD::get<Index>(*this), _FSTD::get<Index>(other)), ...);
    }
};

