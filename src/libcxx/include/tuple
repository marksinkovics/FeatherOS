// Uses-allocator construction: the arguments that build a T with an allocator, as a tuple.
template <class T> struct UsesAllocatorConstruction
{
    template <class Alloc, class... Args>
    static constexpr auto Arguments([[maybe_unused]] const Alloc& allocator,
                                    Args&&... args) noexcept
    {
        if constexpr (!uses_allocator_v<T, Alloc>)
        {
            static_assert(is_constructible_v<T, Args...>,
                          "uses-allocator construction: no constructor takes these arguments");
            return _FSTD::forward_as_tuple(_FSTD::forward<Args>(args)...);
        }
        else if constexpr (is_constructible_v<T, allocator_arg_t, const Alloc&, Args...>)
        {
            return tuple<allocator_arg_t, const Alloc&, Args&&...>(allocator_arg, allocator,
                                                                   _FSTD::forward<Args>(args)...);
        }
        else
        {
            static_assert(is_constructible_v<T, Args..., const Alloc&>,
                          "uses-allocator construction: no constructor takes the allocator");
            return _FSTD::forward_as_tuple(_FSTD::forward<Args>(args)..., allocator);
        }
    }
};

// A pair passes the allocator on to both its members, through its piecewise constructor.
template <class First, class Second> struct UsesAllocatorConstruction<pair<First, Second>>
{
    template <class Alloc, class FirstArguments, class SecondArguments>
    static constexpr auto Arguments(const Alloc& allocator, piecewise_construct_t,
                                    FirstArguments&& first, SecondArguments&& second) noexcept
    {
        return _FSTD::make_tuple(
            piecewise_construct,
            _FSTD::apply(
                [&allocator](auto&&... args)
                {
                    return UsesAllocatorConstruction<remove_cv_t<First>>::Arguments(
                        allocator, _FSTD::forward<decltype(args)>(args)...);
                },
                _FSTD::forward<FirstArguments>(first)),
            _FSTD::apply(
                [&allocator](auto&&... args)
                {
                    return UsesAllocatorConstruction<remove_cv_t<Second>>::Arguments(
                        allocator, _FSTD::forward<decltype(args)>(args)...);
                },
                _FSTD::forward<SecondArguments>(second)));
    }

    template <class Alloc> static constexpr auto Arguments(const Alloc& allocator) noexcept
    {
        return Arguments(allocator, piecewise_construct, tuple<>(), tuple<>());
    }

    template <class Alloc, class U, class V>
    static constexpr auto Arguments(const Alloc& allocator, U&& first, V&& second) noexcept
    {
        return Arguments(allocator, piecewise_construct,
                         _FSTD::forward_as_tuple(_FSTD::forward<U>(first)),
                         _FSTD::forward_as_tuple(_FSTD::forward<V>(second)));
    }

    template <class Alloc, class Pair>
        requires IsPair<remove_cvref_t<Pair>>
    static constexpr auto Arguments(const Alloc& allocator, Pair&& value) noexcept
    {
        return Arguments(allocator, piecewise_construct,
                         _FSTD::forward_as_tuple(_FSTD::get<0>(_FSTD::forward<Pair>(value))),
                         _FSTD::forward_as_tuple(_FSTD::get<1>(_FSTD::forward<Pair>(value))));
    }
};
