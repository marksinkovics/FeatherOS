template <class CharT, class Traits, class Allocator>
constexpr basic_string<CharT, Traits, Allocator>
operator+(basic_string<CharT, Traits, Allocator>&& left,
          basic_string<CharT, Traits, Allocator>&& right)
{
    // Reuses whichever operand already has the room, as the standard suggests.
    if (left.size() + right.size() > left.capacity() &&
        left.size() + right.size() <= right.capacity() &&
        left.get_allocator() == right.get_allocator())
    {
        return _FSTD::move(right.insert(0, left));
    }
    return _FSTD::move(left.append(right));
}
