    requires(is_same_v<CharT, char> || is_same_v<CharT, char8_t> || is_same_v<CharT, char16_t> ||
             is_same_v<CharT, char32_t> || is_same_v<CharT, wchar_t>)
struct hash<basic_string<CharT, char_traits<CharT>, Allocator>>
{
    size_t operator()(const basic_string<CharT, char_traits<CharT>, Allocator>& text) const noexcept
    {
        return __detail::HashCharacters(text.data(), text.size());
    }
