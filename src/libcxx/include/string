private:
    // Up to LocalCapacity characters and the terminator live inside the object; longer strings
    // live on the heap. A capacity of exactly LocalCapacity marks the local form, since a heap
    // block is only ever allocated for more. No member points into the object itself, so
    // strings move by copying their bytes and constant evaluation can keep either form.
    static constexpr size_type LocalCapacity =
        (16 / sizeof(CharT) > 1 ? 16 / sizeof(CharT) : 2) - 1;

    union Storage
    {
        constexpr Storage() noexcept : local{} {}
        constexpr explicit Storage(CharT* block) noexcept : heap(block) {}

        CharT local[LocalCapacity + 1];
        CharT* heap;
    };

    Storage m_storage;
    size_type m_size = 0;
    size_type m_capacity = LocalCapacity;
    [[no_unique_address]] Allocator m_allocator;

    constexpr bool IsLocal() const noexcept
    {
        return m_capacity == LocalCapacity;
    }

    constexpr CharT* Data() noexcept
    {
        return IsLocal() ? m_storage.local : m_storage.heap;
    }

    constexpr const CharT* Data() const noexcept
    {
        return IsLocal() ? m_storage.local : m_storage.heap;
    }

    constexpr void SetSize(size_type size) noexcept
    {
        m_size = size;
        Traits::assign(Data()[size], CharT());
    }

    [[noreturn]] static void LengthError()
    {
        __detail::LibraryAbort("basic_string: the length exceeds max_size()");
    }

    constexpr void CheckIndex(size_type index) const
    {
        if (index >= m_size)
        {
            __detail::LibraryAbort("basic_string::at: the index is out of range");
        }
    }

    constexpr void CheckPosition(size_type position) const
    {
        if (position > m_size)
        {
            __detail::LibraryAbort("basic_string: the position is out of range");
        }
    }

    constexpr size_type Clamp(size_type position, size_type count) const noexcept
    {
        const size_type available = m_size - position;
        return count < available ? count : available;
    }

    constexpr size_type IndexOf(const_iterator position) const noexcept
    {
        return static_cast<size_type>(position - cbegin());
    }

    // True if text may point into this string, which then must not move before it is read.
    // Constant evaluation cannot order unrelated pointers, so it always says yes there.
    constexpr bool MayAlias(const CharT* text) const noexcept
    {
        if (__builtin_is_constant_evaluated())
        {
            return true;
        }
        const CharT* const data = Data();
        return !(text < data) && !(data + m_size < text);
    }

    // Returns a block for at least capacity characters and the terminator, and how many
    // characters it holds besides the terminator, which is always more than LocalCapacity.
    constexpr allocation_result<CharT*> AllocateCharacters(size_type capacity)
    {
        auto [block, count] = AllocatorTraits::allocate_at_least(m_allocator, capacity + 1);
        if (__builtin_is_constant_evaluated())
        {
            for (size_type index = 0; index != count; ++index)
            {
                __detail::ConstructAt(block + index);
            }
        }
        return {block, count - 1};
    }

    constexpr void FreeHeap() noexcept
    {
        if (!IsLocal())
        {
            AllocatorTraits::deallocate(m_allocator, m_storage.heap, m_capacity + 1);
        }
    }

    constexpr void MakeEmptyLocal() noexcept
    {
        FreeHeap();
        __detail::ConstructAt(&m_storage);
        m_size = 0;
        m_capacity = LocalCapacity;
    }

    // Leaves other empty and local. The allocators are the caller's business.
    constexpr void Steal(basic_string& other) noexcept
    {
        m_storage = other.m_storage;
        m_size = other.m_size;
        m_capacity = other.m_capacity;
        __detail::ConstructAt(&other.m_storage);
        other.m_size = 0;
        other.m_capacity = LocalCapacity;
    }

    // Only on an empty local string: room for size characters.
    constexpr CharT* PrepareEmpty(size_type size)
    {
        if (size > LocalCapacity)
        {
            if (size > max_size())
            {
                LengthError();
            }
            auto [block, capacity] = AllocateCharacters(size);
            __detail::ConstructAt(&m_storage, block);
            m_capacity = capacity;
        }
        return Data();
    }

    constexpr void Init(const CharT* text, size_type count)
    {
        Traits::copy(PrepareEmpty(count), text, count);
        SetSize(count);
    }

    constexpr void InitFill(size_type count, CharT character)
    {
        Traits::assign(PrepareEmpty(count), count, character);
        SetSize(count);
    }

    template <class I> constexpr void InitCounted(I first, size_type count)
    {
        CharT* out = PrepareEmpty(count);
        for (size_type index = 0; index != count; ++index, (void)++first)
        {
            Traits::assign(out[index], static_cast<CharT>(*first));
        }
        SetSize(count);
    }

    constexpr size_type GrownCapacity(size_type needed) const
    {
        const size_type maximum = max_size();
        if (needed > maximum)
        {
            LengthError();
        }
        if (needed <= m_capacity)
        {
            return m_capacity;
        }
        if (m_capacity >= maximum / 2)
        {
            return maximum;
        }
        return 2 * m_capacity > needed ? 2 * m_capacity : needed;
    }

    // Builds the new contents, size characters, with fill before the old storage goes away, so
    // fill may read the old contents. A capacity of at most LocalCapacity means local storage.
    template <class Fill> constexpr void Rebuild(size_type size, size_type capacity, Fill fill)
    {
        if (capacity <= LocalCapacity)
        {
            CharT buffer[LocalCapacity + 1]{};
            fill(buffer);
            FreeHeap();
            __detail::ConstructAt(&m_storage);
            m_capacity = LocalCapacity;
            Traits::copy(m_storage.local, buffer, size);
        }
        else
        {
            auto [block, allocated] = AllocateCharacters(capacity);
            fill(block);
            FreeHeap();
            __detail::ConstructAt(&m_storage, block);
            m_capacity = allocated;
        }
        SetSize(size);
    }

    constexpr void MoveTo(size_type capacity)
    {
        const CharT* const old = Data();
        const size_type size = m_size;
        Rebuild(size, capacity, [&](CharT* out) { Traits::copy(out, old, size); });
    }

    // The one primitive behind insert, replace, append and assign: removed characters at
    // position become count characters that write puts in place. may_alias says the written
    // characters may come from this string, which then is rebuilt rather than shifted in place,
    // unless they only go to the end.
    template <class Write>
    constexpr basic_string& Splice(size_type position, size_type removed, size_type count,
                                   bool may_alias, Write write)
    {
        const size_type old_size = m_size;
        const size_type kept = old_size - removed;
        if (count > max_size() - kept)
        {
            LengthError();
        }
        const size_type new_size = kept + count;
        const size_type tail = old_size - position - removed;
        const bool shift_in_place = !may_alias || (tail == 0 && removed == 0);
        if (new_size <= m_capacity && shift_in_place)
        {
            CharT* const data = Data();
            if (count != removed && tail != 0)
            {
                Traits::move(data + position + count, data + position + removed, tail);
            }
            write(data + position);
            SetSize(new_size);
            return *this;
        }
        const CharT* const old = Data();
        Rebuild(new_size, GrownCapacity(new_size),
                [&](CharT* out)
                {
                    Traits::copy(out, old, position);
                    write(out + position);
                    Traits::copy(out + position + count, old + position + removed, tail);
                });
        return *this;
    }

    constexpr basic_string& ReplaceText(size_type position, size_type removed, const CharT* text,
                                        size_type count)
    {
        return Splice(position, removed, count, count != 0 && MayAlias(text),
                      [&](CharT* out) { Traits::copy(out, text, count); });
    }

    constexpr basic_string& ReplaceFill(size_type position, size_type removed, size_type count,
                                        CharT character)
    {
        return Splice(position, removed, count, false,
                      [&](CharT* out) { Traits::assign(out, count, character); });
    }

    // Iterators may point into this string, so anything but a pointer is copied first.
    template <class I, class S>
    constexpr basic_string& ReplaceIterators(size_type position, size_type removed, I first, S last)
    {
        if constexpr (contiguous_iterator<I> && sized_sentinel_for<S, I> &&
                      is_same_v<iter_value_t<I>, CharT>)
        {
            return ReplaceText(position, removed, _FSTD::to_address(first),
                               static_cast<size_type>(last - first));
        }
        else
        {
            basic_string copy(m_allocator);
            for (; first != last; ++first)
            {
                copy.push_back(static_cast<CharT>(*first));
            }
            return ReplaceText(position, removed, copy.Data(), copy.m_size);
        }
    }

    template <class R>
    constexpr basic_string& ReplaceRange(size_type position, size_type removed, R&& range)
    {
        return ReplaceIterators(position, removed, ranges::begin(range), ranges::end(range));
    }
};

