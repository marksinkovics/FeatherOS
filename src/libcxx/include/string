namespace __detail
{
template <class CharT, class Traits, class Allocator>
constexpr basic_string<CharT, Traits, Allocator>
ConcatenateStrings(const Allocator& allocator, const CharT* left, size_t left_count,
                   const CharT* right, size_t right_count)
{
    basic_string<CharT, Traits, Allocator> result(allocator);
    result.reserve(left_count + right_count);
    result.append(left, left_count);
    result.append(right, right_count);
    return result;
}

template <class String> constexpr auto CopyAllocator(const String& text)
{
    return allocator_traits<typename String::allocator_type>::select_on_container_copy_construction(
        text.get_allocator());
}
} // namespace __detail

template <class CharT, class Traits, class Allocator>
constexpr basic_string<CharT, Traits, Allocator>
operator+(const basic_string<CharT, Traits, Allocator>& left,
          const basic_string<CharT, Traits, Allocator>& right)
{
    return __detail::ConcatenateStrings<CharT, Traits>(__detail::CopyAllocator(left), left.data(),
                                                       left.size(), right.data(), right.size());
}
