// -*- C++ -*-
#ifndef FEATHEROS_LIBCXX_STRING
#define FEATHEROS_LIBCXX_STRING

#include "__char_traits"
#include "__featheros_config"
#include "__hash_base"
#include "__iterator_base"
#include "__memory_base"
#include "__pointer_iterator"
#include "compare"
#include "initializer_list"
#include "iterator"
#include "limits"
#include "memory"
#include "string_view"
#include "type_traits"
#include "utility"

// Left out: iostreams (operator<<, operator>>, getline), pmr strings, to_wstring and allocators
// whose pointer is not a plain pointer. Where the standard throws (a position past the end, a
// size past max_size(), stoi of text that is not a number) the library's abort hook runs.

namespace FEATHEROS_STD_NAMESPACE
{

namespace __detail
{
template <class T, class CharT, class Traits>
concept StringViewLike = is_convertible_v<const T&, basic_string_view<CharT, Traits>> &&
                         !is_convertible_v<const T&, const CharT*>;
} // namespace __detail

template <class CharT, class Traits = char_traits<CharT>, class Allocator = allocator<CharT>>
class basic_string
{
    using AllocatorTraits = allocator_traits<Allocator>;
    using View = basic_string_view<CharT, Traits>;

public:
    using traits_type = Traits;
    using value_type = CharT;
    using allocator_type = Allocator;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using reference = CharT&;
    using const_reference = const CharT&;
    using pointer = typename AllocatorTraits::pointer;
    using const_pointer = typename AllocatorTraits::const_pointer;
    using iterator = __detail::PointerIterator<CharT, basic_string>;
    using const_iterator = __detail::PointerIterator<const CharT, basic_string>;
    using reverse_iterator = _FSTD::reverse_iterator<iterator>;
    using const_reverse_iterator = _FSTD::reverse_iterator<const_iterator>;

    static constexpr size_type npos = static_cast<size_type>(-1);

    static_assert(is_same_v<CharT, typename Traits::char_type>,
                  "basic_string's traits must be for its character type");
    static_assert(is_same_v<typename Allocator::value_type, CharT>,
                  "basic_string's allocator must allocate its character type");
    static_assert(is_pointer_v<typename allocator_traits<Allocator>::pointer>,
                  "basic_string needs an allocator whose pointer is a plain pointer");

    constexpr basic_string() noexcept(noexcept(Allocator())) : basic_string(Allocator()) {}
    constexpr explicit basic_string(const Allocator& allocator) noexcept : m_allocator(allocator) {}

    // Swift imports no default arguments, so its CxxStdlib overlay needs the forms without an
    // allocator as constructors of their own, as libc++ has them.
    constexpr basic_string(size_type count, CharT character)
        : basic_string(count, character, Allocator())
    {
    }
    constexpr basic_string(size_type count, CharT character, const Allocator& allocator)
        : m_allocator(allocator)
    {
        InitFill(count, character);
    }

    constexpr basic_string(const basic_string& other, size_type position,
                           const Allocator& allocator = Allocator())
        : m_allocator(allocator)
    {
        other.CheckPosition(position);
        Init(other.Data() + position, other.m_size - position);
    }

    constexpr basic_string(const basic_string& other, size_type position, size_type count,
                           const Allocator& allocator = Allocator())
        : m_allocator(allocator)
    {
        other.CheckPosition(position);
        Init(other.Data() + position, other.Clamp(position, count));
    }

    constexpr basic_string(basic_string&& other, size_type position,
                           const Allocator& allocator = Allocator())
        : basic_string(_FSTD::move(other), position, npos, allocator)
    {
    }

    constexpr basic_string(basic_string&& other, size_type position, size_type count,
                           const Allocator& allocator = Allocator())
        : m_allocator(allocator)
    {
        other.CheckPosition(position);
        const size_type length = other.Clamp(position, count);
        if (AllocatorTraits::is_always_equal::value || m_allocator == other.m_allocator)
        {
            Steal(other);
            erase(position + length);
            erase(0, position);
        }
        else
        {
            Init(other.Data() + position, length);
        }
    }

    constexpr basic_string(const CharT* text, size_type count)
        : basic_string(text, count, Allocator())
    {
    }
    constexpr basic_string(const CharT* text, size_type count, const Allocator& allocator)
        : m_allocator(allocator)
    {
        Init(text, count);
    }

    constexpr basic_string(const CharT* text) : basic_string(text, Allocator()) {}
    constexpr basic_string(const CharT* text, const Allocator& allocator) : m_allocator(allocator)
    {
        Init(text, Traits::length(text));
    }

    basic_string(nullptr_t) = delete;

    template <__detail::ClassicInput I>
    constexpr basic_string(I first, I last, const Allocator& allocator = Allocator())
        : m_allocator(allocator)
    {
        if constexpr (__detail::ClassicForward<I>)
        {
            InitCounted(first, static_cast<size_type>(_FSTD::distance(first, last)));
        }
        else
        {
            for (; first != last; ++first)
            {
                push_back(static_cast<CharT>(*first));
            }
        }
    }

    template <__detail::ContainerCompatibleRange<CharT> R>
    constexpr basic_string(from_range_t, R&& range, const Allocator& allocator = Allocator())
        : m_allocator(allocator)
    {
        if constexpr (ranges::forward_range<R> || ranges::sized_range<R>)
        {
            InitCounted(ranges::begin(range), __detail::RangeLength(range));
        }
        else
        {
            for (auto iterator = ranges::begin(range), last = ranges::end(range); iterator != last;
                 ++iterator)
            {
                push_back(static_cast<CharT>(*iterator));
            }
        }
    }

    constexpr basic_string(initializer_list<CharT> characters,
                           const Allocator& allocator = Allocator())
        : m_allocator(allocator)
    {
        Init(characters.begin(), characters.size());
    }

    template <__detail::StringViewLike<CharT, Traits> T>
    constexpr explicit basic_string(const T& text, const Allocator& allocator = Allocator())
        : m_allocator(allocator)
    {
        const View view = text;
        Init(view.data(), view.size());
    }

    template <class T>
        requires is_convertible_v<const T&, basic_string_view<CharT, Traits>>
    constexpr basic_string(const T& text, size_type position, size_type count,
                           const Allocator& allocator = Allocator())
        : m_allocator(allocator)
    {
        const View view = View(text).substr(position, count);
        Init(view.data(), view.size());
    }

    constexpr basic_string(const basic_string& other)
        : m_allocator(AllocatorTraits::select_on_container_copy_construction(other.m_allocator))
    {
        Init(other.Data(), other.m_size);
    }

    constexpr basic_string(basic_string&& other) noexcept
        : m_allocator(_FSTD::move(other.m_allocator))
    {
        Steal(other);
    }

    constexpr basic_string(const basic_string& other, const type_identity_t<Allocator>& allocator)
        : m_allocator(allocator)
    {
        Init(other.Data(), other.m_size);
    }

    constexpr basic_string(basic_string&& other, const type_identity_t<Allocator>& allocator)
        : m_allocator(allocator)
    {
        if (AllocatorTraits::is_always_equal::value || m_allocator == other.m_allocator)
        {
            Steal(other);
        }
        else
        {
            Init(other.Data(), other.m_size);
        }
    }

    constexpr ~basic_string()
    {
        FreeHeap();
    }

    constexpr basic_string& operator=(const basic_string& other)
    {
        if (this == &other)
        {
            return *this;
        }
        if constexpr (AllocatorTraits::propagate_on_container_copy_assignment::value)
        {
            if (!AllocatorTraits::is_always_equal::value && m_allocator != other.m_allocator)
            {
                MakeEmptyLocal();
            }
            m_allocator = other.m_allocator;
        }
        return assign(other.Data(), other.m_size);
    }

    constexpr basic_string& operator=(basic_string&& other) noexcept(
        AllocatorTraits::propagate_on_container_move_assignment::value ||
        AllocatorTraits::is_always_equal::value)
    {
        if (this == &other)
        {
            return *this;
        }
        if constexpr (AllocatorTraits::propagate_on_container_move_assignment::value)
        {
            MakeEmptyLocal();
            m_allocator = _FSTD::move(other.m_allocator);
            Steal(other);
        }
        else
        {
            if (AllocatorTraits::is_always_equal::value || m_allocator == other.m_allocator)
            {
                MakeEmptyLocal();
                Steal(other);
            }
            else
            {
                assign(other.Data(), other.m_size);
            }
        }
        return *this;
    }

    constexpr basic_string& operator=(const CharT* text)
    {
        return assign(text, Traits::length(text));
    }
    constexpr basic_string& operator=(CharT character)
    {
        return assign(1, character);
    }
    constexpr basic_string& operator=(initializer_list<CharT> characters)
    {
        return assign(characters.begin(), characters.size());
    }
    template <__detail::StringViewLike<CharT, Traits> T>
    constexpr basic_string& operator=(const T& text)
    {
        const View view = text;
        return assign(view.data(), view.size());
    }
    basic_string& operator=(nullptr_t) = delete;

    constexpr basic_string& assign(size_type count, CharT character)
    {
        return ReplaceFill(0, m_size, count, character);
    }
    constexpr basic_string& assign(const basic_string& other)
    {
        return *this = other;
    }
    constexpr basic_string& assign(const basic_string& other, size_type position,
                                   size_type count = npos)
    {
        other.CheckPosition(position);
        return assign(other.Data() + position, other.Clamp(position, count));
    }
    constexpr basic_string& assign(basic_string&& other) noexcept(
        AllocatorTraits::propagate_on_container_move_assignment::value ||
        AllocatorTraits::is_always_equal::value)
    {
        return *this = _FSTD::move(other);
    }
    constexpr basic_string& assign(const CharT* text, size_type count)
    {
        return ReplaceText(0, m_size, text, count);
    }
    constexpr basic_string& assign(const CharT* text)
    {
        return assign(text, Traits::length(text));
    }
    template <__detail::StringViewLike<CharT, Traits> T>
    constexpr basic_string& assign(const T& text)
    {
        const View view = text;
        return assign(view.data(), view.size());
    }
    template <__detail::StringViewLike<CharT, Traits> T>
    constexpr basic_string& assign(const T& text, size_type position, size_type count = npos)
    {
        const View view = View(text).substr(position, count);
        return assign(view.data(), view.size());
    }
    template <__detail::ClassicInput I> constexpr basic_string& assign(I first, I last)
    {
        return ReplaceIterators(0, m_size, first, last);
    }
    constexpr basic_string& assign(initializer_list<CharT> characters)
    {
        return assign(characters.begin(), characters.size());
    }
    template <__detail::ContainerCompatibleRange<CharT> R>
    constexpr basic_string& assign_range(R&& range)
    {
        return ReplaceRange(0, m_size, _FSTD::forward<R>(range));
    }

    constexpr allocator_type get_allocator() const noexcept
    {
        return m_allocator;
    }

    constexpr reference at(size_type index)
    {
        CheckIndex(index);
        return Data()[index];
    }
    constexpr const_reference at(size_type index) const
    {
        CheckIndex(index);
        return Data()[index];
    }
    constexpr reference operator[](size_type index)
    {
        return Data()[index];
    }
    constexpr const_reference operator[](size_type index) const
    {
        return Data()[index];
    }
    constexpr reference front()
    {
        return Data()[0];
    }
    constexpr const_reference front() const
    {
        return Data()[0];
    }
    constexpr reference back()
    {
        return Data()[m_size - 1];
    }
    constexpr const_reference back() const
    {
        return Data()[m_size - 1];
    }
    constexpr CharT* data() noexcept
    {
        return Data();
    }
    constexpr const CharT* data() const noexcept
    {
        return Data();
    }
    constexpr const CharT* c_str() const noexcept
    {
        return Data();
    }
    constexpr operator basic_string_view<CharT, Traits>() const noexcept
    {
        return View(Data(), m_size);
    }

    constexpr iterator begin() noexcept
    {
        return iterator(Data());
    }
    constexpr const_iterator begin() const noexcept
    {
        return const_iterator(Data());
    }
    constexpr const_iterator cbegin() const noexcept
    {
        return begin();
    }
    constexpr iterator end() noexcept
    {
        return iterator(Data() + m_size);
    }
    constexpr const_iterator end() const noexcept
    {
        return const_iterator(Data() + m_size);
    }
    constexpr const_iterator cend() const noexcept
    {
        return end();
    }
    constexpr reverse_iterator rbegin() noexcept
    {
        return reverse_iterator(end());
    }
    constexpr const_reverse_iterator rbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    constexpr const_reverse_iterator crbegin() const noexcept
    {
        return rbegin();
    }
    constexpr reverse_iterator rend() noexcept
    {
        return reverse_iterator(begin());
    }
    constexpr const_reverse_iterator rend() const noexcept
    {
        return const_reverse_iterator(begin());
    }
    constexpr const_reverse_iterator crend() const noexcept
    {
        return rend();
    }

    [[nodiscard]] constexpr bool empty() const noexcept
    {
        return m_size == 0;
    }
    constexpr size_type size() const noexcept
    {
        return m_size;
    }
    constexpr size_type length() const noexcept
    {
        return m_size;
    }
    constexpr size_type max_size() const noexcept
    {
        const size_type allocator_limit = AllocatorTraits::max_size(m_allocator);
        const auto difference_limit =
            static_cast<size_type>(numeric_limits<difference_type>::max());
        // One character is the terminator.
        return (allocator_limit < difference_limit ? allocator_limit : difference_limit) - 1;
    }
    constexpr size_type capacity() const noexcept
    {
        return m_capacity;
    }

    constexpr void reserve(size_type new_capacity)
    {
        if (new_capacity > m_capacity)
        {
            if (new_capacity > max_size())
            {
                LengthError();
            }
            MoveTo(new_capacity);
        }
    }

    constexpr void shrink_to_fit()
    {
        if (!IsLocal() && m_capacity > m_size)
        {
            MoveTo(m_size);
        }
    }

    constexpr void clear() noexcept
    {
        SetSize(0);
    }

    constexpr basic_string& insert(size_type index, size_type count, CharT character)
    {
        CheckPosition(index);
        return ReplaceFill(index, 0, count, character);
    }
    constexpr basic_string& insert(size_type index, const CharT* text)
    {
        return insert(index, text, Traits::length(text));
    }
    constexpr basic_string& insert(size_type index, const CharT* text, size_type count)
    {
        CheckPosition(index);
        return ReplaceText(index, 0, text, count);
    }
    constexpr basic_string& insert(size_type index, const basic_string& other)
    {
        return insert(index, other.Data(), other.m_size);
    }
    constexpr basic_string& insert(size_type index, const basic_string& other,
                                   size_type other_index, size_type count = npos)
    {
        other.CheckPosition(other_index);
        return insert(index, other.Data() + other_index, other.Clamp(other_index, count));
    }
    constexpr iterator insert(const_iterator position, CharT character)
    {
        return insert(position, 1, character);
    }
    constexpr iterator insert(const_iterator position, size_type count, CharT character)
    {
        const size_type index = IndexOf(position);
        ReplaceFill(index, 0, count, character);
        return begin() + static_cast<difference_type>(index);
    }
    template <__detail::ClassicInput I>
    constexpr iterator insert(const_iterator position, I first, I last)
    {
        const size_type index = IndexOf(position);
        ReplaceIterators(index, 0, first, last);
        return begin() + static_cast<difference_type>(index);
    }
    constexpr iterator insert(const_iterator position, initializer_list<CharT> characters)
    {
        const size_type index = IndexOf(position);
        ReplaceText(index, 0, characters.begin(), characters.size());
        return begin() + static_cast<difference_type>(index);
    }
    template <__detail::StringViewLike<CharT, Traits> T>
    constexpr basic_string& insert(size_type index, const T& text)
    {
        const View view = text;
        return insert(index, view.data(), view.size());
    }
    template <__detail::StringViewLike<CharT, Traits> T>
    constexpr basic_string& insert(size_type index, const T& text, size_type text_index,
                                   size_type count = npos)
    {
        const View view = View(text).substr(text_index, count);
        return insert(index, view.data(), view.size());
    }
    template <__detail::ContainerCompatibleRange<CharT> R>
    constexpr iterator insert_range(const_iterator position, R&& range)
    {
        const size_type index = IndexOf(position);
        ReplaceRange(index, 0, _FSTD::forward<R>(range));
        return begin() + static_cast<difference_type>(index);
    }

    constexpr basic_string& erase(size_type index = 0, size_type count = npos)
    {
        CheckPosition(index);
        const size_type removed = Clamp(index, count);
        if (removed != 0)
        {
            CharT* const data = Data();
            Traits::move(data + index, data + index + removed, m_size - index - removed);
            SetSize(m_size - removed);
        }
        return *this;
    }
    constexpr iterator erase(const_iterator position)
    {
        const size_type index = IndexOf(position);
        erase(index, 1);
        return begin() + static_cast<difference_type>(index);
    }
    constexpr iterator erase(const_iterator first, const_iterator last)
    {
        const size_type index = IndexOf(first);
        erase(index, static_cast<size_type>(last - first));
        return begin() + static_cast<difference_type>(index);
    }

    constexpr void push_back(CharT character)
    {
        if (m_size < m_capacity)
        {
            CharT* const data = Data();
            Traits::assign(data[m_size], character);
            ++m_size;
            Traits::assign(data[m_size], CharT());
            return;
        }
        ReplaceFill(m_size, 0, 1, character);
    }

    constexpr void pop_back()
    {
        SetSize(m_size - 1);
    }

    constexpr basic_string& append(size_type count, CharT character)
    {
        return ReplaceFill(m_size, 0, count, character);
    }
    constexpr basic_string& append(const basic_string& other)
    {
        return append(other.Data(), other.m_size);
    }
    constexpr basic_string& append(const basic_string& other, size_type position,
                                   size_type count = npos)
    {
        other.CheckPosition(position);
        return append(other.Data() + position, other.Clamp(position, count));
    }
    constexpr basic_string& append(const CharT* text, size_type count)
    {
        return ReplaceText(m_size, 0, text, count);
    }
    constexpr basic_string& append(const CharT* text)
    {
        return append(text, Traits::length(text));
    }
    template <__detail::ClassicInput I> constexpr basic_string& append(I first, I last)
    {
        return ReplaceIterators(m_size, 0, first, last);
    }
    constexpr basic_string& append(initializer_list<CharT> characters)
    {
        return append(characters.begin(), characters.size());
    }
    template <__detail::StringViewLike<CharT, Traits> T>
    constexpr basic_string& append(const T& text)
    {
        const View view = text;
        return append(view.data(), view.size());
    }
    template <__detail::StringViewLike<CharT, Traits> T>
    constexpr basic_string& append(const T& text, size_type position, size_type count = npos)
    {
        const View view = View(text).substr(position, count);
        return append(view.data(), view.size());
    }
    template <__detail::ContainerCompatibleRange<CharT> R>
    constexpr basic_string& append_range(R&& range)
    {
        return ReplaceRange(m_size, 0, _FSTD::forward<R>(range));
    }

    constexpr basic_string& operator+=(const basic_string& other)
    {
        return append(other);
    }
    constexpr basic_string& operator+=(CharT character)
    {
        push_back(character);
        return *this;
    }
    constexpr basic_string& operator+=(const CharT* text)
    {
        return append(text);
    }
    constexpr basic_string& operator+=(initializer_list<CharT> characters)
    {
        return append(characters);
    }
    template <__detail::StringViewLike<CharT, Traits> T>
    constexpr basic_string& operator+=(const T& text)
    {
        return append(text);
    }

    constexpr basic_string& replace(size_type position, size_type count, const basic_string& other)
    {
        return replace(position, count, other.Data(), other.m_size);
    }
    constexpr basic_string& replace(const_iterator first, const_iterator last,
                                    const basic_string& other)
    {
        return ReplaceText(IndexOf(first), static_cast<size_type>(last - first), other.Data(),
                           other.m_size);
    }
    constexpr basic_string& replace(size_type position, size_type count, const basic_string& other,
                                    size_type other_position, size_type other_count = npos)
    {
        other.CheckPosition(other_position);
        return replace(position, count, other.Data() + other_position,
                       other.Clamp(other_position, other_count));
    }
    constexpr basic_string& replace(size_type position, size_type count, const CharT* text,
                                    size_type text_count)
    {
        CheckPosition(position);
        return ReplaceText(position, Clamp(position, count), text, text_count);
    }
    constexpr basic_string& replace(const_iterator first, const_iterator last, const CharT* text,
                                    size_type text_count)
    {
        return ReplaceText(IndexOf(first), static_cast<size_type>(last - first), text, text_count);
    }
    constexpr basic_string& replace(size_type position, size_type count, const CharT* text)
    {
        return replace(position, count, text, Traits::length(text));
    }
    constexpr basic_string& replace(const_iterator first, const_iterator last, const CharT* text)
    {
        return replace(first, last, text, Traits::length(text));
    }
    constexpr basic_string& replace(size_type position, size_type count, size_type fill_count,
                                    CharT character)
    {
        CheckPosition(position);
        return ReplaceFill(position, Clamp(position, count), fill_count, character);
    }
    constexpr basic_string& replace(const_iterator first, const_iterator last, size_type fill_count,
                                    CharT character)
    {
        return ReplaceFill(IndexOf(first), static_cast<size_type>(last - first), fill_count,
                           character);
    }
    template <__detail::ClassicInput I>
    constexpr basic_string& replace(const_iterator first, const_iterator last, I first_input,
                                    I last_input)
    {
        return ReplaceIterators(IndexOf(first), static_cast<size_type>(last - first), first_input,
                                last_input);
    }
    constexpr basic_string& replace(const_iterator first, const_iterator last,
                                    initializer_list<CharT> characters)
    {
        return replace(first, last, characters.begin(), characters.size());
    }
    template <__detail::StringViewLike<CharT, Traits> T>
    constexpr basic_string& replace(size_type position, size_type count, const T& text)
    {
        const View view = text;
        return replace(position, count, view.data(), view.size());
    }
    template <__detail::StringViewLike<CharT, Traits> T>
    constexpr basic_string& replace(const_iterator first, const_iterator last, const T& text)
    {
        const View view = text;
        return replace(first, last, view.data(), view.size());
    }
    template <__detail::StringViewLike<CharT, Traits> T>
    constexpr basic_string& replace(size_type position, size_type count, const T& text,
                                    size_type text_position, size_type text_count = npos)
    {
        const View view = View(text).substr(text_position, text_count);
        return replace(position, count, view.data(), view.size());
    }
    template <__detail::ContainerCompatibleRange<CharT> R>
    constexpr basic_string& replace_with_range(const_iterator first, const_iterator last, R&& range)
    {
        return ReplaceRange(IndexOf(first), static_cast<size_type>(last - first),
