namespace __detail
{
// The host tests run these headers over the host's containers, whose iterators name the host's
// tags; they count as ours there.
template <class Tag> struct OwnTagOf
{
    using type = Tag;
};
#if !FEATHEROS_STD_IS_STD
template <> struct OwnTagOf<::std::input_iterator_tag>
{
    using type = input_iterator_tag;
};
template <> struct OwnTagOf<::std::output_iterator_tag>
{
    using type = output_iterator_tag;
};
template <> struct OwnTagOf<::std::forward_iterator_tag>
{
    using type = forward_iterator_tag;
};
template <> struct OwnTagOf<::std::bidirectional_iterator_tag>
{
    using type = bidirectional_iterator_tag;
};
template <> struct OwnTagOf<::std::random_access_iterator_tag>
{
    using type = random_access_iterator_tag;
};
template <> struct OwnTagOf<::std::contiguous_iterator_tag>
{
    using type = contiguous_iterator_tag;
};
#endif
template <class Tag> using OwnTag = typename OwnTagOf<Tag>::type;
} // namespace __detail

namespace __detail
{
template <class T> using WithReference = T&;
template <class T>
concept CanReference = requires { typename WithReference<T>; };
template <class T>
concept Dereferenceable = requires(T& value) {
    { *value } -> CanReference;
};

template <class T>
constexpr decay_t<T> DecayCopy(T&& value) noexcept(is_nothrow_convertible_v<T, decay_t<T>>)
{
    return _FSTD::forward<T>(value);
}

template <class T>
concept IntegerLike = integral<T> && !same_as<remove_cv_t<T>, bool>;
template <class T>
concept SignedIntegerLike = signed_integral<T>;
} // namespace __detail

template <__detail::Dereferenceable T> using iter_reference_t = decltype(*declval<T&>());

template <class T> struct incrementable_traits
{
};
template <class T>
    requires is_object_v<T>
struct incrementable_traits<T*>
{
    using difference_type = ptrdiff_t;
};
template <class T> struct incrementable_traits<const T> : incrementable_traits<T>
{
};
template <class T>
    requires requires { typename T::difference_type; }
struct incrementable_traits<T>
{
    using difference_type = typename T::difference_type;
};
template <class T>
    requires(!requires { typename T::difference_type; }) &&
            requires(const T& left, const T& right) {
                { left - right } -> integral;
            }
struct incrementable_traits<T>
{
    using difference_type = make_signed_t<decltype(declval<T>() - declval<T>())>;
};

namespace __detail
{
template <class T> struct ValueTypeOf
{
};
template <class T>
    requires is_object_v<T>
struct ValueTypeOf<T>
{
    using value_type = remove_cv_t<T>;
};

template <class T>
concept HasMemberValueType = requires { typename T::value_type; };
template <class T>
concept HasMemberElementType = requires { typename T::element_type; };
} // namespace __detail

template <class T> struct indirectly_readable_traits
{
};
template <class T> struct indirectly_readable_traits<T*> : __detail::ValueTypeOf<T>
{
};
template <class T>
    requires is_array_v<T>
struct indirectly_readable_traits<T>
{
    using value_type = remove_cv_t<remove_extent_t<T>>;
};
template <class T> struct indirectly_readable_traits<const T> : indirectly_readable_traits<T>
{
};
template <__detail::HasMemberValueType T>
struct indirectly_readable_traits<T> : __detail::ValueTypeOf<typename T::value_type>
{
};
template <__detail::HasMemberElementType T>
struct indirectly_readable_traits<T> : __detail::ValueTypeOf<typename T::element_type>
{
};
template <class T>
    requires __detail::HasMemberValueType<T> && __detail::HasMemberElementType<T>
struct indirectly_readable_traits<T>
{
};
template <class T>
    requires __detail::HasMemberValueType<T> && __detail::HasMemberElementType<T> &&
             same_as<remove_cv_t<typename T::value_type>, remove_cv_t<typename T::element_type>>
struct indirectly_readable_traits<T> : __detail::ValueTypeOf<typename T::value_type>
{
};

// The C++17 iterator requirements, which iterator_traits uses for iterators without the member
// types.
namespace __detail
{
template <class I>
concept Cpp17IteratorMembers = requires {
    typename I::difference_type;
    typename I::value_type;
    typename I::reference;
    typename I::iterator_category;
};

template <class I>
concept Cpp17Iterator = requires(I iterator) {
    { *iterator } -> CanReference;
    { ++iterator } -> same_as<I&>;
    { *iterator++ } -> CanReference;
} && copyable<I>;

template <class I>
concept Cpp17InputIterator = Cpp17Iterator<I> && equality_comparable<I> && requires(I iterator) {
    typename incrementable_traits<I>::difference_type;
    typename indirectly_readable_traits<I>::value_type;
    typename common_reference_t<iter_reference_t<I>&&,
                                typename indirectly_readable_traits<I>::value_type&>;
    typename common_reference_t<decltype(*iterator++)&&,
                                typename indirectly_readable_traits<I>::value_type&>;
    requires signed_integral<typename incrementable_traits<I>::difference_type>;
};

template <class I>
concept Cpp17ForwardIterator =
    Cpp17InputIterator<I> && constructible_from<I> && is_reference_v<iter_reference_t<I>> &&
    same_as<remove_cvref_t<iter_reference_t<I>>,
            typename indirectly_readable_traits<I>::value_type> &&
    requires(I iterator) {
        { iterator++ } -> convertible_to<const I&>;
        { *iterator++ } -> same_as<iter_reference_t<I>>;
    };

template <class I>
concept Cpp17BidirectionalIterator = Cpp17ForwardIterator<I> && requires(I iterator) {
    { --iterator } -> same_as<I&>;
    { iterator-- } -> convertible_to<const I&>;
    { *iterator-- } -> same_as<iter_reference_t<I>>;
};

template <class I>
concept Cpp17RandomAccessIterator =
    Cpp17BidirectionalIterator<I> && totally_ordered<I> &&
    requires(I iterator, typename incrementable_traits<I>::difference_type count) {
        { iterator += count } -> same_as<I&>;
        { iterator -= count } -> same_as<I&>;
        { iterator + count } -> same_as<I>;
        { count + iterator } -> same_as<I>;
        { iterator - count } -> same_as<I>;
        { iterator - iterator } -> same_as<decltype(count)>;
        { iterator[count] } -> convertible_to<iter_reference_t<I>>;
    };

template <class I> consteval auto Cpp17Category()
{
    if constexpr (requires { typename I::iterator_category; })
    {
        return type_identity<typename I::iterator_category>{};
    }
    else if constexpr (Cpp17RandomAccessIterator<I>)
    {
        return type_identity<random_access_iterator_tag>{};
    }
    else if constexpr (Cpp17BidirectionalIterator<I>)
    {
        return type_identity<bidirectional_iterator_tag>{};
    }
    else if constexpr (Cpp17ForwardIterator<I>)
    {
        return type_identity<forward_iterator_tag>{};
    }
    else
    {
        return type_identity<input_iterator_tag>{};
    }
}

template <class I> consteval auto Cpp17Pointer()
{
    if constexpr (requires { typename I::pointer; })
    {
        return type_identity<typename I::pointer>{};
    }
    else if constexpr (requires(I& iterator) { iterator.operator->(); })
    {
        return type_identity<decltype(declval<I&>().operator->())>{};
    }
    else
    {
        return type_identity<void>{};
    }
}

template <class I> consteval auto MemberPointer()
{
    if constexpr (requires { typename I::pointer; })
    {
        return type_identity<typename I::pointer>{};
    }
    else
    {
        return type_identity<void>{};
    }
}

template <class I> consteval auto Cpp17Reference()
{
    if constexpr (requires { typename I::reference; })
    {
        return type_identity<typename I::reference>{};
    }
    else
    {
        return type_identity<iter_reference_t<I>>{};
    }
}

template <class I> consteval auto DifferenceOrVoid()
{
    if constexpr (requires { typename incrementable_traits<I>::difference_type; })
    {
        return type_identity<typename incrementable_traits<I>::difference_type>{};
    }
    else
    {
        return type_identity<void>{};
    }
}

template <class I> struct IteratorTraitsBase
{
};

template <Cpp17IteratorMembers I> struct IteratorTraitsBase<I>
{
    using iterator_category = OwnTag<typename I::iterator_category>;
    using value_type = typename I::value_type;
    using difference_type = typename I::difference_type;
    using pointer = typename decltype(MemberPointer<I>())::type;
    using reference = typename I::reference;
};

template <class I>
    requires(!Cpp17IteratorMembers<I>) && Cpp17InputIterator<I>
struct IteratorTraitsBase<I>
{
    using iterator_category = typename decltype(Cpp17Category<I>())::type;
    using value_type = typename indirectly_readable_traits<I>::value_type;
    using difference_type = typename incrementable_traits<I>::difference_type;
    using pointer = typename decltype(Cpp17Pointer<I>())::type;
    using reference = typename decltype(Cpp17Reference<I>())::type;
};

template <class I>
    requires(!Cpp17IteratorMembers<I>) && (!Cpp17InputIterator<I>) && Cpp17Iterator<I>
struct IteratorTraitsBase<I>
{
    using iterator_category = output_iterator_tag;
    using value_type = void;
    using difference_type = typename decltype(DifferenceOrVoid<I>())::type;
    using pointer = void;
    using reference = void;
};
} // namespace __detail

// The primary template names itself, which is how the iterator concepts tell it from a
// specialization (ITER_TRAITS in [iterator.concepts.general]).
template <class I> struct iterator_traits : __detail::IteratorTraitsBase<I>
{
    using __primary_template = iterator_traits;
};

template <class T>
    requires is_object_v<T>
struct iterator_traits<T*>
{
    using iterator_concept = contiguous_iterator_tag;
    using iterator_category = random_access_iterator_tag;
    using value_type = remove_cv_t<T>;
    using difference_type = ptrdiff_t;
    using pointer = T*;
    using reference = T&;
};

namespace __detail
{
template <class I>
concept PrimaryIteratorTraits = requires {
    typename iterator_traits<I>::__primary_template;
} && same_as<typename iterator_traits<I>::__primary_template, iterator_traits<I>>;

template <class I>
using IterTraits = conditional_t<PrimaryIteratorTraits<I>, I, iterator_traits<I>>;

template <class I> struct IterConceptOf
{
};
template <class I>
    requires requires { typename IterTraits<I>::iterator_concept; }
struct IterConceptOf<I>
{
    using type = OwnTag<typename IterTraits<I>::iterator_concept>;
};
template <class I>
    requires(!requires { typename IterTraits<I>::iterator_concept; }) &&
            requires { typename IterTraits<I>::iterator_category; }
struct IterConceptOf<I>
{
    using type = OwnTag<typename IterTraits<I>::iterator_category>;
};
template <class I>
    requires(!requires { typename IterTraits<I>::iterator_concept; }) &&
            (!requires { typename IterTraits<I>::iterator_category; }) && PrimaryIteratorTraits<I>
struct IterConceptOf<I>
{
    using type = random_access_iterator_tag;
};
template <class I> using IterConcept = typename IterConceptOf<I>::type;
} // namespace __detail

template <class I>
using iter_value_t = typename conditional_t<__detail::PrimaryIteratorTraits<remove_cvref_t<I>>,
                                            indirectly_readable_traits<remove_cvref_t<I>>,
                                            iterator_traits<remove_cvref_t<I>>>::value_type;

template <class I>
using iter_difference_t =
    typename conditional_t<__detail::PrimaryIteratorTraits<remove_cvref_t<I>>,
                           incrementable_traits<remove_cvref_t<I>>,
                           iterator_traits<remove_cvref_t<I>>>::difference_type;

namespace ranges::__iter_move
{
void iter_move() = delete;

template <class T>
concept Unqualified = __swap::ClassOrEnum<remove_cvref_t<T>> &&
                      requires(T&& value) { iter_move(_FSTD::forward<T>(value)); };
template <class T>
concept MoveDereferenced = !Unqualified<T> && requires(T&& value) {
    *value;
    requires is_lvalue_reference_v<decltype(*value)>;
};
template <class T>
concept Dereferenced = !Unqualified<T> && !MoveDereferenced<T> && requires(T&& value) { *value; };

struct IterMove
{
    template <Unqualified T>
    constexpr decltype(auto) operator()(T&& value) const
        noexcept(noexcept(iter_move(_FSTD::forward<T>(value))))
    {
        return iter_move(_FSTD::forward<T>(value));
    }

    template <MoveDereferenced T>
    constexpr auto operator()(T&& value) const noexcept(noexcept(*_FSTD::forward<T>(value)))
        -> decltype(_FSTD::move(*_FSTD::forward<T>(value)))
    {
        return _FSTD::move(*_FSTD::forward<T>(value));
    }

    template <Dereferenced T>
    constexpr auto operator()(T&& value) const noexcept(noexcept(*_FSTD::forward<T>(value)))
        -> decltype(*_FSTD::forward<T>(value))
    {
        return *_FSTD::forward<T>(value);
    }
};
} // namespace ranges::__iter_move

namespace ranges
{
inline namespace __cpo
{
inline constexpr __iter_move::IterMove iter_move{};
} // namespace __cpo
} // namespace ranges

template <__detail::Dereferenceable T>
    requires requires(T& value) {
        { ranges::iter_move(value) } -> __detail::CanReference;
    }
using iter_rvalue_reference_t = decltype(ranges::iter_move(declval<T&>()));

namespace __detail
{
template <class In>
concept IndirectlyReadable =
    requires(const In in) {
        typename iter_value_t<In>;
        typename iter_reference_t<In>;
        typename iter_rvalue_reference_t<In>;
        { *in } -> same_as<iter_reference_t<In>>;
        { ranges::iter_move(in) } -> same_as<iter_rvalue_reference_t<In>>;
    } && common_reference_with<iter_reference_t<In>&&, iter_value_t<In>&> &&
    common_reference_with<iter_reference_t<In>&&, iter_rvalue_reference_t<In>&&> &&
    common_reference_with<iter_rvalue_reference_t<In>&&, const iter_value_t<In>&>;
} // namespace __detail

template <class In>
concept indirectly_readable = __detail::IndirectlyReadable<remove_cvref_t<In>>;

template <indirectly_readable T>
using iter_common_reference_t = common_reference_t<iter_reference_t<T>, iter_value_t<T>&>;

template <class Out, class T>
concept indirectly_writable = requires(Out&& out, T&& value) {
    *out = _FSTD::forward<T>(value);
    *_FSTD::forward<Out>(out) = _FSTD::forward<T>(value);
    const_cast<const iter_reference_t<Out>&&>(*out) = _FSTD::forward<T>(value);
    const_cast<const iter_reference_t<Out>&&>(*_FSTD::forward<Out>(out)) = _FSTD::forward<T>(value);
};

template <class I>
concept weakly_incrementable = movable<I> && requires(I iterator) {
    typename iter_difference_t<I>;
    requires __detail::SignedIntegerLike<iter_difference_t<I>>;
    { ++iterator } -> same_as<I&>;
    iterator++;
};

template <class I>
concept incrementable = regular<I> && weakly_incrementable<I> && requires(I iterator) {
    { iterator++ } -> same_as<I>;
};

template <class I>
concept input_or_output_iterator = requires(I iterator) {
    { *iterator } -> __detail::CanReference;
} && weakly_incrementable<I>;

template <class S, class I>
concept sentinel_for =
    semiregular<S> && input_or_output_iterator<I> && __detail::WeaklyEqualityComparableWith<S, I>;

template <class S, class I> inline constexpr bool disable_sized_sentinel_for = false;

template <class S, class I>
concept sized_sentinel_for =
    sentinel_for<S, I> && !disable_sized_sentinel_for<remove_cv_t<S>, remove_cv_t<I>> &&
    requires(const I& iterator, const S& sentinel) {
        { sentinel - iterator } -> same_as<iter_difference_t<I>>;
        { iterator - sentinel } -> same_as<iter_difference_t<I>>;
    };

template <class I>
concept input_iterator = input_or_output_iterator<I> && indirectly_readable<I> && requires {
    typename __detail::IterConcept<I>;
} && derived_from<__detail::IterConcept<I>, input_iterator_tag>;

template <class I, class T>
concept output_iterator =
    input_or_output_iterator<I> && indirectly_writable<I, T> &&
    requires(I iterator, T&& value) { *iterator++ = _FSTD::forward<T>(value); };

template <class I>
concept forward_iterator =
    input_iterator<I> && derived_from<__detail::IterConcept<I>, forward_iterator_tag> &&
    incrementable<I> && sentinel_for<I, I>;

template <class I>
concept bidirectional_iterator =
    forward_iterator<I> && derived_from<__detail::IterConcept<I>, bidirectional_iterator_tag> &&
    requires(I iterator) {
        { --iterator } -> same_as<I&>;
        { iterator-- } -> same_as<I>;
    };

template <class I>
concept random_access_iterator =
    bidirectional_iterator<I> &&
    derived_from<__detail::IterConcept<I>, random_access_iterator_tag> && totally_ordered<I> &&
    sized_sentinel_for<I, I> &&
    requires(I iterator, const I constant, const iter_difference_t<I> count) {
        { iterator += count } -> same_as<I&>;
        { constant + count } -> same_as<I>;
        { count + constant } -> same_as<I>;
        { iterator -= count } -> same_as<I&>;
        { constant - count } -> same_as<I>;
        { constant[count] } -> same_as<iter_reference_t<I>>;
    };

template <class I>
concept contiguous_iterator =
    random_access_iterator<I> && derived_from<__detail::IterConcept<I>, contiguous_iterator_tag> &&
    is_lvalue_reference_v<iter_reference_t<I>> &&
    same_as<iter_value_t<I>, remove_cvref_t<iter_reference_t<I>>> && requires(const I& iterator) {
        { _FSTD::to_address(iterator) } -> same_as<add_pointer_t<iter_reference_t<I>>>;
    };

// The classic iterator operations, by iterator_traits' category.
namespace __detail
{
template <class I>
concept ClassicRandomAccess = requires {
    typename iterator_traits<I>::iterator_category;
} && derived_from<typename iterator_traits<I>::iterator_category, random_access_iterator_tag>;

template <class I>
concept ClassicBidirectional = requires {
    typename iterator_traits<I>::iterator_category;
} && derived_from<typename iterator_traits<I>::iterator_category, bidirectional_iterator_tag>;

template <class I>
concept ClassicForward = requires {
    typename iterator_traits<I>::iterator_category;
} && derived_from<typename iterator_traits<I>::iterator_category, forward_iterator_tag>;

// What the containers' iterator-pair members take, which keeps (count, value) apart from them.
template <class I>
concept ClassicInput = requires {
    typename iterator_traits<I>::iterator_category;
} && derived_from<typename iterator_traits<I>::iterator_category, input_iterator_tag>;
} // namespace __detail

template <class I, class Distance> constexpr void advance(I& iterator, Distance count)
{
    using Difference = typename iterator_traits<I>::difference_type;
    auto steps = static_cast<Difference>(count);
    if constexpr (__detail::ClassicRandomAccess<I>)
    {
        iterator += steps;
    }
    else
    {
        for (; steps > 0; --steps)
        {
            ++iterator;
        }
        if constexpr (__detail::ClassicBidirectional<I>)
        {
            for (; steps < 0; ++steps)
            {
                --iterator;
            }
        }
    }
}

template <class I> constexpr typename iterator_traits<I>::difference_type distance(I first, I last)
{
    if constexpr (__detail::ClassicRandomAccess<I>)
    {
        return last - first;
    }
    else
    {
        typename iterator_traits<I>::difference_type count = 0;
        for (; first != last; ++first)
        {
            ++count;
        }
        return count;
    }
}

template <class I>
constexpr I next(I iterator, typename iterator_traits<I>::difference_type count = 1)
{
    _FSTD::advance(iterator, count);
    return iterator;
}

template <class I>
constexpr I prev(I iterator, typename iterator_traits<I>::difference_type count = 1)
{
    _FSTD::advance(iterator, -count);
    return iterator;
}

template <class I> class reverse_iterator
{
public:
    using iterator_type = I;
    using iterator_concept = conditional_t<random_access_iterator<I>, random_access_iterator_tag,
                                           bidirectional_iterator_tag>;
    using iterator_category = conditional_t<
        derived_from<typename iterator_traits<I>::iterator_category, random_access_iterator_tag>,
        random_access_iterator_tag, typename iterator_traits<I>::iterator_category>;
    using value_type = iter_value_t<I>;
    using difference_type = iter_difference_t<I>;
    using pointer = typename iterator_traits<I>::pointer;
    using reference = iter_reference_t<I>;

    constexpr reverse_iterator() : current() {}
    constexpr explicit reverse_iterator(I iterator) : current(_FSTD::move(iterator)) {}

    template <class U>
        requires(!is_same_v<U, I>) && convertible_to<const U&, I>
    constexpr reverse_iterator(const reverse_iterator<U>& other) : current(other.base())
    {
    }

    template <class U>
        requires(!is_same_v<U, I>) && convertible_to<const U&, I> && assignable_from<I&, const U&>
    constexpr reverse_iterator& operator=(const reverse_iterator<U>& other)
    {
        current = other.base();
        return *this;
    }

    constexpr I base() const
    {
        return current;
    }

    constexpr reference operator*() const
    {
        I before = current;
        return *--before;
    }

    constexpr pointer operator->() const
        requires is_pointer_v<I> || requires(const I iterator) { iterator.operator->(); }
    {
        I before = current;
        --before;
        if constexpr (is_pointer_v<I>)
        {
            return before;
        }
        else
        {
            return before.operator->();
        }
    }

    constexpr reverse_iterator& operator++()
    {
        --current;
        return *this;
    }
    constexpr reverse_iterator operator++(int)
    {
        reverse_iterator previous = *this;
        --current;
        return previous;
    }
    constexpr reverse_iterator& operator--()
    {
        ++current;
        return *this;
    }
    constexpr reverse_iterator operator--(int)
    {
        reverse_iterator previous = *this;
        ++current;
        return previous;
    }

    constexpr reverse_iterator operator+(difference_type count) const
    {
        return reverse_iterator(current - count);
    }
    constexpr reverse_iterator& operator+=(difference_type count)
    {
        current -= count;
        return *this;
    }
    constexpr reverse_iterator operator-(difference_type count) const
    {
        return reverse_iterator(current + count);
    }
    constexpr reverse_iterator& operator-=(difference_type count)
    {
        current += count;
        return *this;
    }
    constexpr decltype(auto) operator[](difference_type count) const
    {
        return current[-count - 1];
    }

    friend constexpr iter_rvalue_reference_t<I> iter_move(
        const reverse_iterator& iterator) noexcept(is_nothrow_copy_constructible_v<I> &&
                                                   noexcept(ranges::iter_move(--declval<I&>())))
    {
        I before = iterator.current;
        return ranges::iter_move(--before);
    }

protected:
    I current;
};

template <class I1, class I2>
    requires requires(const I1& left, const I2& right) {
        { left == right } -> convertible_to<bool>;
    }
constexpr bool operator==(const reverse_iterator<I1>& left, const reverse_iterator<I2>& right)
{
    return left.base() == right.base();
}

template <class I1, class I2>
    requires requires(const I1& left, const I2& right) {
        { left != right } -> convertible_to<bool>;
    }
constexpr bool operator!=(const reverse_iterator<I1>& left, const reverse_iterator<I2>& right)
{
    return left.base() != right.base();
}

template <class I1, class I2>
    requires requires(const I1& left, const I2& right) {
        { left > right } -> convertible_to<bool>;
    }
constexpr bool operator<(const reverse_iterator<I1>& left, const reverse_iterator<I2>& right)
{
    return left.base() > right.base();
}

template <class I1, class I2>
    requires requires(const I1& left, const I2& right) {
        { left < right } -> convertible_to<bool>;
    }
constexpr bool operator>(const reverse_iterator<I1>& left, const reverse_iterator<I2>& right)
{
    return left.base() < right.base();
}

template <class I1, class I2>
    requires requires(const I1& left, const I2& right) {
        { left >= right } -> convertible_to<bool>;
    }
constexpr bool operator<=(const reverse_iterator<I1>& left, const reverse_iterator<I2>& right)
{
    return left.base() >= right.base();
}

template <class I1, class I2>
    requires requires(const I1& left, const I2& right) {
        { left <= right } -> convertible_to<bool>;
    }
constexpr bool operator>=(const reverse_iterator<I1>& left, const reverse_iterator<I2>& right)
{
    return left.base() <= right.base();
}

template <class I1, three_way_comparable_with<I1> I2>
constexpr compare_three_way_result_t<I1, I2> operator<=>(const reverse_iterator<I1>& left,
                                                         const reverse_iterator<I2>& right)
{
    return right.base() <=> left.base();
}

template <class I1, class I2>
constexpr auto operator-(const reverse_iterator<I1>& left, const reverse_iterator<I2>& right)
    -> decltype(right.base() - left.base())
{
    return right.base() - left.base();
}

template <class I>
constexpr reverse_iterator<I> operator+(iter_difference_t<I> count,
                                        const reverse_iterator<I>& iterator)
{
    return reverse_iterator<I>(iterator.base() - count);
}

template <class I> constexpr reverse_iterator<I> make_reverse_iterator(I iterator)
{
    return reverse_iterator<I>(_FSTD::move(iterator));
}

template <class I1, class I2>
    requires(!sized_sentinel_for<I1, I2>)
inline constexpr bool disable_sized_sentinel_for<reverse_iterator<I1>, reverse_iterator<I2>> = true;

