// The range access objects and range concepts of <ranges>.
namespace ranges
{
template <class T> inline constexpr bool enable_borrowed_range = false;
template <class T> inline constexpr bool disable_sized_range = false;

struct view_base
{
};
template <class T> inline constexpr bool enable_view = derived_from<T, view_base>;
} // namespace ranges

namespace ranges::__access
{
template <class T>
concept MaybeBorrowed = is_lvalue_reference_v<T> || enable_borrowed_range<remove_cvref_t<T>>;

template <class T>
concept BoundedArray = is_bounded_array_v<remove_reference_t<T>>;
} // namespace ranges::__access

namespace ranges::__begin
{
void begin() = delete;

template <class T>
concept Member = requires(T& value) {
    { __detail::DecayCopy(value.begin()) } -> input_or_output_iterator;
};

template <class T>
concept Unqualified = !Member<T> && __swap::ClassOrEnum<remove_cvref_t<T>> && requires(T& value) {
    { __detail::DecayCopy(begin(value)) } -> input_or_output_iterator;
};

struct Begin
{
    template <class T>
        requires __access::MaybeBorrowed<T> && is_array_v<remove_reference_t<T>>
    constexpr auto operator()(T&& value) const noexcept
    {
        return value + 0;
    }

    template <class T>
        requires __access::MaybeBorrowed<T> && Member<T>
    constexpr auto operator()(T&& value) const
        noexcept(noexcept(__detail::DecayCopy(value.begin())))
    {
        return value.begin();
    }

    template <class T>
        requires __access::MaybeBorrowed<T> && Unqualified<T>
    constexpr auto operator()(T&& value) const noexcept(noexcept(__detail::DecayCopy(begin(value))))
    {
        return begin(value);
    }
};
} // namespace ranges::__begin

namespace ranges
{
inline namespace __cpo
{
inline constexpr __begin::Begin begin{};
} // namespace __cpo

template <class T> using iterator_t = decltype(ranges::begin(declval<T&>()));
} // namespace ranges

namespace ranges::__end
{
void end() = delete;

template <class T>
concept Member = requires(T& value) {
    typename iterator_t<T>;
    { __detail::DecayCopy(value.end()) } -> sentinel_for<iterator_t<T>>;
};

template <class T>
concept Unqualified = !Member<T> && __swap::ClassOrEnum<remove_cvref_t<T>> && requires(T& value) {
    typename iterator_t<T>;
    { __detail::DecayCopy(end(value)) } -> sentinel_for<iterator_t<T>>;
};

struct End
{
    template <class T>
        requires __access::MaybeBorrowed<T> && __access::BoundedArray<T>
    constexpr auto operator()(T&& value) const noexcept
    {
        return value + extent_v<remove_reference_t<T>>;
    }

    template <class T>
        requires __access::MaybeBorrowed<T> && Member<T>
    constexpr auto operator()(T&& value) const noexcept(noexcept(__detail::DecayCopy(value.end())))
    {
        return value.end();
    }

    template <class T>
        requires __access::MaybeBorrowed<T> && Unqualified<T>
    constexpr auto operator()(T&& value) const noexcept(noexcept(__detail::DecayCopy(end(value))))
    {
        return end(value);
    }
};
} // namespace ranges::__end

// Before C++23's constant iterators: the const view of the range's own iterators.
namespace ranges::__const_access
{
template <class T> constexpr auto&& AsConst(T& value) noexcept
{
    return static_cast<const T&>(value);
}
template <class T> constexpr auto&& AsConst(T&& value) noexcept
{
    return static_cast<const T&&>(value);
}

struct ConstBegin
{
    template <class T>
    constexpr auto operator()(T&& value) const
        noexcept(noexcept(__begin::Begin{}(AsConst(_FSTD::forward<T>(value)))))
            -> decltype(__begin::Begin{}(AsConst(_FSTD::forward<T>(value))))
    {
        return __begin::Begin{}(AsConst(_FSTD::forward<T>(value)));
    }
};

struct ConstEnd
{
    template <class T>
    constexpr auto operator()(T&& value) const
        noexcept(noexcept(__end::End{}(AsConst(_FSTD::forward<T>(value)))))
            -> decltype(__end::End{}(AsConst(_FSTD::forward<T>(value))))
    {
        return __end::End{}(AsConst(_FSTD::forward<T>(value)));
    }
};
} // namespace ranges::__const_access

namespace ranges
{
inline namespace __cpo
{
inline constexpr __end::End end{};
inline constexpr __const_access::ConstBegin cbegin{};
inline constexpr __const_access::ConstEnd cend{};
} // namespace __cpo

template <class T>
concept range = requires(T& value) {
    ranges::begin(value);
    ranges::end(value);
};

template <class T>
concept borrowed_range =
    range<T> && (is_lvalue_reference_v<T> || enable_borrowed_range<remove_cvref_t<T>>);

template <range R> using sentinel_t = decltype(ranges::end(declval<R&>()));
template <range R> using range_difference_t = iter_difference_t<iterator_t<R>>;
template <range R> using range_value_t = iter_value_t<iterator_t<R>>;
template <range R> using range_reference_t = iter_reference_t<iterator_t<R>>;
template <range R> using range_rvalue_reference_t = iter_rvalue_reference_t<iterator_t<R>>;
} // namespace ranges

namespace ranges::__size
{
void size() = delete;

template <class T>
concept Member = !disable_sized_range<remove_cvref_t<T>> && requires(T& value) {
    { __detail::DecayCopy(value.size()) } -> __detail::IntegerLike;
};

template <class T>
concept Unqualified = !Member<T> && !disable_sized_range<remove_cvref_t<T>> &&
                      __swap::ClassOrEnum<remove_cvref_t<T>> && requires(T& value) {
                          { __detail::DecayCopy(size(value)) } -> __detail::IntegerLike;
                      };

template <class T>
concept Difference =
    !__access::BoundedArray<T> && !Member<T> && !Unqualified<T> && requires(T& value) {
        { ranges::begin(value) } -> forward_iterator;
        { ranges::end(value) } -> sized_sentinel_for<decltype(ranges::begin(value))>;
    };

struct Size
{
    template <class T>
        requires __access::BoundedArray<T>
    constexpr size_t operator()(T&&) const noexcept
    {
        return extent_v<remove_reference_t<T>>;
    }

    template <class T>
        requires Member<T>
    constexpr auto operator()(T&& value) const noexcept(noexcept(__detail::DecayCopy(value.size())))
    {
        return value.size();
    }

    template <class T>
        requires Unqualified<T>
    constexpr auto operator()(T&& value) const noexcept(noexcept(__detail::DecayCopy(size(value))))
    {
        return size(value);
    }

    template <class T>
        requires Difference<T>
    constexpr auto operator()(T&& value) const
        noexcept(noexcept(ranges::end(value) - ranges::begin(value)))
    {
        return static_cast<make_unsigned_t<decltype(ranges::end(value) - ranges::begin(value))>>(
            ranges::end(value) - ranges::begin(value));
    }
};

struct SignedSize
{
    template <class T>
        requires requires(T&& value) { Size{}(value); }
    constexpr auto operator()(T&& value) const noexcept(noexcept(Size{}(value)))
    {
        using Unsigned = decltype(Size{}(value));
        using Signed = conditional_t<(sizeof(Unsigned) < sizeof(ptrdiff_t)), ptrdiff_t,
                                     make_signed_t<Unsigned>>;
        return static_cast<Signed>(Size{}(value));
    }
};
} // namespace ranges::__size

namespace ranges
{
inline namespace __cpo
{
inline constexpr __size::Size size{};
inline constexpr __size::SignedSize ssize{};
} // namespace __cpo

template <class T>
concept sized_range = range<T> && requires(T& value) { ranges::size(value); };

template <sized_range R> using range_size_t = decltype(ranges::size(declval<R&>()));
} // namespace ranges

namespace ranges::__empty
{
template <class T>
concept Member = requires(T& value) { bool(value.empty()); };

template <class T>
concept BySize = !Member<T> && requires(T& value) { ranges::size(value) == 0; };

template <class T>
concept ByIterators = !Member<T> && !BySize<T> && requires(T& value) {
    { ranges::begin(value) } -> forward_iterator;
    bool(ranges::begin(value) == ranges::end(value));
};

struct Empty
{
    template <Member T>
    constexpr bool operator()(T&& value) const noexcept(noexcept(bool(value.empty())))
    {
        return bool(value.empty());
    }

    template <BySize T>
    constexpr bool operator()(T&& value) const noexcept(noexcept(ranges::size(value) == 0))
    {
        return ranges::size(value) == 0;
    }

    template <ByIterators T>
    constexpr bool operator()(T&& value) const
        noexcept(noexcept(bool(ranges::begin(value) == ranges::end(value))))
    {
        return bool(ranges::begin(value) == ranges::end(value));
    }
};
} // namespace ranges::__empty

namespace ranges::__data
{
template <class T>
concept PointerToObject = is_pointer_v<T> && is_object_v<remove_pointer_t<T>>;

template <class T>
concept Member = __access::MaybeBorrowed<T> && requires(T& value) {
    { __detail::DecayCopy(value.data()) } -> PointerToObject;
};

template <class T>
concept FromBegin = __access::MaybeBorrowed<T> && !Member<T> && requires(T& value) {
    { ranges::begin(value) } -> contiguous_iterator;
};

struct Data
{
    template <Member T>
    constexpr auto operator()(T&& value) const noexcept(noexcept(__detail::DecayCopy(value.data())))
    {
        return value.data();
    }

    template <FromBegin T>
    constexpr auto operator()(T&& value) const noexcept(noexcept(ranges::begin(value)))
    {
        return _FSTD::to_address(ranges::begin(value));
    }
};

struct ConstData
{
    template <class T>
    constexpr auto operator()(T&& value) const
        noexcept(noexcept(Data{}(__const_access::AsConst(_FSTD::forward<T>(value)))))
            -> decltype(Data{}(__const_access::AsConst(_FSTD::forward<T>(value))))
    {
        return Data{}(__const_access::AsConst(_FSTD::forward<T>(value)));
    }
};
} // namespace ranges::__data

namespace ranges
{
inline namespace __cpo
{
inline constexpr __empty::Empty empty{};
inline constexpr __data::Data data{};
inline constexpr __data::ConstData cdata{};
} // namespace __cpo

template <class T>
concept input_range = range<T> && input_iterator<iterator_t<T>>;
template <class R, class T>
concept output_range = range<R> && output_iterator<iterator_t<R>, T>;
template <class T>
concept forward_range = input_range<T> && forward_iterator<iterator_t<T>>;
template <class T>
concept bidirectional_range = forward_range<T> && bidirectional_iterator<iterator_t<T>>;
template <class T>
concept random_access_range = bidirectional_range<T> && random_access_iterator<iterator_t<T>>;
template <class T>
concept contiguous_range =
    random_access_range<T> && contiguous_iterator<iterator_t<T>> && requires(T& value) {
        { ranges::data(value) } -> same_as<add_pointer_t<range_reference_t<T>>>;
    };
template <class T>
concept common_range = range<T> && same_as<iterator_t<T>, sentinel_t<T>>;

template <class T>
concept view = range<T> && movable<T> && enable_view<T>;
} // namespace ranges

struct from_range_t
{
    explicit from_range_t() = default;
};
inline constexpr from_range_t from_range{};

namespace __detail
{
template <class R, class T>
concept ContainerCompatibleRange =
    ranges::input_range<R> && convertible_to<ranges::range_reference_t<R>, T>;

// The length of a range that can tell it without being consumed.
template <class R>
    requires ranges::sized_range<R> || ranges::forward_range<R>
constexpr size_t RangeLength(R& range)
{
    if constexpr (ranges::sized_range<R>)
    {
        return static_cast<size_t>(ranges::size(range));
    }
    else
    {
        size_t length = 0;
        for (auto iterator = ranges::begin(range), end = ranges::end(range); iterator != end;
             ++iterator)
        {
            ++length;
        }
        return length;
    }
}
} // namespace __detail

