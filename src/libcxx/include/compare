namespace __detail
{
// Strongest first; the common category is the weakest of a list, and void if any is not one.
enum class ComparisonCategory : unsigned char
{
    Strong,
    Weak,
    Partial,
    None,
};

template <class T> constexpr ComparisonCategory CategoryOf()
{
    if constexpr (is_same_v<T, strong_ordering>)
    {
        return ComparisonCategory::Strong;
    }
    else if constexpr (is_same_v<T, weak_ordering>)
    {
        return ComparisonCategory::Weak;
    }
    else if constexpr (is_same_v<T, partial_ordering>)
    {
        return ComparisonCategory::Partial;
    }
    else
    {
        return ComparisonCategory::None;
    }
}

template <class... T> constexpr ComparisonCategory CommonCategory()
{
    ComparisonCategory common = ComparisonCategory::Strong;
    ((common = CategoryOf<T>() > common ? CategoryOf<T>() : common), ...);
    return common;
}

template <ComparisonCategory Category> struct CategoryType
{
    using type = void;
};
template <> struct CategoryType<ComparisonCategory::Strong>
{
    using type = strong_ordering;
};
template <> struct CategoryType<ComparisonCategory::Weak>
{
    using type = weak_ordering;
};
template <> struct CategoryType<ComparisonCategory::Partial>
{
    using type = partial_ordering;
};
} // namespace __detail

template <class... T> struct common_comparison_category
{
    using type = typename __detail::CategoryType<__detail::CommonCategory<T...>()>::type;
};
template <class... T>
using common_comparison_category_t = typename common_comparison_category<T...>::type;

namespace __detail
{
template <class T, class Category>
concept ComparesAs = same_as<common_comparison_category_t<T, Category>, Category>;
} // namespace __detail

template <class T, class Category = partial_ordering>
concept three_way_comparable =
    __detail::WeaklyEqualityComparableWith<T, T> && __detail::PartiallyOrderedWith<T, T> &&
    requires(const remove_reference_t<T>& left, const remove_reference_t<T>& right) {
        { left <=> right } -> __detail::ComparesAs<Category>;
    };

template <class T, class U, class Category = partial_ordering>
concept three_way_comparable_with =
    three_way_comparable<T, Category> && three_way_comparable<U, Category> &&
    __detail::ComparisonCommonTypeWith<T, U> &&
    three_way_comparable<
        common_reference_t<const remove_reference_t<T>&, const remove_reference_t<U>&>, Category> &&
    __detail::WeaklyEqualityComparableWith<T, U> && __detail::PartiallyOrderedWith<T, U> &&
    requires(const remove_reference_t<T>& left, const remove_reference_t<U>& right) {
        { left <=> right } -> __detail::ComparesAs<Category>;
        { right <=> left } -> __detail::ComparesAs<Category>;
    };

template <class T, class U = T> struct compare_three_way_result
{
};
template <class T, class U>
    requires requires(const remove_reference_t<T>& left, const remove_reference_t<U>& right) {
        left <=> right;
    }
struct compare_three_way_result<T, U>
{
    using type = decltype(declval<const remove_reference_t<T>&>() <=>
                          declval<const remove_reference_t<U>&>());
};
template <class T, class U = T>
using compare_three_way_result_t = typename compare_three_way_result<T, U>::type;

struct compare_three_way
{
    template <class T, class U>
        requires three_way_comparable_with<T, U>
    constexpr auto operator()(T&& left, U&& right) const
    {
        return _FSTD::forward<T>(left) <=> _FSTD::forward<U>(right);
    }

    using is_transparent = void;
};

namespace __detail
{
// The synth-three-way of [expos.only.entity], which pair and the containers compare with: <=>
// where it exists, otherwise a weak ordering from <.
struct SynthThreeWay
{
    template <class T, class U>
    constexpr auto operator()(const T& left, const U& right) const
        requires requires {
            { left < right } -> BooleanTestable;
            { right < left } -> BooleanTestable;
        }
    {
        if constexpr (three_way_comparable_with<T, U>)
        {
            return left <=> right;
        }
        else
        {
            if (left < right)
            {
                return weak_ordering::less;
            }
            if (right < left)
            {
                return weak_ordering::greater;
            }
            return weak_ordering::equivalent;
        }
    }
};
inline constexpr SynthThreeWay synth_three_way{};

template <class T, class U = T>
using SynthThreeWayResult = decltype(synth_three_way(declval<T&>(), declval<U&>()));
} // namespace __detail

