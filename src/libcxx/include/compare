// The values the ordering types hold. Unordered is 2 rather than negative, so that "<= 0" is a
// single comparison.
enum class Order : signed char
{
    Less = -1,
    Equivalent = 0,
    Greater = 1,
    Unordered = 2,
};

// The parameter type of comparisons with a literal 0: consteval accepts only a constant null
// pointer, which 0 converts to.
struct ZeroLiteral
{
    consteval ZeroLiteral(ZeroLiteral*) noexcept {}
};
} // namespace __detail

// The compiler names these as the results of the built-in <=>. Each holds an Order; the named
// values are defined after the classes, which are incomplete inside their own bodies.
class partial_ordering
{
public:
    static const partial_ordering less;
    static const partial_ordering equivalent;
    static const partial_ordering greater;
    static const partial_ordering unordered;

    friend constexpr bool operator==(partial_ordering, partial_ordering) noexcept = default;
    friend constexpr bool operator==(partial_ordering value, __detail::ZeroLiteral) noexcept
    {
        return value.m_order == __detail::Order::Equivalent;
    }
    friend constexpr bool operator<(partial_ordering value, __detail::ZeroLiteral) noexcept
    {
        return value.m_order == __detail::Order::Less;
    }
    friend constexpr bool operator>(partial_ordering value, __detail::ZeroLiteral) noexcept
    {
        return value.m_order == __detail::Order::Greater;
    }
    friend constexpr bool operator<=(partial_ordering value, __detail::ZeroLiteral) noexcept
    {
        return static_cast<signed char>(value.m_order) <= 0;
    }
    friend constexpr bool operator>=(partial_ordering value, __detail::ZeroLiteral) noexcept
    {
        return value.m_order == __detail::Order::Equivalent ||
               value.m_order == __detail::Order::Greater;
    }
    friend constexpr bool operator<(__detail::ZeroLiteral, partial_ordering value) noexcept
    {
        return value.m_order == __detail::Order::Greater;
    }
    friend constexpr bool operator>(__detail::ZeroLiteral, partial_ordering value) noexcept
    {
        return value.m_order == __detail::Order::Less;
    }
    friend constexpr bool operator<=(__detail::ZeroLiteral, partial_ordering value) noexcept
    {
        return value >= 0;
    }
    friend constexpr bool operator>=(__detail::ZeroLiteral, partial_ordering value) noexcept
    {
        return value <= 0;
    }
    friend constexpr partial_ordering operator<=>(partial_ordering value,
                                                  __detail::ZeroLiteral) noexcept
    {
        return value;
    }
    friend constexpr partial_ordering operator<=>(__detail::ZeroLiteral,
                                                  partial_ordering value) noexcept
    {
        if (value.m_order == __detail::Order::Unordered)
        {
            return value;
        }
        return partial_ordering(
            static_cast<__detail::Order>(-static_cast<signed char>(value.m_order)));
    }

private:
    friend class weak_ordering;
    friend class strong_ordering;

    constexpr explicit partial_ordering(__detail::Order order) noexcept : m_order(order) {}

    __detail::Order m_order;
};

inline constexpr partial_ordering partial_ordering::less(__detail::Order::Less);
inline constexpr partial_ordering partial_ordering::equivalent(__detail::Order::Equivalent);
inline constexpr partial_ordering partial_ordering::greater(__detail::Order::Greater);
inline constexpr partial_ordering partial_ordering::unordered(__detail::Order::Unordered);

class weak_ordering
{
public:
    static const weak_ordering less;
    static const weak_ordering equivalent;
    static const weak_ordering greater;

    constexpr operator partial_ordering() const noexcept
    {
        return partial_ordering(m_order);
    }

    friend constexpr bool operator==(weak_ordering, weak_ordering) noexcept = default;
    friend constexpr bool operator==(weak_ordering value, __detail::ZeroLiteral) noexcept
    {
        return value.m_order == __detail::Order::Equivalent;
    }
    friend constexpr bool operator<(weak_ordering value, __detail::ZeroLiteral) noexcept
    {
        return static_cast<signed char>(value.m_order) < 0;
    }
    friend constexpr bool operator>(weak_ordering value, __detail::ZeroLiteral) noexcept
    {
        return static_cast<signed char>(value.m_order) > 0;
    }
    friend constexpr bool operator<=(weak_ordering value, __detail::ZeroLiteral) noexcept
    {
        return static_cast<signed char>(value.m_order) <= 0;
    }
    friend constexpr bool operator>=(weak_ordering value, __detail::ZeroLiteral) noexcept
    {
        return static_cast<signed char>(value.m_order) >= 0;
    }
    friend constexpr bool operator<(__detail::ZeroLiteral, weak_ordering value) noexcept
    {
        return static_cast<signed char>(value.m_order) > 0;
    }
    friend constexpr bool operator>(__detail::ZeroLiteral, weak_ordering value) noexcept
    {
        return static_cast<signed char>(value.m_order) < 0;
    }
    friend constexpr bool operator<=(__detail::ZeroLiteral, weak_ordering value) noexcept
    {
        return static_cast<signed char>(value.m_order) >= 0;
    }
    friend constexpr bool operator>=(__detail::ZeroLiteral, weak_ordering value) noexcept
    {
        return static_cast<signed char>(value.m_order) <= 0;
    }
    friend constexpr weak_ordering operator<=>(weak_ordering value, __detail::ZeroLiteral) noexcept
    {
        return value;
    }
    friend constexpr weak_ordering operator<=>(__detail::ZeroLiteral, weak_ordering value) noexcept
    {
        return weak_ordering(
            static_cast<__detail::Order>(-static_cast<signed char>(value.m_order)));
    }

private:
    friend class strong_ordering;

    constexpr explicit weak_ordering(__detail::Order order) noexcept : m_order(order) {}

    __detail::Order m_order;
};

inline constexpr weak_ordering weak_ordering::less(__detail::Order::Less);
