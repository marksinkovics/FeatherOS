constexpr bool is_eq(partial_ordering order) noexcept
{
    return order == 0;
}

constexpr bool is_neq(partial_ordering order) noexcept
{
    return order != 0;
}

constexpr bool is_lt(partial_ordering order) noexcept
{
    return order < 0;
}

