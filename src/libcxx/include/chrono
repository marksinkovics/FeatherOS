                           const duration<Rep2, Period2>& right)
{
    using Common = common_type_t<duration<Rep1, Period1>, duration<Rep2, Period2>>;
    return Common(left).count() <=> Common(right).count();
}

template <class ToDuration, class Rep, class Period>
    requires __detail::IsDuration<ToDuration>
constexpr ToDuration floor(const duration<Rep, Period>& from)
{
    ToDuration result = chrono::duration_cast<ToDuration>(from);
    if (result > from)
    {
        --result;
    }
    return result;
}

template <class ToDuration, class Rep, class Period>
    requires __detail::IsDuration<ToDuration>
constexpr ToDuration ceil(const duration<Rep, Period>& from)
{
    ToDuration result = chrono::duration_cast<ToDuration>(from);
    if (result < from)
    {
        ++result;
    }
    return result;
}

// Halfway rounds to even, as the standard asks.
template <class ToDuration, class Rep, class Period>
    requires __detail::IsDuration<ToDuration> &&
             (!treat_as_floating_point_v<typename ToDuration::rep>)
constexpr ToDuration round(const duration<Rep, Period>& from)
{
    const ToDuration lower = chrono::floor<ToDuration>(from);
    const ToDuration upper = lower + ToDuration(1);
    const auto below = from - lower;
    const auto above = upper - from;
    if (below < above)
    {
        return lower;
    }
    if (above < below)
    {
        return upper;
    }
    return lower.count() % 2 == 0 ? lower : upper;
}

template <class Rep, class Period>
    requires numeric_limits<Rep>::is_signed
constexpr duration<Rep, Period> abs(duration<Rep, Period> value)
{
    return value >= duration<Rep, Period>::zero() ? +value : -value;
}

