operator-(const duration<Rep1, Period1>& left, const duration<Rep2, Period2>& right)
{
    using Common = common_type_t<duration<Rep1, Period1>, duration<Rep2, Period2>>;
    return Common(Common(left).count() - Common(right).count());
}

