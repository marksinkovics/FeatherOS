// The digits hh_mm_ss shows below a second: the fewest, up to 18, that represent Period exactly,
// otherwise 6.
template <class Period> consteval unsigned FractionalWidth()
{
    intmax_t power = 1;
    for (unsigned width = 0; width <= 18; ++width)
    {
        if (power % Period::den == 0)
        {
            return width;
        }
        if (width != 18)
        {
            power *= 10;
        }
    }
    return 6;
}

consteval intmax_t PowerOfTen(unsigned exponent)
{
    intmax_t power = 1;
    for (unsigned index = 0; index != exponent; ++index)
    {
        power *= 10;
    }
    return power;
}
} // namespace __detail

