template <class Clock, class Duration = typename Clock::duration> class time_point
{
    static_assert(__detail::IsDuration<Duration>, "a time point's duration must be a duration");

public:
    using clock = Clock;
    using duration = Duration;
    using rep = typename duration::rep;
    using period = typename duration::period;

    constexpr time_point() : m_duration(duration::zero()) {}
    constexpr explicit time_point(const duration& since_epoch) : m_duration(since_epoch) {}
    template <class Duration2>
        requires is_convertible_v<Duration2, duration>
    constexpr time_point(const time_point<clock, Duration2>& other)
        : m_duration(other.time_since_epoch())
    {
    }

    constexpr duration time_since_epoch() const
    {
        return m_duration;
    }

    constexpr time_point& operator++()
    {
        ++m_duration;
        return *this;
    }
    constexpr time_point operator++(int)
    {
        return time_point(m_duration++);
    }
    constexpr time_point& operator--()
    {
        --m_duration;
        return *this;
    }
    constexpr time_point operator--(int)
    {
        return time_point(m_duration--);
    }
    constexpr time_point& operator+=(const duration& offset)
    {
        m_duration += offset;
        return *this;
    }
    constexpr time_point& operator-=(const duration& offset)
    {
        m_duration -= offset;
        return *this;
    }

    static constexpr time_point min() noexcept
    {
        return time_point(duration::min());
    }
    static constexpr time_point max() noexcept
    {
        return time_point(duration::max());
    }

private:
    duration m_duration;
};

