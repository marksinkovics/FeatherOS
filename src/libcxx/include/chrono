template <class T> struct is_clock : bool_constant < requires
{
    typename T::rep;
    typename T::period;
    typename T::duration;
    typename T::time_point;
    T::is_steady;
    T::now();
}>{};
template <class T> inline constexpr bool is_clock_v = is_clock<T>::value;

// CLOCK_REALTIME, which moves when the time is set.
struct system_clock
{
    using rep = int64_t;
    using period = nano;
    using duration = chrono::duration<rep, period>;
    using time_point = chrono::time_point<system_clock>;
    static constexpr bool is_steady = false;

    static time_point now() noexcept;
#ifdef FEATHEROS_CHRONO_HAS_TIME_T
    static time_t to_time_t(const time_point& point) noexcept
    {
        return static_cast<time_t>(
            chrono::duration_cast<seconds>(point.time_since_epoch()).count());
    }
    static time_point from_time_t(time_t seconds_since_epoch) noexcept
    {
        return time_point(seconds(seconds_since_epoch));
    }
#endif
};

template <class Duration> using sys_time = time_point<system_clock, Duration>;
using sys_seconds = sys_time<seconds>;
using sys_days = sys_time<days>;

// CLOCK_MONOTONIC, which counts milliseconds since the kernel's timer started.
struct steady_clock
{
    using rep = int64_t;
    using period = nano;
    using duration = chrono::duration<rep, period>;
    using time_point = chrono::time_point<steady_clock>;
    static constexpr bool is_steady = true;

    static time_point now() noexcept;
};

using high_resolution_clock = steady_clock;

class day
{
public:
    day() = default;
    constexpr explicit day(unsigned value) noexcept : m_value(static_cast<unsigned char>(value)) {}

    constexpr day& operator++() noexcept
    {
        ++m_value;
        return *this;
    }
    constexpr day operator++(int) noexcept
    {
        const day old = *this;
        ++m_value;
        return old;
    }
    constexpr day& operator--() noexcept
    {
        --m_value;
        return *this;
    }
    constexpr day operator--(int) noexcept
    {
        const day old = *this;
        --m_value;
        return old;
    }
    constexpr day& operator+=(const days& offset) noexcept
    {
        *this = day(static_cast<unsigned>(static_cast<int>(m_value) + offset.count()));
        return *this;
    }
    constexpr day& operator-=(const days& offset) noexcept
    {
        *this = day(static_cast<unsigned>(static_cast<int>(m_value) - offset.count()));
        return *this;
    }

    constexpr explicit operator unsigned() const noexcept
    {
        return m_value;
    }
    constexpr bool ok() const noexcept
    {
        return m_value >= 1 && m_value <= 31;
    }

    friend constexpr bool operator==(const day&, const day&) noexcept = default;
    friend constexpr strong_ordering operator<=>(const day&, const day&) noexcept = default;

private:
    unsigned char m_value;
};

constexpr day operator+(const day& start, const days& offset) noexcept
{
    return day(static_cast<unsigned>(static_cast<int>(unsigned(start)) + offset.count()));
}
constexpr day operator+(const days& offset, const day& start) noexcept
{
    return start + offset;
}
constexpr day operator-(const day& start, const days& offset) noexcept
{
    return start + -offset;
}
constexpr days operator-(const day& left, const day& right) noexcept
{
    return days(static_cast<int>(unsigned(left)) - static_cast<int>(unsigned(right)));
}

class month
{
public:
    month() = default;
    constexpr explicit month(unsigned value) noexcept : m_value(static_cast<unsigned char>(value))
    {
    }

    constexpr month& operator++() noexcept
    {
        return *this += months(1);
    }
    constexpr month operator++(int) noexcept
    {
        const month old = *this;
        ++*this;
        return old;
    }
    constexpr month& operator--() noexcept
    {
        return *this -= months(1);
    }
    constexpr month operator--(int) noexcept
    {
        const month old = *this;
        --*this;
        return old;
    }
    constexpr month& operator+=(const months& offset) noexcept;
    constexpr month& operator-=(const months& offset) noexcept;

    constexpr explicit operator unsigned() const noexcept
    {
        return m_value;
    }
    constexpr bool ok() const noexcept
    {
        return m_value >= 1 && m_value <= 12;
    }

    friend constexpr bool operator==(const month&, const month&) noexcept = default;
    friend constexpr strong_ordering operator<=>(const month&, const month&) noexcept = default;

private:
    unsigned char m_value;
};

// Months wrap around the year: December + 1 is January.
constexpr month operator+(const month& start, const months& offset) noexcept
{
    const long long zero_based = static_cast<long long>(unsigned(start)) - 1 + offset.count();
    const long long wrapped = (zero_based % 12 + 12) % 12;
    return month(static_cast<unsigned>(wrapped + 1));
}
constexpr month operator+(const months& offset, const month& start) noexcept
{
    return start + offset;
}
constexpr month operator-(const month& start, const months& offset) noexcept
{
    return start + -offset;
}
constexpr months operator-(const month& left, const month& right) noexcept
{
    const int difference = static_cast<int>(unsigned(left)) - static_cast<int>(unsigned(right));
    return months(difference < 0 ? difference + 12 : difference);
}

constexpr month& month::operator+=(const months& offset) noexcept
{
    *this = *this + offset;
    return *this;
}
constexpr month& month::operator-=(const months& offset) noexcept
{
    *this = *this - offset;
    return *this;
}

class year
{
public:
    year() = default;
    constexpr explicit year(int value) noexcept : m_value(static_cast<short>(value)) {}

    constexpr year& operator++() noexcept
    {
        ++m_value;
