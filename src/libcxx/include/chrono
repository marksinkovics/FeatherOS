class weekday
{
public:
    weekday() = default;
    // 7 is Sunday too, as in ISO 8601.
    constexpr explicit weekday(unsigned value) noexcept
        : m_value(static_cast<unsigned char>(value == 7 ? 0 : value))
    {
    }
    constexpr weekday(const sys_days& point) noexcept
        : m_value(static_cast<unsigned char>(Sunday0(point.time_since_epoch().count())))
    {
    }

    constexpr weekday& operator++() noexcept
    {
        return *this += days(1);
    }
    constexpr weekday operator++(int) noexcept
    {
        const weekday old = *this;
        ++*this;
        return old;
    }
    constexpr weekday& operator--() noexcept
    {
        return *this -= days(1);
    }
    constexpr weekday operator--(int) noexcept
    {
        const weekday old = *this;
        --*this;
        return old;
    }
    constexpr weekday& operator+=(const days& offset) noexcept;
    constexpr weekday& operator-=(const days& offset) noexcept;

    constexpr unsigned c_encoding() const noexcept
    {
        return m_value;
    }
    constexpr unsigned iso_encoding() const noexcept
    {
        return m_value == 0 ? 7 : m_value;
    }
    constexpr bool ok() const noexcept
    {
        return m_value <= 6;
    }

    friend constexpr bool operator==(const weekday&, const weekday&) noexcept = default;

private:
    // 1970-01-01 was a Thursday.
    static constexpr unsigned Sunday0(long long day_count) noexcept
    {
        return static_cast<unsigned>(((day_count + 4) % 7 + 7) % 7);
    }

    unsigned char m_value;
};

constexpr weekday operator+(const weekday& start, const days& offset) noexcept
{
    const long long shifted = static_cast<long long>(start.c_encoding()) + offset.count();
    return weekday(static_cast<unsigned>((shifted % 7 + 7) % 7));
}
constexpr weekday operator+(const days& offset, const weekday& start) noexcept
{
