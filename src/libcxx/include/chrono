template <class Rep, class Period = ratio<1>> class duration;

template <class Rep> struct treat_as_floating_point : is_floating_point<Rep>
{
};
template <class Rep>
inline constexpr bool treat_as_floating_point_v = treat_as_floating_point<Rep>::value;

template <class Rep> struct duration_values
{
    static constexpr Rep zero() noexcept
    {
        return Rep(0);
    }
    static constexpr Rep min() noexcept
    {
        return numeric_limits<Rep>::lowest();
    }
    static constexpr Rep max() noexcept
    {
        return numeric_limits<Rep>::max();
    }
};

} // namespace chrono

namespace __detail
{
template <class T> inline constexpr bool IsDuration = false;
template <class Rep, class Period>
inline constexpr bool IsDuration<chrono::duration<Rep, Period>> = true;

consteval intmax_t ChronoGcd(intmax_t left, intmax_t right)
{
    while (right != 0)
    {
        const intmax_t rest = left % right;
        left = right;
        right = rest;
    }
    return left;
}
} // namespace __detail

template <class Rep1, class Period1, class Rep2, class Period2>
struct common_type<chrono::duration<Rep1, Period1>, chrono::duration<Rep2, Period2>>
{
    using type = chrono::duration<
        common_type_t<Rep1, Rep2>,
        ratio<__detail::ChronoGcd(Period1::num, Period2::num),
              Period1::den / __detail::ChronoGcd(Period1::den, Period2::den) * Period2::den>>;
};

namespace chrono
{

template <class ToDuration, class Rep, class Period>
    requires __detail::IsDuration<ToDuration>
constexpr ToDuration duration_cast(const duration<Rep, Period>& from)
{
    using Factor = ratio_divide<Period, typename ToDuration::period>;
    using ToRep = typename ToDuration::rep;
    using Wide = common_type_t<ToRep, Rep, intmax_t>;
    if constexpr (Factor::num == 1 && Factor::den == 1)
    {
        return ToDuration(static_cast<ToRep>(from.count()));
    }
    else if constexpr (Factor::den == 1)
    {
        return ToDuration(
            static_cast<ToRep>(static_cast<Wide>(from.count()) * static_cast<Wide>(Factor::num)));
    }
    else if constexpr (Factor::num == 1)
    {
        return ToDuration(
            static_cast<ToRep>(static_cast<Wide>(from.count()) / static_cast<Wide>(Factor::den)));
    }
    else
    {
        return ToDuration(
            static_cast<ToRep>(static_cast<Wide>(from.count()) * static_cast<Wide>(Factor::num) /
                               static_cast<Wide>(Factor::den)));
    }
}

template <class Rep, class Period> class duration
{
    static_assert(!__detail::IsDuration<Rep>, "a duration's representation cannot be a duration");
    static_assert(__detail::IsRatio<Period>, "a duration's period must be a ratio");
    static_assert(Period::num > 0, "a duration's period must be positive");

public:
    using rep = Rep;
    using period = typename Period::type;

    constexpr duration() = default;
    duration(const duration&) = default;
    duration& operator=(const duration&) = default;
    ~duration() = default;

    template <class Rep2>
        requires is_convertible_v<const Rep2&, rep> &&
                 (treat_as_floating_point_v<rep> || !treat_as_floating_point_v<Rep2>)
    constexpr explicit duration(const Rep2& count) : m_count(static_cast<rep>(count))
    {
    }

    template <class Rep2, class Period2>
        requires is_convertible_v<const Rep2&, rep> &&
                 (treat_as_floating_point_v<rep> ||
                  (ratio_divide<Period2, period>::den == 1 && !treat_as_floating_point_v<Rep2>))
    constexpr duration(const duration<Rep2, Period2>& other)
        : m_count(chrono::duration_cast<duration>(other).count())
    {
    }

    constexpr rep count() const
    {
        return m_count;
    }

    constexpr common_type_t<duration> operator+() const
    {
        return common_type_t<duration>(*this);
    }
    constexpr common_type_t<duration> operator-() const
    {
        return common_type_t<duration>(-m_count);
    }
    constexpr duration& operator++()
    {
        ++m_count;
        return *this;
    }
    constexpr duration operator++(int)
    {
        return duration(m_count++);
    }
    constexpr duration& operator--()
    {
        --m_count;
        return *this;
    }
    constexpr duration operator--(int)
    {
        return duration(m_count--);
    }
    constexpr duration& operator+=(const duration& other)
    {
        m_count += other.count();
        return *this;
    }
    constexpr duration& operator-=(const duration& other)
    {
        m_count -= other.count();
        return *this;
    }
    constexpr duration& operator*=(const rep& factor)
    {
        m_count *= factor;
        return *this;
    }
    constexpr duration& operator/=(const rep& divisor)
    {
        m_count /= divisor;
        return *this;
    }
    constexpr duration& operator%=(const rep& divisor)
    {
        m_count %= divisor;
        return *this;
    }
    constexpr duration& operator%=(const duration& divisor)
    {
        m_count %= divisor.count();
        return *this;
    }

    static constexpr duration zero() noexcept
    {
        return duration(duration_values<rep>::zero());
    }
    static constexpr duration min() noexcept
    {
        return duration(duration_values<rep>::min());
    }
    static constexpr duration max() noexcept
    {
        return duration(duration_values<rep>::max());
    }

private:
    rep m_count;
};

template <class Rep1, class Period1, class Rep2, class Period2>
constexpr common_type_t<duration<Rep1, Period1>, duration<Rep2, Period2>>
operator+(const duration<Rep1, Period1>& left, const duration<Rep2, Period2>& right)
{
    using Common = common_type_t<duration<Rep1, Period1>, duration<Rep2, Period2>>;
    return Common(Common(left).count() + Common(right).count());
}

