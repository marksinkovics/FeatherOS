struct atomic_flag
{
public:
    constexpr atomic_flag() noexcept = default;
    atomic_flag(const atomic_flag&) = delete;
    atomic_flag& operator=(const atomic_flag&) = delete;
    ~atomic_flag() = default;

    bool test(memory_order order = memory_order::seq_cst) const noexcept
    {
        return __atomic_load_n(&m_value, __detail::AtomicOrder(order)) != 0;
    }
    bool test_and_set(memory_order order = memory_order::seq_cst) noexcept
    {
        return __atomic_test_and_set(&m_value, __detail::AtomicOrder(order));
    }
    void clear(memory_order order = memory_order::seq_cst) noexcept
    {
        __atomic_clear(&m_value, __detail::AtomicOrder(order));
    }
    void wait(bool old, memory_order order = memory_order::seq_cst) const noexcept
    {
        __detail::AtomicWaitUntil(&m_value,
                                  [this, old, order]() noexcept { return test(order) != old; });
    }
    void notify_one() noexcept
    {
        __detail::AtomicNotify(&m_value);
    }
    void notify_all() noexcept
    {
        __detail::AtomicNotify(&m_value);
    }

private:
    unsigned char m_value = 0;
};

