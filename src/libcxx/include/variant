// Without exceptions there is no bad_variant_access: get with the wrong alternative calls the
// library's abort hook. Nothing can fail between destroying the old alternative and
// constructing the new one, so a variant is never valueless_by_exception.

namespace FEATHEROS_STD_NAMESPACE
{

template <class... Types> class variant;

template <class T> struct variant_size;
template <class T> struct variant_size<const T> : variant_size<T>
{
};
template <class... Types>
struct variant_size<variant<Types...>> : integral_constant<size_t, sizeof...(Types)>
{
};
template <class T> inline constexpr size_t variant_size_v = variant_size<T>::value;

template <size_t Index, class T> struct variant_alternative;
template <size_t Index, class T> struct variant_alternative<Index, const T>
{
    using type = add_const_t<typename variant_alternative<Index, T>::type>;
};
template <size_t Index, class... Types> struct variant_alternative<Index, variant<Types...>>
{
    static_assert(Index < sizeof...(Types), "variant index out of bounds");
    using type = __detail::PackElement<Index, Types...>;
};
template <size_t Index, class T>
using variant_alternative_t = typename variant_alternative<Index, T>::type;

inline constexpr size_t variant_npos = static_cast<size_t>(-1);

struct monostate
{
};
constexpr bool operator==(monostate, monostate) noexcept
{
    return true;
}
constexpr strong_ordering operator<=>(monostate, monostate) noexcept
{
    return strong_ordering::equal;
}

namespace __detail
{
struct VariantEmpty
{
    explicit VariantEmpty() = default;
};

// The alternatives, as a union nested one level per alternative. Each level is constructed
// whole with in_place_index, which keeps constant evaluation happy about the active member.
template <class... Types> union VariantUnion
{
    constexpr explicit VariantUnion(VariantEmpty) noexcept {}
};

template <class First, class... Rest> union VariantUnion<First, Rest...>
{
    char __empty;
    First __first;
    VariantUnion<Rest...> __rest;

    constexpr explicit VariantUnion(VariantEmpty) noexcept : __empty() {}

    template <class... Args>
    constexpr explicit VariantUnion(in_place_index_t<0>, Args&&... args)
        : __first(_FSTD::forward<Args>(args)...)
    {
    }

    template <size_t Index, class... Args>
    constexpr explicit VariantUnion(in_place_index_t<Index>, Args&&... args)
        : __rest(in_place_index<Index - 1>, _FSTD::forward<Args>(args)...)
    {
    }

    VariantUnion(const VariantUnion&) = default;
    VariantUnion(VariantUnion&&) = default;
    VariantUnion& operator=(const VariantUnion&) = default;
    VariantUnion& operator=(VariantUnion&&) = default;

    constexpr ~VariantUnion()
        requires is_trivially_destructible_v<First> && (is_trivially_destructible_v<Rest> && ...)
    = default;
    constexpr ~VariantUnion() {}
};

template <size_t Index, class Union> constexpr auto&& UnionGet(Union&& storage) noexcept
{
    if constexpr (Index == 0)
    {
        return _FSTD::forward<Union>(storage).__first;
    }
    else
    {
        return __detail::UnionGet<Index - 1>(_FSTD::forward<Union>(storage).__rest);
    }
}

template <size_t Count>
using VariantIndex = conditional_t<(Count < 255), unsigned char, unsigned short>;

// Calls function(integral_constant<size_t, I>{}) for the I that index names, through a table
// built at compile time.
template <class Result, class F, size_t Index> constexpr Result DispatchAt(F&& function)
{
    return _FSTD::forward<F>(function)(integral_constant<size_t, Index>{});
}

template <class Result, class F, class Indices> struct DispatchTable;
template <class Result, class F, size_t... Index>
struct DispatchTable<Result, F, index_sequence<Index...>>
{
    static constexpr Result (*entries[])(F&&) = {&DispatchAt<Result, F, Index>...};
};

template <size_t Count, class Result, class F> constexpr Result Dispatch(size_t index, F&& function)
{
    return DispatchTable<Result, F, make_index_sequence<Count>>::entries[index](
        _FSTD::forward<F>(function));
}

// FUN of the converting constructor: one overload per alternative that T converts to without
// narrowing, so overload resolution picks the alternative.
template <class T> void NarrowingCheck(T (&&)[1]);

template <size_t Index, class Alternative> struct VariantOverload
{
    template <class T>
        requires requires { NarrowingCheck<Alternative>({declval<T>()}); }
    auto operator()(Alternative, T&&) const -> integral_constant<size_t, Index>;
};

template <class Indices, class... Types> struct VariantOverloads;
template <size_t... Index, class... Types>
struct VariantOverloads<index_sequence<Index...>, Types...> : VariantOverload<Index, Types>...
{
    using VariantOverload<Index, Types>::operator()...;
};

template <class T, class... Types>
using VariantAcceptedIndex = decltype(VariantOverloads<index_sequence_for<Types...>, Types...>{}(
    declval<T>(), declval<T>()));

template <class T> inline constexpr bool IsInPlaceTag = false;
template <class T> inline constexpr bool IsInPlaceTag<in_place_type_t<T>> = true;
template <size_t Index> inline constexpr bool IsInPlaceTag<in_place_index_t<Index>> = true;

template <class T> inline constexpr bool IsVariant = false;
template <class... Types> inline constexpr bool IsVariant<variant<Types...>> = true;
} // namespace __detail

template <class... Types> class variant
{
    static_assert(sizeof...(Types) > 0, "variant needs at least one alternative");
    static_assert(((is_object_v<Types> && !is_array_v<Types>) && ...),
                  "variant's alternatives must be object types other than arrays");

    using IndexType = __detail::VariantIndex<sizeof...(Types)>;
    static constexpr IndexType EmptyIndex = static_cast<IndexType>(-1);

    template <size_t Index> using Alternative = __detail::PackElement<Index, Types...>;
    template <class T> static constexpr size_t IndexOf = __detail::PackIndex<T, Types...>();
    template <class T> static constexpr bool OccursOnce = __detail::PackCount<T, Types...> == 1;

public:
    __detail::VariantUnion<Types...> __storage;
    IndexType __index;

    constexpr variant() noexcept(is_nothrow_default_constructible_v<Alternative<0>>)
        requires is_default_constructible_v<Alternative<0>>
        : __storage(in_place_index<0>), __index(0)
    {
    }

    constexpr variant(const variant&)
        requires(is_trivially_copy_constructible_v<Types> && ...)
    = default;
    constexpr variant(const variant& other)
        requires(is_copy_constructible_v<Types> && ...) &&
                    (!(is_trivially_copy_constructible_v<Types> && ...))
        : __storage(__detail::VariantEmpty{}), __index(EmptyIndex)
    {
        ConstructFrom(other);
    }

    constexpr variant(variant&&)
        requires(is_trivially_move_constructible_v<Types> && ...)
    = default;
    constexpr variant(variant&& other) noexcept((is_nothrow_move_constructible_v<Types> && ...))
        requires(is_move_constructible_v<Types> && ...) &&
                    (!(is_trivially_move_constructible_v<Types> && ...))
        : __storage(__detail::VariantEmpty{}), __index(EmptyIndex)
    {
        ConstructFrom(_FSTD::move(other));
    }

    template <class T, size_t Index = __detail::VariantAcceptedIndex<T, Types...>::value>
        requires(!is_same_v<remove_cvref_t<T>, variant>) &&
                    (!__detail::IsInPlaceTag<remove_cvref_t<T>>) &&
                    is_constructible_v<Alternative<Index>, T>
    constexpr variant(T&& value) noexcept(is_nothrow_constructible_v<Alternative<Index>, T>)
        : __storage(in_place_index<Index>, _FSTD::forward<T>(value)), __index(Index)
    {
    }

    template <class T, class... Args>
        requires OccursOnce<T> && is_constructible_v<T, Args...>
    constexpr explicit variant(in_place_type_t<T>, Args&&... args)
        : __storage(in_place_index<IndexOf<T>>, _FSTD::forward<Args>(args)...), __index(IndexOf<T>)
    {
    }

    template <class T, class U, class... Args>
        requires OccursOnce<T> && is_constructible_v<T, initializer_list<U>&, Args...>
    constexpr explicit variant(in_place_type_t<T>, initializer_list<U> list, Args&&... args)
        : __storage(in_place_index<IndexOf<T>>, list, _FSTD::forward<Args>(args)...),
          __index(IndexOf<T>)
    {
    }

    template <size_t Index, class... Args>
        requires(Index < sizeof...(Types)) && is_constructible_v<Alternative<Index>, Args...>
    constexpr explicit variant(in_place_index_t<Index>, Args&&... args)
        : __storage(in_place_index<Index>, _FSTD::forward<Args>(args)...), __index(Index)
    {
    }

    template <size_t Index, class U, class... Args>
        requires(Index < sizeof...(Types)) &&
                    is_constructible_v<Alternative<Index>, initializer_list<U>&, Args...>
    constexpr explicit variant(in_place_index_t<Index>, initializer_list<U> list, Args&&... args)
        : __storage(in_place_index<Index>, list, _FSTD::forward<Args>(args)...), __index(Index)
    {
    }

    constexpr ~variant()
        requires(is_trivially_destructible_v<Types> && ...)
    = default;
    constexpr ~variant()
    {
        Destroy();
    }

    constexpr variant& operator=(const variant&)
        requires((is_trivially_copy_constructible_v<Types> &&
                  is_trivially_copy_assignable_v<Types> && is_trivially_destructible_v<Types>) &&
                 ...)
    = default;
    constexpr variant& operator=(const variant& other)
        requires((is_copy_constructible_v<Types> && is_copy_assignable_v<Types>) && ...) &&
                (!((is_trivially_copy_constructible_v<Types> &&
                    is_trivially_copy_assignable_v<Types> && is_trivially_destructible_v<Types>) &&
                   ...))
    {
        AssignFrom(other);
        return *this;
    }

    constexpr variant& operator=(variant&&)
        requires((is_trivially_move_constructible_v<Types> &&
                  is_trivially_move_assignable_v<Types> && is_trivially_destructible_v<Types>) &&
                 ...)
    = default;
    constexpr variant& operator=(variant&& other) noexcept(
        ((is_nothrow_move_constructible_v<Types> && is_nothrow_move_assignable_v<Types>) && ...))
        requires((is_move_constructible_v<Types> && is_move_assignable_v<Types>) && ...) &&
                (!((is_trivially_move_constructible_v<Types> &&
                    is_trivially_move_assignable_v<Types> && is_trivially_destructible_v<Types>) &&
                   ...))
    {
        AssignFrom(_FSTD::move(other));
        return *this;
    }

    template <class T, size_t Index = __detail::VariantAcceptedIndex<T, Types...>::value>
        requires(!is_same_v<remove_cvref_t<T>, variant>) &&
                is_assignable_v<Alternative<Index>&, T> && is_constructible_v<Alternative<Index>, T>
    constexpr variant&
    operator=(T&& value) noexcept(is_nothrow_assignable_v<Alternative<Index>&, T> &&
                                  is_nothrow_constructible_v<Alternative<Index>, T>)
    {
        if (__index == Index)
        {
            __detail::UnionGet<Index>(__storage) = _FSTD::forward<T>(value);
        }
        else
        {
            emplace<Index>(_FSTD::forward<T>(value));
        }
        return *this;
    }

    template <class T, class... Args>
        requires OccursOnce<T> && is_constructible_v<T, Args...>
    constexpr T& emplace(Args&&... args)
    {
        return emplace<IndexOf<T>>(_FSTD::forward<Args>(args)...);
    }

    template <class T, class U, class... Args>
        requires OccursOnce<T> && is_constructible_v<T, initializer_list<U>&, Args...>
    constexpr T& emplace(initializer_list<U> list, Args&&... args)
    {
        return emplace<IndexOf<T>>(list, _FSTD::forward<Args>(args)...);
    }

    template <size_t Index, class... Args>
        requires(Index < sizeof...(Types)) && is_constructible_v<Alternative<Index>, Args...>
    constexpr Alternative<Index>& emplace(Args&&... args)
    {
        Destroy();
        __detail::ConstructAt(_FSTD::addressof(__storage), in_place_index<Index>,
                              _FSTD::forward<Args>(args)...);
        __index = Index;
        return __detail::UnionGet<Index>(__storage);
    }

    template <size_t Index, class U, class... Args>
        requires(Index < sizeof...(Types)) &&
                is_constructible_v<Alternative<Index>, initializer_list<U>&, Args...>
    constexpr Alternative<Index>& emplace(initializer_list<U> list, Args&&... args)
    {
        return emplace<Index>(list, _FSTD::forward<Args>(args)...);
    }

    constexpr bool valueless_by_exception() const noexcept
    {
        return __index == EmptyIndex;
    }

    constexpr size_t index() const noexcept
    {
        return __index == EmptyIndex ? variant_npos : __index;
    }

    constexpr void swap(variant& other) noexcept(
        ((is_nothrow_move_constructible_v<Types> && is_nothrow_swappable_v<Types>) && ...))
    {
        if (__index == other.__index)
        {
            if (!valueless_by_exception())
            {
                __detail::Dispatch<sizeof...(Types), void>(
                    __index,
                    [&]<size_t Index>(integral_constant<size_t, Index>)
                    {
                        using _FSTD::swap;
                        swap(__detail::UnionGet<Index>(__storage),
                             __detail::UnionGet<Index>(other.__storage));
                    });
            }
            return;
        }
        variant moved(_FSTD::move(other));
        other.Destroy();
        other.ConstructFrom(_FSTD::move(*this));
        Destroy();
        ConstructFrom(_FSTD::move(moved));
    }

private:
    constexpr void Destroy() noexcept
    {
        if constexpr (!(is_trivially_destructible_v<Types> && ...))
        {
            if (!valueless_by_exception())
            {
                __detail::Dispatch<sizeof...(Types), void>(
                    __index, [this]<size_t Index>(integral_constant<size_t, Index>)
                    { _FSTD::destroy_at(_FSTD::addressof(__detail::UnionGet<Index>(__storage))); });
            }
        }
        __index = EmptyIndex;
    }

    template <class Other> constexpr void ConstructFrom(Other&& other)
    {
        if (!other.valueless_by_exception())
        {
            __detail::Dispatch<sizeof...(Types), void>(
                other.__index,
                [&]<size_t Index>(integral_constant<size_t, Index>)
                {
                    emplace<Index>(
                        __detail::UnionGet<Index>(_FSTD::forward<Other>(other).__storage));
                });
        }
    }

    template <class Other> constexpr void AssignFrom(Other&& other)
    {
        if (other.valueless_by_exception())
        {
            Destroy();
        }
        else if (__index == other.__index)
        {
            __detail::Dispatch<sizeof...(Types), void>(
                __index,
                [&]<size_t Index>(integral_constant<size_t, Index>)
                {
                    __detail::UnionGet<Index>(__storage) =
                        __detail::UnionGet<Index>(_FSTD::forward<Other>(other).__storage);
                });
        }
        else
        {
            ConstructFrom(_FSTD::forward<Other>(other));
        }
    }
};

template <class T, class... Types>
    requires(__detail::PackCount<T, Types...> == 1)
constexpr bool holds_alternative(const variant<Types...>& value) noexcept
{
    return value.index() == __detail::PackIndex<T, Types...>();
}

namespace __detail
{
template <size_t Index, class Variant> constexpr auto&& VariantGet(Variant&& value)
{
    if (value.index() != Index)
    {
        LibraryAbort("variant: get of an alternative the variant does not hold");
    }
    return __detail::UnionGet<Index>(_FSTD::forward<Variant>(value).__storage);
}
} // namespace __detail

