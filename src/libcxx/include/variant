namespace __detail
{
// Compares two variants that hold the same alternative with Compare, else by index.
template <class Result, class Compare, class... Types>
constexpr Result VariantCompare(const variant<Types...>& left, const variant<Types...>& right,
                                Compare compare)
{
    return __detail::Dispatch<sizeof...(Types), Result>(
        left.index(),
        [&]<size_t Index>(integral_constant<size_t, Index>) -> Result
        {
            return compare(__detail::UnionGet<Index>(left.__storage),
                           __detail::UnionGet<Index>(right.__storage));
        });
}
} // namespace __detail

template <class... Types>
constexpr bool operator==(const variant<Types...>& left, const variant<Types...>& right)
{
    if (left.index() != right.index())
    {
        return false;
    }
    if (left.valueless_by_exception())
    {
        return true;
    }
    return __detail::VariantCompare<bool>(
        left, right, [](const auto& first, const auto& second) -> bool { return first == second; });
}

template <class... Types>
constexpr bool operator!=(const variant<Types...>& left, const variant<Types...>& right)
{
    if (left.index() != right.index())
    {
        return true;
    }
    if (left.valueless_by_exception())
    {
        return false;
    }
    return __detail::VariantCompare<bool>(
        left, right, [](const auto& first, const auto& second) -> bool { return first != second; });
}

template <class... Types>
constexpr bool operator<(const variant<Types...>& left, const variant<Types...>& right)
{
    if (right.valueless_by_exception())
    {
        return false;
    }
    if (left.valueless_by_exception())
    {
        return true;
    }
    if (left.index() != right.index())
    {
        return left.index() < right.index();
    }
    return __detail::VariantCompare<bool>(
        left, right, [](const auto& first, const auto& second) -> bool { return first < second; });
}

template <class... Types>
constexpr bool operator>(const variant<Types...>& left, const variant<Types...>& right)
{
    return right < left;
}

template <class... Types>
constexpr bool operator<=(const variant<Types...>& left, const variant<Types...>& right)
{
    if (left.valueless_by_exception())
    {
        return true;
    }
    if (right.valueless_by_exception())
    {
        return false;
    }
    if (left.index() != right.index())
    {
        return left.index() < right.index();
    }
    return __detail::VariantCompare<bool>(
        left, right, [](const auto& first, const auto& second) -> bool { return first <= second; });
}

template <class... Types>
constexpr bool operator>=(const variant<Types...>& left, const variant<Types...>& right)
{
    return right <= left;
}

template <class... Types>
    requires(three_way_comparable<Types> && ...)
constexpr common_comparison_category_t<compare_three_way_result_t<Types>...>
operator<=>(const variant<Types...>& left, const variant<Types...>& right)
{
    using Result = common_comparison_category_t<compare_three_way_result_t<Types>...>;
    if (left.valueless_by_exception() && right.valueless_by_exception())
    {
        return strong_ordering::equal;
    }
    if (left.valueless_by_exception())
    {
        return strong_ordering::less;
    }
    if (right.valueless_by_exception())
    {
        return strong_ordering::greater;
    }
    if (left.index() != right.index())
    {
        return left.index() <=> right.index();
    }
    return __detail::VariantCompare<Result>(left, right,
                                            [](const auto& first, const auto& second) -> Result
                                            { return first <=> second; });
}

template <class... Types>
    requires((is_move_constructible_v<Types> && is_swappable_v<Types>) && ...)
constexpr void swap(variant<Types...>& left,
                    variant<Types...>& right) noexcept(noexcept(left.swap(right)))
{
    left.swap(right);
}

