// The as-variant of [variant.visit], so classes derived from a variant can be visited.
template <class... Types> constexpr variant<Types...>& AsVariant(variant<Types...>& value) noexcept
{
    return value;
}
template <class... Types>
constexpr const variant<Types...>& AsVariant(const variant<Types...>& value) noexcept
{
    return value;
}
template <class... Types>
constexpr variant<Types...>&& AsVariant(variant<Types...>&& value) noexcept
{
    return _FSTD::move(value);
}
template <class... Types>
constexpr const variant<Types...>&& AsVariant(const variant<Types...>&& value) noexcept
{
    return _FSTD::move(value);
}

template <class T>
concept Visitable = requires(T&& value) { __detail::AsVariant(_FSTD::forward<T>(value)); };

template <class T> using AsVariantType = decltype(__detail::AsVariant(declval<T>()));

template <class Result, bool Exact, class F, class... Args>
constexpr Result InvokeAs(F&& function, Args&&... args)
{
    if constexpr (Exact)
    {
        static_assert(is_same_v<decltype(__detail::Invoke(_FSTD::forward<F>(function),
                                                          _FSTD::forward<Args>(args)...)),
                                Result>,
                      "visit's function must return the same type for every alternative");
    }
    if constexpr (is_void_v<Result>)
    {
        static_cast<void>(
            __detail::Invoke(_FSTD::forward<F>(function), _FSTD::forward<Args>(args)...));
    }
    else
    {
        return __detail::Invoke(_FSTD::forward<F>(function), _FSTD::forward<Args>(args)...);
    }
}

// Picks each variant's alternative in turn, binding the ones chosen so far into the function;
// the innermost call has them all.
template <class Result, bool Exact, class F> constexpr Result VisitVariants(F&& function)
{
    return __detail::InvokeAs<Result, Exact>(_FSTD::forward<F>(function));
}

template <class Result, bool Exact, class F, class First, class... Rest>
constexpr Result VisitVariants(F&& function, First&& first, Rest&&... rest)
{
    if (first.valueless_by_exception())
    {
        LibraryAbort("variant: visit of a valueless variant");
    }
    return __detail::Dispatch<variant_size_v<remove_cvref_t<First>>, Result>(
        first.index(),
        [&]<size_t Index>(integral_constant<size_t, Index>) -> Result
        {
            return __detail::VisitVariants<Result, false>(
                [&](auto&&... chosen) -> Result
                {
                    return __detail::InvokeAs<Result, Exact>(
                        _FSTD::forward<F>(function),
                        __detail::UnionGet<Index>(_FSTD::forward<First>(first).__storage),
                        _FSTD::forward<decltype(chosen)>(chosen)...);
                },
                _FSTD::forward<Rest>(rest)...);
        });
}
} // namespace __detail

template <class Visitor, __detail::Visitable... Variants>
constexpr decltype(auto) visit(Visitor&& visitor, Variants&&... variants)
{
    using Result =
        decltype(__detail::Invoke(_FSTD::forward<Visitor>(visitor),
                                  _FSTD::get<0>(declval<__detail::AsVariantType<Variants>>())...));
    return __detail::VisitVariants<Result, true>(
        _FSTD::forward<Visitor>(visitor),
        __detail::AsVariant(_FSTD::forward<Variants>(variants))...);
}

template <class Result, class Visitor, __detail::Visitable... Variants>
constexpr Result visit(Visitor&& visitor, Variants&&... variants)
{
    return __detail::VisitVariants<Result, false>(
        _FSTD::forward<Visitor>(visitor),
        __detail::AsVariant(_FSTD::forward<Variants>(variants))...);
}

template <> struct hash<monostate>
{
    size_t operator()(monostate) const noexcept
    {
        return static_cast<size_t>(0x6d6f6e6f73746174ULL);
    }
};

template <class... Types>
    requires(__detail::HashEnabled<remove_const_t<Types>> && ...)
struct hash<variant<Types...>>
{
    size_t operator()(const variant<Types...>& value) const
    {
        return __detail::HashCombine(
            value.index(),
            _FSTD::visit([](const auto& alternative)
                         { return hash<remove_cvref_t<decltype(alternative)>>()(alternative); },
                         value));
    }
};

