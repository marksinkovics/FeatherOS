template <class CharT, class... Args> struct basic_format_string
{
    template <class T>
        requires convertible_to<const T&, basic_string_view<CharT>>
    consteval basic_format_string(const T& text) : m_text(text)
    {
        __detail::CheckFormatString<remove_cvref_t<Args>...>(m_text);
    }

    constexpr basic_string_view<CharT> get() const noexcept
    {
        return m_text;
    }

private:
    basic_string_view<CharT> m_text;
};

template <class... Args> using format_string = basic_format_string<char, type_identity_t<Args>...>;

string vformat(string_view pattern, format_args args);

template <class... Args> string format(format_string<Args...> pattern, Args&&... args)
{
    return vformat(pattern.get(), _FSTD::make_format_args(args...));
}

template <output_iterator<const char&> Out>
Out vformat_to(Out out, string_view pattern, format_args args)
{
    if constexpr (is_same_v<Out, __detail::FormatIterator>)
    {
        __detail::VFormat(out.Buffer(), pattern, args);
        return out;
    }
    else
    {
        __detail::FormatIteratorBuffer<Out> buffer(_FSTD::move(out));
        __detail::VFormat(buffer, pattern, args);
        return buffer.Finish();
    }
}

template <output_iterator<const char&> Out, class... Args>
Out format_to(Out out, format_string<Args...> pattern, Args&&... args)
{
    return _FSTD::vformat_to(_FSTD::move(out), pattern.get(), _FSTD::make_format_args(args...));
}

template <class Out> struct format_to_n_result
{
    Out out;
    iter_difference_t<Out> size;
};

template <output_iterator<const char&> Out, class... Args>
format_to_n_result<Out> format_to_n(Out out, iter_difference_t<Out> limit,
                                    format_string<Args...> pattern, Args&&... args)
{
    __detail::FormatLimitedBuffer<Out> buffer(_FSTD::move(out), limit);
    __detail::VFormat(buffer, pattern.get(), _FSTD::make_format_args(args...));
    Out end = buffer.Finish();
    return {_FSTD::move(end), static_cast<iter_difference_t<Out>>(buffer.Total())};
}

template <class... Args> size_t formatted_size(format_string<Args...> pattern, Args&&... args)
{
    return __detail::VFormattedSize(pattern.get(), _FSTD::make_format_args(args...));
}

