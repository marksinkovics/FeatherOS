template <class CharT> class basic_format_parse_context
{
public:
    using char_type = CharT;
    using const_iterator = typename basic_string_view<CharT>::const_iterator;
    using iterator = const_iterator;

    constexpr explicit basic_format_parse_context(basic_string_view<CharT> format,
                                                  size_t argument_count = 0) noexcept
        : m_begin(format.begin()), m_end(format.end()), m_argument_count(argument_count)
    {
    }
    basic_format_parse_context(const basic_format_parse_context&) = delete;
    basic_format_parse_context& operator=(const basic_format_parse_context&) = delete;

    constexpr const_iterator begin() const noexcept
    {
        return m_begin;
    }
    constexpr const_iterator end() const noexcept
    {
        return m_end;
    }
    constexpr void advance_to(const_iterator position)
    {
        m_begin = position;
    }

    constexpr size_t next_arg_id()
    {
        if (m_indexing == Indexing::Manual)
        {
            __detail::FormatError("format string mixes automatic and manual argument indexing");
        }
        m_indexing = Indexing::Automatic;
        if consteval
        {
            if (m_next_id >= m_argument_count)
            {
                __detail::FormatError("format string refers to an argument that is not given");
            }
        }
        return m_next_id++;
    }

    constexpr void check_arg_id(size_t id)
    {
        if (m_indexing == Indexing::Automatic)
        {
            __detail::FormatError("format string mixes automatic and manual argument indexing");
        }
        m_indexing = Indexing::Manual;
        if consteval
        {
            if (id >= m_argument_count)
            {
                __detail::FormatError("format string refers to an argument that is not given");
            }
        }
    }

private:
    friend struct __detail::FormatParseAccess;

    enum class Indexing : unsigned char
    {
        Unknown,
        Manual,
        Automatic,
    };

    iterator m_begin;
    iterator m_end;
    Indexing m_indexing = Indexing::Unknown;
    size_t m_next_id = 0;
    size_t m_argument_count;
    // Set only while a format string is checked at compile time.
    const __detail::FormatArgKind* m_kinds = nullptr;
};

using format_parse_context = basic_format_parse_context<char>;

namespace __detail
{

struct FormatParseAccess
{
    template <class CharT>
    static constexpr void SetKinds(basic_format_parse_context<CharT>& context,
                                   const FormatArgKind* kinds)
    {
        context.m_kinds = kinds;
    }

    template <class CharT>
    static constexpr void CheckDynamicArgument(const basic_format_parse_context<CharT>& context,
                                               size_t id)
    {
        if (context.m_kinds != nullptr && !IsIntegerArgKind(context.m_kinds[id]))
        {
            FormatError("a width or precision argument is not an integer");
        }
    }
};

struct FormatArgAccess;
struct FormatContextAccess;

