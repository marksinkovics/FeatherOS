template <class Context, class T> constexpr FormatArgKind FormatArgKindOf()
{
    using Plain = remove_cvref_t<T>;
    if constexpr (is_same_v<Plain, bool>)
    {
        return FormatArgKind::Bool;
    }
    else if constexpr (is_same_v<Plain, typename Context::char_type>)
    {
        return FormatArgKind::Char;
    }
    else if constexpr (FormatStandardInteger<Plain> && is_signed_v<Plain>)
    {
        return sizeof(Plain) <= sizeof(int) ? FormatArgKind::Int : FormatArgKind::LongLong;
    }
    else if constexpr (FormatStandardInteger<Plain>)
    {
        return sizeof(Plain) <= sizeof(unsigned) ? FormatArgKind::Unsigned
                                                 : FormatArgKind::UnsignedLongLong;
    }
    else if constexpr (is_same_v<Plain, float>)
    {
        return FormatArgKind::Float;
    }
    else if constexpr (is_same_v<Plain, double>)
    {
        return FormatArgKind::Double;
    }
    else if constexpr (is_same_v<Plain, long double>)
    {
        return FormatArgKind::LongDouble;
    }
    else if constexpr (IsBasicStringOrView<Plain>::value || is_same_v<Plain, char*> ||
                       is_same_v<Plain, const char*> ||
                       (is_bounded_array_v<Plain> &&
                        is_same_v<remove_extent_t<Plain>, typename Context::char_type>))
    {
        return is_pointer_v<Plain> ? FormatArgKind::CString : FormatArgKind::StringView;
    }
    else if constexpr (is_same_v<Plain, void*> || is_same_v<Plain, const void*> ||
                       is_same_v<Plain, nullptr_t>)
    {
        return FormatArgKind::Pointer;
    }
    else
    {
        return FormatArgKind::Handle;
    }
}

template <class Context, class T> basic_format_arg<Context> MakeFormatArg(T& value) noexcept
{
    static_assert(FormattableWith<T, Context>, "the argument's type has no usable formatter");
    using Plain = remove_const_t<T>;
    using CharT = typename Context::char_type;
    constexpr FormatArgKind kind = FormatArgKindOf<Context, T>();
    if constexpr (kind == FormatArgKind::Int)
    {
        return FormatArgAccess::Make<Context>(static_cast<int>(value));
    }
    else if constexpr (kind == FormatArgKind::LongLong)
    {
        return FormatArgAccess::Make<Context>(static_cast<long long>(value));
    }
    else if constexpr (kind == FormatArgKind::Unsigned)
    {
        return FormatArgAccess::Make<Context>(static_cast<unsigned>(value));
    }
    else if constexpr (kind == FormatArgKind::UnsignedLongLong)
    {
        return FormatArgAccess::Make<Context>(static_cast<unsigned long long>(value));
    }
    else if constexpr (kind == FormatArgKind::CString)
    {
        return FormatArgAccess::Make<Context>(static_cast<const CharT*>(value));
    }
    else if constexpr (kind == FormatArgKind::StringView && is_bounded_array_v<Plain>)
    {
        size_t length = 0;
        while (length != extent_v<Plain> && value[length] != CharT())
        {
            ++length;
        }
        return FormatArgAccess::Make<Context>(basic_string_view<CharT>(value, length));
    }
    else if constexpr (kind == FormatArgKind::StringView)
    {
        return FormatArgAccess::Make<Context>(basic_string_view<CharT>(value.data(), value.size()));
    }
    else if constexpr (kind == FormatArgKind::Pointer)
    {
        return FormatArgAccess::Make<Context>(static_cast<const void*>(value));
    }
    else if constexpr (kind == FormatArgKind::Handle)
    {
        return FormatArgAccess::MakeHandle<Context>(value);
    }
    else
    {
        return FormatArgAccess::Make<Context>(static_cast<Plain>(value));
    }
}

