// The compile-time check: each replacement field's formatter parses its spec, as formatting
// would.
template <class T> constexpr void CheckFormatField(basic_format_parse_context<char>& context)
{
    formatter<T, char> checker;
    context.advance_to(checker.parse(context));
}

template <class Handler>
constexpr void ScanFormatString(basic_format_parse_context<char>& context, Handler& handler)
{
    const char* cursor = context.begin();
    const char* const end = context.end();
    const char* text = cursor;
    while (cursor != end)
    {
        if (*cursor == '}')
        {
            ++cursor;
            if (cursor == end || *cursor != '}')
            {
                FormatError("the format string has a '}' without a '{'");
            }
            handler.Text(text, cursor);
            ++cursor;
            text = cursor;
            continue;
        }
        if (*cursor != '{')
        {
            ++cursor;
            continue;
        }
        handler.Text(text, cursor);
        ++cursor;
        if (cursor == end)
        {
            FormatError("the format string ends inside a replacement field");
        }
        if (*cursor == '{')
        {
            text = cursor;
            ++cursor;
            continue;
        }
        size_t id = 0;
        if (*cursor == '}' || *cursor == ':')
        {
            id = context.next_arg_id();
        }
        else if (IsFormatDigit(*cursor))
        {
            id = ParseFormatArgumentId(cursor, end);
            context.check_arg_id(id);
        }
        else
        {
            FormatError("invalid argument index in the format string");
        }
        if (cursor != end && *cursor == ':')
        {
            ++cursor;
        }
        else if (cursor == end || *cursor != '}')
        {
            FormatError("a replacement field is missing its '}'");
        }
        context.advance_to(cursor);
        handler.Field(id, context);
        cursor = context.begin();
        if (cursor == end || *cursor != '}')
        {
            FormatError("a replacement field is missing its '}'");
        }
        ++cursor;
        text = cursor;
    }
    handler.Text(text, end);
}

template <class... Args> struct FormatChecker
{
    static constexpr FormatArgKind Kinds[sizeof...(Args) == 0 ? 1 : sizeof...(Args)] = {
        FormatArgKindOf<format_context, Args>()...};
    using Check = void (*)(basic_format_parse_context<char>&);
    static constexpr Check Checks[sizeof...(Args) == 0 ? 1 : sizeof...(Args)] = {
        &CheckFormatField<Args>...};

    constexpr void Text(const char*, const char*) {}
    constexpr void Field(size_t id, basic_format_parse_context<char>& context)
    {
        if constexpr (sizeof...(Args) == 0)
        {
            FormatError("format string refers to an argument that is not given");
        }
        else
        {
            Checks[id](context);
        }
    }
};

template <class... Args> constexpr void CheckFormatString(string_view format)
{
    basic_format_parse_context<char> context(format, sizeof...(Args));
    FormatParseAccess::SetKinds(context, FormatChecker<Args...>::Kinds);
    FormatChecker<Args...> checker;
    ScanFormatString(context, checker);
}

