template <class T> inline constexpr bool IsFormatPairLike = false;
template <class First, class Second>
inline constexpr bool IsFormatPairLike<pair<First, Second>> = true;
template <class First, class Second>
inline constexpr bool IsFormatPairLike<tuple<First, Second>> = true;

template <class R> constexpr range_format DefaultFormatKind()
{
    using Element = remove_cvref_t<ranges::range_reference_t<R>>;
    if constexpr (is_same_v<Element, R>)
    {
        return range_format::disabled;
    }
    else if constexpr (requires { typename R::key_type; })
    {
        if constexpr (requires { typename R::mapped_type; } && IsFormatPairLike<Element>)
        {
            return range_format::map;
        }
        else
        {
            return range_format::set;
        }
    }
    else
    {
        return range_format::sequence;
    }
}

template <class Formatter>
constexpr void ParseElementFormatter(Formatter& formatter,
                                     basic_format_parse_context<char>& context, bool debug)
{
    context.advance_to(formatter.parse(context));
    if constexpr (requires { formatter.set_debug_format(); })
    {
        if (debug)
        {
            formatter.set_debug_format();
        }
    }
}

template <class R>
void FormatTextRange(format_context& context, FormatSpec spec, R& range, bool debug)
{
    spec.type = debug ? '?' : '\0';
    if constexpr (ranges::contiguous_range<R> && ranges::sized_range<R>)
    {
        FormatStringValue(context, spec, string_view(ranges::data(range), ranges::size(range)));
    }
    else
    {
        string text;
        auto last = ranges::end(range);
        for (auto cursor = ranges::begin(range); cursor != last; ++cursor)
        {
            text.push_back(*cursor);
        }
        FormatStringValue(context, spec, text);
    }
}

