[[noreturn]] constexpr void FormatError(const char* message)
{
    LibraryAbort(message);
}

enum class FormatArgKind : unsigned char
{
    None,
    Bool,
    Char,
    Int,
    Unsigned,
    LongLong,
    UnsignedLongLong,
    Float,
    Double,
    LongDouble,
    CString,
    StringView,
    Pointer,
    Handle,
};

constexpr bool IsIntegerArgKind(FormatArgKind kind)
{
    return kind == FormatArgKind::Int || kind == FormatArgKind::Unsigned ||
           kind == FormatArgKind::LongLong || kind == FormatArgKind::UnsignedLongLong;
}

// Characters wait here until the sink behind the buffer takes them.
class FormatBuffer
{
public:
    FormatBuffer(const FormatBuffer&) = delete;
    FormatBuffer& operator=(const FormatBuffer&) = delete;

    void Put(char character)
    {
        if (m_size == m_capacity)
        {
            Flush();
        }
        m_data[m_size++] = character;
    }
    void Write(const char* text, size_t length);
    void Write(string_view text)
    {
        Write(text.data(), text.size());
    }
    // count copies of a fill character, which is 1 to 4 UTF-8 bytes.
    void Fill(size_t count, const char* fill, size_t fill_size);
    void Flush();

protected:
    using Drain = void (*)(FormatBuffer& buffer, const char* data, size_t size);

    FormatBuffer(char* data, size_t capacity, Drain drain) noexcept
        : m_data(data), m_capacity(capacity), m_drain(drain)
    {
    }
    ~FormatBuffer() = default;

private:
    char* m_data;
    size_t m_size = 0;
    size_t m_capacity;
    Drain m_drain;
};

class FormatIterator
{
public:
    using iterator_category = output_iterator_tag;
    using value_type = void;
    using difference_type = ptrdiff_t;
    using pointer = void;
    using reference = void;

    FormatIterator() noexcept = default;
    explicit FormatIterator(FormatBuffer& buffer) noexcept : m_buffer(&buffer) {}

    FormatIterator& operator=(char character)
    {
        m_buffer->Put(character);
        return *this;
    }
    FormatIterator& operator*() noexcept
    {
        return *this;
    }
    FormatIterator& operator++() noexcept
    {
        return *this;
    }
    FormatIterator operator++(int) noexcept
    {
        return *this;
    }

    FormatBuffer& Buffer() const noexcept
    {
        return *m_buffer;
    }

private:
    FormatBuffer* m_buffer = nullptr;
};

template <class Out> class FormatIteratorBuffer final : public FormatBuffer
{
public:
    explicit FormatIteratorBuffer(Out out)
        : FormatBuffer(m_storage, sizeof(m_storage), &DrainTo), m_out(_FSTD::move(out))
    {
    }

    Out Finish()
    {
        Flush();
        return _FSTD::move(m_out);
    }

private:
    static void DrainTo(FormatBuffer& buffer, const char* data, size_t size)
    {
        auto& self = static_cast<FormatIteratorBuffer&>(buffer);
        for (size_t index = 0; index != size; ++index)
        {
            *self.m_out = data[index];
            ++self.m_out;
        }
    }

    char m_storage[256];
    Out m_out;
};

// format_to_n's sink: keeps the first limit characters and counts them all.
template <class Out> class FormatLimitedBuffer final : public FormatBuffer
{
public:
    FormatLimitedBuffer(Out out, iter_difference_t<Out> limit)
        : FormatBuffer(m_storage, sizeof(m_storage), &DrainTo), m_out(_FSTD::move(out)),
          m_left(limit > 0 ? static_cast<size_t>(limit) : 0)
    {
    }

    Out Finish()
    {
        Flush();
        return _FSTD::move(m_out);
    }
    size_t Total() const noexcept
    {
        return m_total;
    }

private:
    static void DrainTo(FormatBuffer& buffer, const char* data, size_t size)
    {
        auto& self = static_cast<FormatLimitedBuffer&>(buffer);
        const size_t kept = size < self.m_left ? size : self.m_left;
        for (size_t index = 0; index != kept; ++index)
        {
            *self.m_out = data[index];
            ++self.m_out;
        }
        self.m_left -= kept;
        self.m_total += size;
    }

    char m_storage[256];
    Out m_out;
    size_t m_left;
    size_t m_total = 0;
};

enum class FormatAlign : unsigned char
{
    Default,
    Left,
    Center,
    Right,
};

enum class FormatSign : unsigned char
{
    Default,
    Plus,
    Minus,
    Space,
};

// The parsed std-format-spec. A width or precision taken from an argument keeps the argument's
// index until the formatter formats.
struct FormatSpec
{
    char fill[4] = {' ', '\0', '\0', '\0'};
    unsigned char fill_size = 1;
    FormatAlign align = FormatAlign::Default;
    FormatSign sign = FormatSign::Default;
    bool alternate = false;
    bool zero = false;
    bool locale = false;
    char type = '\0';
    int width = 0;
    // -1 when the spec gives none.
    int precision = -1;
    int width_argument = -1;
    int precision_argument = -1;
};

struct FormatParseAccess;

struct Utf8Decoded
{
    char32_t code_point;
    // 0 when the bytes are not a valid UTF-8 sequence.
    size_t length;
};

constexpr Utf8Decoded DecodeUtf8(const char* first, const char* last)
{
    const auto lead = static_cast<unsigned char>(*first);
    if (lead < 0x80)
    {
        return {lead, 1};
    }
    size_t length = 0;
    char32_t value = 0;
    char32_t minimum = 0;
    if (lead >= 0xC2 && lead <= 0xDF)
    {
        length = 2;
        value = lead & 0x1Fu;
        minimum = 0x80;
    }
    else if (lead >= 0xE0 && lead <= 0xEF)
    {
        length = 3;
        value = lead & 0x0Fu;
        minimum = 0x800;
    }
    else if (lead >= 0xF0 && lead <= 0xF4)
    {
        length = 4;
        value = lead & 0x07u;
        minimum = 0x10000;
    }
    else
    {
        return {0xFFFD, 0};
    }
    if (static_cast<size_t>(last - first) < length)
    {
        return {0xFFFD, 0};
    }
    for (size_t index = 1; index != length; ++index)
    {
        const auto next = static_cast<unsigned char>(first[index]);
        if ((next & 0xC0u) != 0x80u)
        {
            return {0xFFFD, 0};
        }
        value = (value << 6) | (next & 0x3Fu);
    }
    if (value < minimum || value > 0x10FFFF || (value >= 0xD800 && value <= 0xDFFF))
    {
        return {0xFFFD, 0};
    }
    return {value, length};
}

