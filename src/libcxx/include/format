// Only char formatting. Output goes through __detail::FormatBuffer, a buffer that a sink drains,
// so format_context has one iterator type and the formatting loop (__detail::VFormat) and the
// standard types' formatting are compiled once into featheros_cxx (src/libcxx/src/format.cpp).
// What would throw format_error calls LibraryAbort; in a format string checked at compile time
// that is a call to a function that is not constexpr, so the program does not compile.

namespace FEATHEROS_STD_NAMESPACE
{

template <class T, class CharT = char> struct formatter
{
    formatter() = delete;
    formatter(const formatter&) = delete;
    formatter& operator=(const formatter&) = delete;
};

