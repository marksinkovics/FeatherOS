template <class T, class CharT = char>
    requires same_as<remove_cvref_t<T>, T> && formattable<T, CharT>
class range_formatter
{
    static_assert(is_same_v<CharT, char>, "only char formatting is supported");

public:
    constexpr void set_separator(basic_string_view<CharT> separator) noexcept
    {
        m_separator = separator;
    }
    constexpr void set_brackets(basic_string_view<CharT> opening,
                                basic_string_view<CharT> closing) noexcept
    {
        m_opening = opening;
        m_closing = closing;
    }
    constexpr formatter<T, CharT>& underlying() noexcept
    {
        return m_underlying;
    }
    constexpr const formatter<T, CharT>& underlying() const noexcept
    {
        return m_underlying;
    }

    template <class ParseContext>
    constexpr typename ParseContext::iterator parse(ParseContext& context)
    {
        const __detail::CompositeSpec parsed = __detail::ParseCompositeSpec(context, m_spec, true);
        m_type = parsed.type;
        m_no_brackets = parsed.no_brackets;
        if (m_type == 's' || m_type == '?')
        {
            if constexpr (!is_same_v<T, CharT>)
            {
                __detail::FormatError("only a range of characters can be formatted as a string");
            }
            if (m_no_brackets || parsed.element_spec)
            {
                __detail::FormatError("a range formatted as a string takes no 'n' or element spec");
            }
            return parsed.end;
        }
        if (m_type == 'm')
        {
            if constexpr (__detail::IsFormatPairLike<T>)
            {
                set_brackets("{", "}");
                m_underlying.set_brackets({}, {});
                m_underlying.set_separator(": ");
            }
            else
            {
                __detail::FormatError("'m' needs a range of pairs or two-element tuples");
            }
        }
        context.advance_to(parsed.end);
        __detail::ParseElementFormatter(m_underlying, context, !parsed.element_spec);
        return context.begin();
    }

    template <ranges::input_range R, class FormatContext>
        requires formattable<ranges::range_reference_t<R>, CharT> &&
                 same_as<remove_cvref_t<ranges::range_reference_t<R>>, T>
    typename FormatContext::iterator format(R&& range, FormatContext& context) const
    {
        if constexpr (is_same_v<T, CharT>)
        {
            if (m_type == 's' || m_type == '?')
            {
                __detail::FormatTextRange(context, m_spec, range, m_type == '?');
                return context.out();
            }
        }
        using Range = remove_reference_t<R>;
        struct State
        {
            const range_formatter* self;
            Range* range;
        };
        const State state = {this, __builtin_addressof(range)};
        __detail::FormatPadded(
            context, m_spec,
            [](format_context& inner, const void* erased)
            {
                const auto& [self, elements] = *static_cast<const State*>(erased);
                self->FormatElements(*elements, inner);
            },
            &state);
        return context.out();
    }

private:
    template <class R> void FormatElements(R& range, format_context& context) const
    {
        __detail::FormatBuffer& out = context.out().Buffer();
        if (!m_no_brackets)
        {
            out.Write(m_opening);
        }
        bool first = true;
        auto last = ranges::end(range);
        for (auto cursor = ranges::begin(range); cursor != last; ++cursor)
        {
            if (!first)
            {
                out.Write(m_separator);
            }
            first = false;
            context.advance_to(m_underlying.format(*cursor, context));
        }
        if (!m_no_brackets)
        {
            out.Write(m_closing);
        }
    }

    formatter<T, CharT> m_underlying;
    basic_string_view<CharT> m_separator = ", ";
    basic_string_view<CharT> m_opening = "[";
    basic_string_view<CharT> m_closing = "]";
    __detail::FormatSpec m_spec;
    char m_type = '\0';
    bool m_no_brackets = false;
};

