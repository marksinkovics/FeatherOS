template <range_format Kind, class R, class CharT> class RangeDefaultFormatter;

template <range_format Kind, class R, class CharT>
    requires(Kind == range_format::sequence || Kind == range_format::map ||
             Kind == range_format::set)
class RangeDefaultFormatter<Kind, R, CharT>
{
    using Element = remove_cvref_t<ranges::range_reference_t<FormatMaybeConst<R, CharT>>>;
    static_assert(Kind != range_format::map || IsFormatPairLike<Element>,
                  "a map's elements must be pairs or two-element tuples");

public:
    constexpr RangeDefaultFormatter()
    {
        if constexpr (Kind == range_format::map)
        {
            m_underlying.set_brackets("{", "}");
            m_underlying.underlying().set_brackets({}, {});
            m_underlying.underlying().set_separator(": ");
        }
        else if constexpr (Kind == range_format::set)
        {
            m_underlying.set_brackets("{", "}");
        }
    }

    constexpr void set_separator(basic_string_view<CharT> separator) noexcept
        requires(Kind == range_format::sequence)
    {
        m_underlying.set_separator(separator);
    }
    constexpr void set_brackets(basic_string_view<CharT> opening,
                                basic_string_view<CharT> closing) noexcept
        requires(Kind == range_format::sequence)
    {
        m_underlying.set_brackets(opening, closing);
    }

    template <class ParseContext>
    constexpr typename ParseContext::iterator parse(ParseContext& context)
    {
        return m_underlying.parse(context);
    }

    template <class FormatContext>
    typename FormatContext::iterator format(FormatMaybeConst<R, CharT>& range,
                                            FormatContext& context) const
    {
        return m_underlying.format(range, context);
    }

private:
    range_formatter<Element, CharT> m_underlying;
};

template <range_format Kind, class R, class CharT>
    requires(Kind == range_format::string || Kind == range_format::debug_string)
class RangeDefaultFormatter<Kind, R, CharT>
{
    static_assert(is_same_v<remove_cvref_t<ranges::range_reference_t<R>>, CharT>,
                  "a range formatted as a string must have characters as its elements");

public:
    template <class ParseContext>
    constexpr typename ParseContext::iterator parse(ParseContext& context)
    {
        const char* end = ParseFormatSpec(context, m_spec);
        CheckFormatSpec(m_spec, "s?", FormatAllowsPrecision);
        if constexpr (Kind == range_format::debug_string)
        {
            m_spec.type = '?';
        }
        return end;
    }

    template <class FormatContext>
    typename FormatContext::iterator format(FormatMaybeConst<R, CharT>& range,
                                            FormatContext& context) const
    {
        FormatTextRange(context, m_spec, range, m_spec.type == '?');
        return context.out();
    }

private:
    FormatSpec m_spec;
};

template <class Tuple, class... Ts> class TupleFormatter
{
public:
    constexpr void set_separator(string_view separator) noexcept
    {
        m_separator = separator;
    }
    constexpr void set_brackets(string_view opening, string_view closing) noexcept
    {
        m_opening = opening;
        m_closing = closing;
    }

    template <class ParseContext>
    constexpr typename ParseContext::iterator parse(ParseContext& context)
    {
        const CompositeSpec parsed = ParseCompositeSpec(context, m_spec, false);
        if (parsed.type == 'm')
        {
            if constexpr (sizeof...(Ts) == 2)
            {
                set_brackets({}, {});
                set_separator(": ");
            }
            else
            {
                FormatError("'m' needs a pair or a two-element tuple");
            }
        }
        else if (parsed.type == 'n')
        {
            set_brackets({}, {});
        }
        context.advance_to(parsed.end);
        [&]<size_t... Index>(index_sequence<Index...>)
        {
            (ParseElementFormatter(_FSTD::get<Index>(m_underlying), context, true), ...);
        }(index_sequence_for<Ts...>{});
        return parsed.end;
    }

    template <class FormatContext>
    typename FormatContext::iterator
    format(conditional_t<(formattable<const Ts, char> && ...), const Tuple, Tuple>& elements,
           FormatContext& context) const
    {
        using Elements = remove_reference_t<decltype(elements)>;
        struct State
        {
            const TupleFormatter* self;
            Elements* elements;
        };
        const State state = {this, __builtin_addressof(elements)};
        FormatPadded(
            context, m_spec,
            [](format_context& inner, const void* erased)
            {
                const auto& [self, values] = *static_cast<const State*>(erased);
                self->FormatElements(*values, inner, index_sequence_for<Ts...>{});
            },
            &state);
        return context.out();
    }

private:
    template <class Elements, size_t... Index>
    void FormatElements(Elements& elements, format_context& context, index_sequence<Index...>) const
    {
        FormatBuffer& out = context.out().Buffer();
        out.Write(m_opening);
        (
            [&]
            {
                if (Index != 0)
                {
                    out.Write(m_separator);
                }
                context.advance_to(
                    _FSTD::get<Index>(m_underlying).format(_FSTD::get<Index>(elements), context));
            }(),
            ...);
        out.Write(m_closing);
    }

    tuple<formatter<remove_cvref_t<Ts>, char>...> m_underlying;
    string_view m_separator = ", ";
    string_view m_opening = "(";
    string_view m_closing = ")";
    FormatSpec m_spec;
};

