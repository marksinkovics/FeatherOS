    is_same_v<T, signed char> || is_same_v<T, short> || is_same_v<T, int> || is_same_v<T, long> ||
    is_same_v<T, long long> || is_same_v<T, unsigned char> || is_same_v<T, unsigned short> ||
    is_same_v<T, unsigned> || is_same_v<T, unsigned long> || is_same_v<T, unsigned long long>;

