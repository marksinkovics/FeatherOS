template <class Context> class basic_format_arg
{
public:
    using char_type = typename Context::char_type;

    class handle
    {
    public:
        void format(basic_format_parse_context<char_type>& parse_context, Context& context) const
        {
            m_format(parse_context, context, m_value);
        }

    private:
        friend class basic_format_arg;
        friend struct __detail::FormatArgAccess;

        using Function = void (*)(basic_format_parse_context<char_type>&, Context&, const void*);

        handle(const void* value, Function function) noexcept : m_value(value), m_format(function)
        {
        }

        const void* m_value;
        Function m_format;
    };

    basic_format_arg() noexcept : m_none(), m_kind(__detail::FormatArgKind::None) {}

    explicit operator bool() const noexcept
    {
        return m_kind != __detail::FormatArgKind::None;
    }

private:
    friend struct __detail::FormatArgAccess;
    using Kind = __detail::FormatArgKind;

    explicit basic_format_arg(bool value) noexcept : m_bool(value), m_kind(Kind::Bool) {}
    explicit basic_format_arg(char_type value) noexcept : m_char(value), m_kind(Kind::Char) {}
    explicit basic_format_arg(int value) noexcept : m_int(value), m_kind(Kind::Int) {}
    explicit basic_format_arg(unsigned value) noexcept : m_unsigned(value), m_kind(Kind::Unsigned)
    {
    }
    explicit basic_format_arg(long long value) noexcept : m_long_long(value), m_kind(Kind::LongLong)
    {
    }
    explicit basic_format_arg(unsigned long long value) noexcept
        : m_unsigned_long_long(value), m_kind(Kind::UnsignedLongLong)
    {
    }
    explicit basic_format_arg(float value) noexcept : m_float(value), m_kind(Kind::Float) {}
    explicit basic_format_arg(double value) noexcept : m_double(value), m_kind(Kind::Double) {}
    explicit basic_format_arg(long double value) noexcept
        : m_long_double(value), m_kind(Kind::LongDouble)
    {
    }
    explicit basic_format_arg(const char_type* value) noexcept
        : m_c_string(value), m_kind(Kind::CString)
    {
    }
    explicit basic_format_arg(basic_string_view<char_type> value) noexcept
        : m_string_view(value), m_kind(Kind::StringView)
    {
    }
    explicit basic_format_arg(const void* value) noexcept : m_pointer(value), m_kind(Kind::Pointer)
    {
    }
    explicit basic_format_arg(handle value) noexcept : m_handle(value), m_kind(Kind::Handle) {}

    union
    {
        monostate m_none;
        bool m_bool;
        char_type m_char;
        int m_int;
        unsigned m_unsigned;
        long long m_long_long;
        unsigned long long m_unsigned_long_long;
        float m_float;
        double m_double;
        long double m_long_double;
        const char_type* m_c_string;
        basic_string_view<char_type> m_string_view;
        const void* m_pointer;
        handle m_handle;
    };
    Kind m_kind;
};

