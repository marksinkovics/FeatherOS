template <class Context, class... Args> struct FormatArgStore
{
    basic_format_arg<Context> args[sizeof...(Args) == 0 ? 1 : sizeof...(Args)];
};

} // namespace __detail

template <class Context> class basic_format_args
{
public:
    basic_format_args() noexcept = default;

    template <class... Args>
    basic_format_args(const __detail::FormatArgStore<Context, Args...>& store) noexcept
        : m_size(sizeof...(Args)), m_data(store.args)
    {
    }

    basic_format_arg<Context> get(size_t index) const noexcept
    {
        return index < m_size ? m_data[index] : basic_format_arg<Context>();
    }

private:
    size_t m_size = 0;
    const basic_format_arg<Context>* m_data = nullptr;
};

template <class Context, class... Args>
basic_format_args(__detail::FormatArgStore<Context, Args...>) -> basic_format_args<Context>;

template <class Out, class CharT> class basic_format_context
{
public:
    using iterator = Out;
    using char_type = CharT;
    template <class T> using formatter_type = formatter<T, CharT>;

    basic_format_arg<basic_format_context> arg(size_t id) const noexcept
    {
        return m_args.get(id);
    }
    iterator out()
    {
        return _FSTD::move(m_out);
    }
    void advance_to(iterator position)
    {
        m_out = _FSTD::move(position);
    }

private:
    friend struct __detail::FormatContextAccess;

    basic_format_context(Out out, basic_format_args<basic_format_context> args)
        : m_args(args), m_out(_FSTD::move(out))
    {
    }

    basic_format_args<basic_format_context> m_args;
    Out m_out;
};

using format_context = basic_format_context<__detail::FormatIterator, char>;
using format_args = basic_format_args<format_context>;

namespace __detail
{

struct FormatContextAccess
{
    static format_context Make(FormatBuffer& buffer, format_args args)
    {
        return format_context(FormatIterator(buffer), args);
    }
    static format_args Args(const format_context& context)
    {
        return context.m_args;
    }
};

struct FormatArgAccess
{
    template <class Context> static FormatArgKind Kind(const basic_format_arg<Context>& arg)
    {
        return arg.m_kind;
    }

    template <class Visitor, class Context>
    static decltype(auto) Visit(Visitor&& visitor, basic_format_arg<Context>& arg)
    {
        switch (arg.m_kind)
        {
        case FormatArgKind::Bool:
            return _FSTD::forward<Visitor>(visitor)(arg.m_bool);
        case FormatArgKind::Char:
            return _FSTD::forward<Visitor>(visitor)(arg.m_char);
        case FormatArgKind::Int:
            return _FSTD::forward<Visitor>(visitor)(arg.m_int);
        case FormatArgKind::Unsigned:
            return _FSTD::forward<Visitor>(visitor)(arg.m_unsigned);
        case FormatArgKind::LongLong:
            return _FSTD::forward<Visitor>(visitor)(arg.m_long_long);
        case FormatArgKind::UnsignedLongLong:
            return _FSTD::forward<Visitor>(visitor)(arg.m_unsigned_long_long);
        case FormatArgKind::Float:
            return _FSTD::forward<Visitor>(visitor)(arg.m_float);
        case FormatArgKind::Double:
            return _FSTD::forward<Visitor>(visitor)(arg.m_double);
        case FormatArgKind::LongDouble:
            return _FSTD::forward<Visitor>(visitor)(arg.m_long_double);
        case FormatArgKind::CString:
            return _FSTD::forward<Visitor>(visitor)(arg.m_c_string);
        case FormatArgKind::StringView:
            return _FSTD::forward<Visitor>(visitor)(arg.m_string_view);
        case FormatArgKind::Pointer:
            return _FSTD::forward<Visitor>(visitor)(arg.m_pointer);
        case FormatArgKind::Handle:
            return _FSTD::forward<Visitor>(visitor)(arg.m_handle);
        case FormatArgKind::None:
            break;
        }
        return _FSTD::forward<Visitor>(visitor)(arg.m_none);
    }

    template <class Context, class T> static basic_format_arg<Context> Make(T value) noexcept
    {
        return basic_format_arg<Context>(value);
    }

    template <class Context, class T> static basic_format_arg<Context> MakeHandle(T& value) noexcept
    {
        using Plain = remove_const_t<T>;
        using Qualified =
            conditional_t<requires(const formatter<Plain, typename Context::char_type>& f,
                                   const Plain& v, Context& c) { f.format(v, c); },
                          const Plain, Plain>;
        const auto function = [](basic_format_parse_context<typename Context::char_type>& parse,
                                 Context& context, const void* pointer)
        {
            typename Context::template formatter_type<Plain> formatter;
            parse.advance_to(formatter.parse(parse));
            auto& target = *const_cast<Qualified*>(static_cast<const Plain*>(pointer));
            context.advance_to(formatter.format(target, context));
        };
        return basic_format_arg<Context>(
            typename basic_format_arg<Context>::handle(__builtin_addressof(value), function));
    }
};

} // namespace __detail

template <class Visitor, class Context>
decltype(auto) visit_format_arg(Visitor&& visitor, basic_format_arg<Context> arg)
{
    return __detail::FormatArgAccess::Visit(_FSTD::forward<Visitor>(visitor), arg);
}

// The format spec parser and the formatters' checks.
namespace __detail
{

constexpr bool IsFormatDigit(char character)
{
    return character >= '0' && character <= '9';
}

constexpr int ParseFormatInteger(const char*& cursor, const char* end)
{
    long long value = 0;
    for (; cursor != end && IsFormatDigit(*cursor); ++cursor)
    {
        value = value * 10 + (*cursor - '0');
        if (value > numeric_limits<int>::max())
        {
            FormatError("a number in the format string is too large");
        }
    }
    return static_cast<int>(value);
}

// arg-id: 0, or a positive integer without leading zeros.
constexpr size_t ParseFormatArgumentId(const char*& cursor, const char* end)
{
    if (*cursor == '0')
    {
        ++cursor;
        return 0;
    }
    return static_cast<size_t>(ParseFormatInteger(cursor, end));
}

template <class CharT>
constexpr int ParseDynamicArgument(basic_format_parse_context<CharT>& context, const char*& cursor,
                                   const char* end)
{
    size_t id = 0;
    if (cursor != end && *cursor == '}')
    {
        id = context.next_arg_id();
    }
    else if (cursor != end && IsFormatDigit(*cursor))
    {
        id = ParseFormatArgumentId(cursor, end);
        context.check_arg_id(id);
    }
    else
    {
        FormatError("invalid argument index for a width or precision");
    }
    if (cursor == end || *cursor != '}')
    {
        FormatError("a width or precision argument is missing its '}'");
    }
    ++cursor;
    FormatParseAccess::CheckDynamicArgument(context, id);
    return static_cast<int>(id);
}

constexpr FormatAlign FormatAlignOf(char character)
{
    switch (character)
    {
    case '<':
        return FormatAlign::Left;
    case '^':
        return FormatAlign::Center;
    case '>':
        return FormatAlign::Right;
    default:
        return FormatAlign::Default;
    }
}

// A fill is any UTF-8 character but '{' and '}'; in range and tuple specs ':' is not one either,
// as it starts the elements' spec.
constexpr void ParseFormatFillAndAlign(const char*& cursor, const char* end, FormatSpec& spec,
                                       bool colon_is_fill)
{
    if (!colon_is_fill && *cursor == ':')
    {
        return;
    }
    const Utf8Decoded fill = DecodeUtf8(cursor, end);
    if (fill.length != 0 && static_cast<size_t>(end - cursor) > fill.length &&
        FormatAlignOf(cursor[fill.length]) != FormatAlign::Default)
    {
        if (*cursor == '{' || *cursor == '}')
        {
            FormatError("'{' and '}' cannot be fill characters");
        }
        for (size_t index = 0; index != fill.length; ++index)
        {
            spec.fill[index] = cursor[index];
        }
        spec.fill_size = static_cast<unsigned char>(fill.length);
        spec.align = FormatAlignOf(cursor[fill.length]);
        cursor += fill.length + 1;
    }
    else if (FormatAlignOf(*cursor) != FormatAlign::Default)
    {
        spec.align = FormatAlignOf(*cursor);
        ++cursor;
    }
    else if (fill.length == 0 && cursor + 1 != end &&
             FormatAlignOf(cursor[1]) != FormatAlign::Default)
    {
        FormatError("the fill character is not valid UTF-8");
    }
}

template <class CharT>
constexpr void ParseFormatWidth(basic_format_parse_context<CharT>& context, const char*& cursor,
                                const char* end, FormatSpec& spec)
{
    if (cursor != end && *cursor == '0')
    {
        FormatError("a width cannot start with 0");
    }
    if (cursor != end && IsFormatDigit(*cursor))
    {
        spec.width = ParseFormatInteger(cursor, end);
    }
    else if (cursor != end && *cursor == '{')
    {
        ++cursor;
        spec.width_argument = ParseDynamicArgument(context, cursor, end);
    }
}

template <class CharT>
constexpr void ParseFormatPrecision(basic_format_parse_context<CharT>& context, const char*& cursor,
                                    const char* end, FormatSpec& spec)
{
    if (cursor == end || *cursor != '.')
    {
        return;
    }
    ++cursor;
    if (cursor != end && IsFormatDigit(*cursor))
    {
        spec.precision = ParseFormatInteger(cursor, end);
    }
    else if (cursor != end && *cursor == '{')
    {
        ++cursor;
        spec.precision_argument = ParseDynamicArgument(context, cursor, end);
    }
    else
    {
        FormatError("a precision is missing after '.'");
    }
}

// [[fill]align][sign][#][0][width][.precision][L][type], up to the closing '}'.
template <class CharT>
constexpr const char* ParseFormatSpec(basic_format_parse_context<CharT>& context, FormatSpec& spec)
{
    static_assert(is_same_v<CharT, char>, "only char formatting is supported");
    const char* cursor = context.begin();
    const char* const end = context.end();
    if (cursor == end || *cursor == '}')
    {
        return cursor;
    }
    ParseFormatFillAndAlign(cursor, end, spec, true);
    if (cursor != end && (*cursor == '+' || *cursor == '-' || *cursor == ' '))
    {
        spec.sign = *cursor == '+'   ? FormatSign::Plus
                    : *cursor == '-' ? FormatSign::Minus
                                     : FormatSign::Space;
        ++cursor;
    }
    if (cursor != end && *cursor == '#')
    {
        spec.alternate = true;
        ++cursor;
    }
    if (cursor != end && *cursor == '0')
    {
        spec.zero = true;
        ++cursor;
    }
    ParseFormatWidth(context, cursor, end, spec);
    ParseFormatPrecision(context, cursor, end, spec);
    if (cursor != end && *cursor == 'L')
    {
        spec.locale = true;
        ++cursor;
    }
    if (cursor != end && *cursor != '}')
    {
        spec.type = *cursor++;
    }
    if (cursor != end && *cursor != '}')
    {
        FormatError("invalid format specification");
    }
    return cursor;
}

// The range and tuple spec: [[fill]align][width], then for a range [n][m|s|?s][:elements' spec]
// and for a tuple [m|n]. type is '\0', 'm', 'n' (a tuple's), 's' or '?' (for ?s).
struct CompositeSpec
{
    const char* end;
    char type;
    bool no_brackets;
    bool element_spec;
};

template <class CharT>
constexpr CompositeSpec ParseCompositeSpec(basic_format_parse_context<CharT>& context,
                                           FormatSpec& spec, bool range)
{
    static_assert(is_same_v<CharT, char>, "only char formatting is supported");
    const char* cursor = context.begin();
    const char* const end = context.end();
    CompositeSpec parsed = {cursor, '\0', false, false};
    if (cursor == end || *cursor == '}')
    {
        return parsed;
    }
    ParseFormatFillAndAlign(cursor, end, spec, false);
    ParseFormatWidth(context, cursor, end, spec);
    if (range && cursor != end && *cursor == 'n')
    {
        parsed.no_brackets = true;
        ++cursor;
    }
    if (cursor != end &&
        (*cursor == 'm' || (range && *cursor == 's') || (!range && *cursor == 'n')))
    {
        parsed.type = *cursor++;
    }
    else if (range && cursor != end && *cursor == '?')
    {
        ++cursor;
        if (cursor == end || *cursor != 's')
        {
            FormatError("'?' in a range's format specification must be followed by 's'");
        }
        parsed.type = '?';
        ++cursor;
    }
    if (range && cursor != end && *cursor == ':')
    {
        parsed.element_spec = true;
        ++cursor;
    }
    else if (cursor != end && *cursor != '}')
    {
        FormatError("invalid format specification");
    }
    parsed.end = cursor;
    return parsed;
}

enum FormatOption : unsigned
{
    FormatAllowsSign = 1,
    FormatAllowsAlternate = 2,
    FormatAllowsZero = 4,
    FormatAllowsPrecision = 8,
    FormatAllowsLocale = 16,
    FormatNumeric = FormatAllowsSign | FormatAllowsAlternate | FormatAllowsZero |
        FormatAllowsLocale,
};

constexpr void CheckFormatSpec(const FormatSpec& spec, const char* types, unsigned options)
{
    if (spec.type != '\0')
    {
        bool known = false;
        for (const char* type = types; *type != '\0'; ++type)
        {
            known = known || *type == spec.type;
        }
        if (!known)
        {
            FormatError("the format specification's type does not suit the argument");
        }
    }
    if (spec.sign != FormatSign::Default && (options & FormatAllowsSign) == 0)
    {
        FormatError("the sign option does not suit the argument");
    }
    if (spec.alternate && (options & FormatAllowsAlternate) == 0)
    {
        FormatError("the '#' option does not suit the argument");
    }
    if (spec.zero && (options & FormatAllowsZero) == 0)
    {
        FormatError("the '0' option does not suit the argument");
    }
    if ((spec.precision >= 0 || spec.precision_argument >= 0) &&
        (options & FormatAllowsPrecision) == 0)
    {
        FormatError("a precision does not suit the argument");
    }
    if (spec.locale && (options & FormatAllowsLocale) == 0)
    {
        FormatError("the 'L' option does not suit the argument");
    }
}

constexpr bool IsIntegerPresentation(char type)
{
    return type == 'b' || type == 'B' || type == 'd' || type == 'o' || type == 'x' || type == 'X';
}

// The standard formatters' run-time half, in featheros_cxx. Each resolves a width or precision
// taken from an argument first.
void FormatIntegerValue(format_context& context, const FormatSpec& spec,
                        unsigned long long magnitude, bool negative);
void FormatCharValue(format_context& context, const FormatSpec& spec, char value);
void FormatBoolValue(format_context& context, const FormatSpec& spec, bool value);
void FormatStringValue(format_context& context, const FormatSpec& spec, string_view value);
void FormatPointerValue(format_context& context, const FormatSpec& spec, const void* value);
void FormatFloatValue(format_context& context, const FormatSpec& spec, float value);
void FormatFloatValue(format_context& context, const FormatSpec& spec, double value);
void FormatFloatValue(format_context& context, const FormatSpec& spec, long double value);

// Padding needs the whole text first, so with a width body runs into a string.
using FormatBody = void (*)(format_context& context, const void* state);
