// -*- C++ -*-
#ifndef FEATHEROS_LIBCXX_MAP
#define FEATHEROS_LIBCXX_MAP

#include "__featheros_config"
#include "__iterator_base"
#include "__node_handle"
#include "__tree"
#include "algorithm"
#include "compare"
#include "functional"
#include "initializer_list"
#include "iterator"
#include "memory"
#include "tuple"
#include "type_traits"
#include "utility"

// Left out: pmr::map and pmr::multimap, and C++26's heterogeneous insert, try_emplace and
// operator[]. at() of a missing key (out_of_range) calls the library's abort hook.

namespace FEATHEROS_STD_NAMESPACE
{

template <class Key, class T, class Compare = less<Key>,
          class Allocator = allocator<pair<const Key, T>>>
class map;
template <class Key, class T, class Compare = less<Key>,
          class Allocator = allocator<pair<const Key, T>>>
class multimap;

template <class Key, class T, class Compare, class Allocator> class map
{
    using Tree = __detail::Tree<pair<const Key, T>, __detail::MapKey<Key, T>, Compare, Allocator>;
    template <class, class, class, class> friend class map;
    template <class, class, class, class> friend class multimap;

public:
    using key_type = Key;
    using mapped_type = T;
    using value_type = pair<const Key, T>;
    using key_compare = Compare;
    using allocator_type = Allocator;
    using pointer = typename allocator_traits<Allocator>::pointer;
    using const_pointer = typename allocator_traits<Allocator>::const_pointer;
    using reference = value_type&;
    using const_reference = const value_type&;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using iterator = typename Tree::iterator;
    using const_iterator = typename Tree::const_iterator;
    using reverse_iterator = _FSTD::reverse_iterator<iterator>;
    using const_reverse_iterator = _FSTD::reverse_iterator<const_iterator>;
    using node_type = __detail::NodeHandle<typename Tree::Node, Allocator, true>;
    using insert_return_type = __detail::InsertReturnType<iterator, node_type>;

    static_assert(is_same_v<typename Allocator::value_type, value_type>,
                  "map's allocator must allocate its value_type");

    class value_compare
    {
        friend class map;

    public:
        bool operator()(const value_type& left, const value_type& right) const
        {
            return comp(left.first, right.first);
        }

    protected:
        Compare comp;
        value_compare(Compare compare) : comp(_FSTD::move(compare)) {}
    };

    map() : map(Compare()) {}
    explicit map(const Compare& compare, const Allocator& allocator = Allocator())
        : m_tree(compare, allocator)
    {
    }
    explicit map(const Allocator& allocator) : m_tree(Compare(), allocator) {}

    template <__detail::ClassicInput I>
    map(I first, I last, const Compare& compare = Compare(),
        const Allocator& allocator = Allocator())
        : m_tree(compare, allocator)
    {
        insert(first, last);
    }
    template <__detail::ClassicInput I>
    map(I first, I last, const Allocator& allocator) : map(first, last, Compare(), allocator)
    {
    }

    template <__detail::ContainerCompatibleRange<pair<const Key, T>> R>
    map(from_range_t, R&& range, const Compare& compare = Compare(),
        const Allocator& allocator = Allocator())
        : m_tree(compare, allocator)
    {
        insert_range(_FSTD::forward<R>(range));
    }
    template <__detail::ContainerCompatibleRange<pair<const Key, T>> R>
    map(from_range_t, R&& range, const Allocator& allocator)
        : map(from_range, _FSTD::forward<R>(range), Compare(), allocator)
    {
    }

    map(const map& other)
        : m_tree(other.m_tree, allocator_traits<Allocator>::select_on_container_copy_construction(
                                   other.get_allocator()))
    {
    }
    map(map&& other) noexcept : m_tree(_FSTD::move(other.m_tree)) {}
    map(const map& other, const type_identity_t<Allocator>& allocator)
        : m_tree(other.m_tree, allocator)
    {
    }
    map(map&& other, const type_identity_t<Allocator>& allocator)
        : m_tree(_FSTD::move(other.m_tree), allocator)
    {
    }

    map(initializer_list<value_type> values, const Compare& compare = Compare(),
        const Allocator& allocator = Allocator())
        : m_tree(compare, allocator)
    {
        insert(values.begin(), values.end());
    }
    map(initializer_list<value_type> values, const Allocator& allocator)
        : map(values, Compare(), allocator)
    {
    }

    ~map() = default;

    map& operator=(const map& other)
    {
        m_tree.CopyAssign(other.m_tree);
        return *this;
    }
    map& operator=(map&& other) noexcept(noexcept(declval<Tree&>().MoveAssign(declval<Tree&>())) &&
                                         is_nothrow_move_assignable_v<Compare>)
    {
        m_tree.MoveAssign(other.m_tree);
        return *this;
    }
    map& operator=(initializer_list<value_type> values)
    {
        clear();
        insert(values.begin(), values.end());
        return *this;
    }

    allocator_type get_allocator() const noexcept
    {
        return m_tree.GetAllocator();
    }

    iterator begin() noexcept
    {
        return m_tree.Begin();
    }
    const_iterator begin() const noexcept
    {
        return m_tree.Begin();
    }
    iterator end() noexcept
    {
        return m_tree.End();
    }
    const_iterator end() const noexcept
    {
        return m_tree.End();
    }
    reverse_iterator rbegin() noexcept
    {
        return reverse_iterator(end());
    }
    const_reverse_iterator rbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    reverse_iterator rend() noexcept
    {
        return reverse_iterator(begin());
    }
    const_reverse_iterator rend() const noexcept
    {
        return const_reverse_iterator(begin());
    }
    const_iterator cbegin() const noexcept
    {
        return begin();
    }
    const_iterator cend() const noexcept
    {
        return end();
    }
    const_reverse_iterator crbegin() const noexcept
    {
        return rbegin();
    }
    const_reverse_iterator crend() const noexcept
    {
        return rend();
    }

    [[nodiscard]] bool empty() const noexcept
    {
        return m_tree.Size() == 0;
    }
    size_type size() const noexcept
    {
        return m_tree.Size();
    }
    size_type max_size() const noexcept
    {
        return m_tree.MaxSize();
    }

    mapped_type& operator[](const key_type& key)
    {
        return try_emplace(key).first->second;
    }
    mapped_type& operator[](key_type&& key)
    {
        return try_emplace(_FSTD::move(key)).first->second;
    }
    mapped_type& at(const key_type& key)
    {
        const iterator position = find(key);
        if (position == end())
        {
            __detail::LibraryAbort("map::at: the key is not in the map");
        }
        return position->second;
    }
    const mapped_type& at(const key_type& key) const
    {
        const const_iterator position = find(key);
        if (position == end())
        {
            __detail::LibraryAbort("map::at: the key is not in the map");
        }
        return position->second;
    }

    template <class... Args> pair<iterator, bool> emplace(Args&&... args)
    {
        return Emplace(_FSTD::forward<Args>(args)...);
    }
    template <class... Args> iterator emplace_hint(const_iterator hint, Args&&... args)
    {
        return EmplaceHint(hint, _FSTD::forward<Args>(args)...);
    }

    pair<iterator, bool> insert(const value_type& value)
    {
        return m_tree.EmplaceUniqueKey(value.first, value);
    }
    pair<iterator, bool> insert(value_type&& value)
    {
        return m_tree.EmplaceUniqueKey(value.first, _FSTD::move(value));
    }
    template <class P>
        requires is_constructible_v<value_type, P&&>
    pair<iterator, bool> insert(P&& value)
    {
        return emplace(_FSTD::forward<P>(value));
    }
    iterator insert(const_iterator hint, const value_type& value)
    {
        return m_tree.EmplaceHintUniqueKey(hint, value.first, value);
    }
    iterator insert(const_iterator hint, value_type&& value)
    {
        return m_tree.EmplaceHintUniqueKey(hint, value.first, _FSTD::move(value));
    }
    template <class P>
        requires is_constructible_v<value_type, P&&>
    iterator insert(const_iterator hint, P&& value)
    {
        return emplace_hint(hint, _FSTD::forward<P>(value));
    }
    template <__detail::ClassicInput I> void insert(I first, I last)
    {
        for (; first != last; ++first)
        {
            emplace_hint(end(), *first);
        }
    }
    void insert(initializer_list<value_type> values)
    {
        insert(values.begin(), values.end());
    }
    template <__detail::ContainerCompatibleRange<value_type> R> void insert_range(R&& range)
    {
        for (auto&& value : range)
        {
            emplace_hint(end(), _FSTD::forward<decltype(value)>(value));
        }
    }

    insert_return_type insert(node_type&& node)
    {
        if (node.empty())
        {
            return {end(), false, node_type()};
        }
        const auto [position, inserted] = m_tree.InsertNodeUnique(node.Peek());
        if (inserted)
        {
            node.Take();
            return {position, true, node_type()};
        }
        return {position, false, _FSTD::move(node)};
    }
    iterator insert(const_iterator hint, node_type&& node)
    {
        if (node.empty())
        {
            return end();
        }
        const auto [position, inserted] = m_tree.InsertNodeHintUnique(hint, node.Peek());
        if (inserted)
        {
            node.Take();
        }
        return position;
    }

    template <class... Args> pair<iterator, bool> try_emplace(const key_type& key, Args&&... args)
    {
        return m_tree.EmplaceUniqueKey(key, piecewise_construct, _FSTD::forward_as_tuple(key),
                                       _FSTD::forward_as_tuple(_FSTD::forward<Args>(args)...));
    }
    template <class... Args> pair<iterator, bool> try_emplace(key_type&& key, Args&&... args)
    {
        return m_tree.EmplaceUniqueKey(key, piecewise_construct,
                                       _FSTD::forward_as_tuple(_FSTD::move(key)),
                                       _FSTD::forward_as_tuple(_FSTD::forward<Args>(args)...));
    }
    template <class... Args>
    iterator try_emplace(const_iterator hint, const key_type& key, Args&&... args)
    {
        return m_tree.EmplaceHintUniqueKey(hint, key, piecewise_construct,
                                           _FSTD::forward_as_tuple(key),
                                           _FSTD::forward_as_tuple(_FSTD::forward<Args>(args)...));
    }
    template <class... Args>
    iterator try_emplace(const_iterator hint, key_type&& key, Args&&... args)
    {
        return m_tree.EmplaceHintUniqueKey(hint, key, piecewise_construct,
                                           _FSTD::forward_as_tuple(_FSTD::move(key)),
                                           _FSTD::forward_as_tuple(_FSTD::forward<Args>(args)...));
    }

    template <class M> pair<iterator, bool> insert_or_assign(const key_type& key, M&& value)
    {
        auto result = try_emplace(key, _FSTD::forward<M>(value));
        if (!result.second)
        {
            result.first->second = _FSTD::forward<M>(value);
        }
        return result;
    }
    template <class M> pair<iterator, bool> insert_or_assign(key_type&& key, M&& value)
    {
        auto result = try_emplace(_FSTD::move(key), _FSTD::forward<M>(value));
        if (!result.second)
        {
            result.first->second = _FSTD::forward<M>(value);
        }
        return result;
    }
    template <class M>
    iterator insert_or_assign(const_iterator hint, const key_type& key, M&& value)
    {
        const size_type before = size();
        const iterator position = try_emplace(hint, key, _FSTD::forward<M>(value));
        if (size() == before)
        {
            position->second = _FSTD::forward<M>(value);
        }
        return position;
    }
    template <class M> iterator insert_or_assign(const_iterator hint, key_type&& key, M&& value)
    {
        const size_type before = size();
        const iterator position = try_emplace(hint, _FSTD::move(key), _FSTD::forward<M>(value));
        if (size() == before)
        {
            position->second = _FSTD::forward<M>(value);
        }
        return position;
    }

    iterator erase(iterator position)
    {
        return m_tree.Erase(position);
    }
    iterator erase(const_iterator position)
    {
        return m_tree.Erase(position);
    }
    size_type erase(const key_type& key)
    {
        return m_tree.EraseKey(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare> && (!is_convertible_v<K&&, iterator>) &&
                 (!is_convertible_v<K&&, const_iterator>)
    size_type erase(K&& key)
    {
        return m_tree.EraseKey(key);
    }
    iterator erase(const_iterator first, const_iterator last)
    {
        return m_tree.Erase(first, last);
    }

    node_type extract(const_iterator position)
    {
        return node_type(m_tree.Extract(position), get_allocator());
    }
    node_type extract(const key_type& key)
    {
        const iterator position = find(key);
        return position == end() ? node_type() : extract(position);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare> && (!is_convertible_v<K&&, iterator>) &&
                 (!is_convertible_v<K&&, const_iterator>)
    node_type extract(K&& key)
    {
        const iterator position = find(key);
        return position == end() ? node_type() : extract(position);
    }

    template <class C> void merge(map<Key, T, C, Allocator>& source)
    {
        m_tree.MergeUnique(source.m_tree);
    }
    template <class C> void merge(map<Key, T, C, Allocator>&& source)
    {
        m_tree.MergeUnique(source.m_tree);
    }
    template <class C> void merge(multimap<Key, T, C, Allocator>& source)
    {
        m_tree.MergeUnique(source.m_tree);
    }
    template <class C> void merge(multimap<Key, T, C, Allocator>&& source)
    {
        m_tree.MergeUnique(source.m_tree);
    }

    void swap(map& other) noexcept(noexcept(declval<Tree&>().Swap(declval<Tree&>())))
    {
        m_tree.Swap(other.m_tree);
    }
    void clear() noexcept
    {
        m_tree.Clear();
    }

    key_compare key_comp() const
    {
        return m_tree.KeyCompare();
    }
    value_compare value_comp() const
    {
        return value_compare(m_tree.KeyCompare());
    }

    iterator find(const key_type& key)
    {
        return m_tree.Find(key);
    }
    const_iterator find(const key_type& key) const
    {
        return m_tree.Find(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    iterator find(const K& key)
    {
        return m_tree.Find(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    const_iterator find(const K& key) const
    {
        return m_tree.Find(key);
    }

    size_type count(const key_type& key) const
    {
        return m_tree.CountUnique(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    size_type count(const K& key) const
    {
        return m_tree.CountMulti(key);
    }

    bool contains(const key_type& key) const
    {
        return find(key) != end();
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    bool contains(const K& key) const
    {
        return find(key) != end();
    }

    iterator lower_bound(const key_type& key)
    {
        return m_tree.LowerBound(key);
    }
    const_iterator lower_bound(const key_type& key) const
    {
        return m_tree.LowerBound(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    iterator lower_bound(const K& key)
    {
        return m_tree.LowerBound(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    const_iterator lower_bound(const K& key) const
    {
        return m_tree.LowerBound(key);
    }

    iterator upper_bound(const key_type& key)
    {
        return m_tree.UpperBound(key);
    }
    const_iterator upper_bound(const key_type& key) const
    {
        return m_tree.UpperBound(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    iterator upper_bound(const K& key)
    {
        return m_tree.UpperBound(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    const_iterator upper_bound(const K& key) const
    {
        return m_tree.UpperBound(key);
    }

    pair<iterator, iterator> equal_range(const key_type& key)
    {
        return m_tree.EqualRange(key);
    }
    pair<const_iterator, const_iterator> equal_range(const key_type& key) const
    {
        return m_tree.EqualRange(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    pair<iterator, iterator> equal_range(const K& key)
    {
        return m_tree.EqualRange(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    pair<const_iterator, const_iterator> equal_range(const K& key) const
    {
        return m_tree.EqualRange(key);
    }

private:
    Tree m_tree;

    template <class... Args> pair<iterator, bool> Emplace(Args&&... args)
    {
        return m_tree.EmplaceUnique(_FSTD::forward<Args>(args)...);
    }
    // The key is at hand without building a node first.
    template <class K, class M>
        requires is_same_v<remove_cvref_t<K>, Key>
    pair<iterator, bool> Emplace(K&& key, M&& mapped)
    {
        return m_tree.EmplaceUniqueKey(key, _FSTD::forward<K>(key), _FSTD::forward<M>(mapped));
    }
    template <__detail::PairWithKey<Key> P> pair<iterator, bool> Emplace(P&& value)
    {
        return m_tree.EmplaceUniqueKey(value.first, _FSTD::forward<P>(value));
    }

    template <class... Args> iterator EmplaceHint(const_iterator hint, Args&&... args)
    {
        return m_tree.EmplaceHintUnique(hint, _FSTD::forward<Args>(args)...);
    }
    template <class K, class M>
        requires is_same_v<remove_cvref_t<K>, Key>
    iterator EmplaceHint(const_iterator hint, K&& key, M&& mapped)
    {
        return m_tree.EmplaceHintUniqueKey(hint, key, _FSTD::forward<K>(key),
                                           _FSTD::forward<M>(mapped));
    }
    template <__detail::PairWithKey<Key> P> iterator EmplaceHint(const_iterator hint, P&& value)
    {
        return m_tree.EmplaceHintUniqueKey(hint, value.first, _FSTD::forward<P>(value));
    }
};

template <class Key, class T, class Compare, class Allocator> class multimap
{
    using Tree = __detail::Tree<pair<const Key, T>, __detail::MapKey<Key, T>, Compare, Allocator>;
    template <class, class, class, class> friend class map;
    template <class, class, class, class> friend class multimap;

public:
    using key_type = Key;
    using mapped_type = T;
    using value_type = pair<const Key, T>;
    using key_compare = Compare;
    using allocator_type = Allocator;
    using pointer = typename allocator_traits<Allocator>::pointer;
    using const_pointer = typename allocator_traits<Allocator>::const_pointer;
    using reference = value_type&;
    using const_reference = const value_type&;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using iterator = typename Tree::iterator;
    using const_iterator = typename Tree::const_iterator;
    using reverse_iterator = _FSTD::reverse_iterator<iterator>;
    using const_reverse_iterator = _FSTD::reverse_iterator<const_iterator>;
    using node_type = __detail::NodeHandle<typename Tree::Node, Allocator, true>;

    static_assert(is_same_v<typename Allocator::value_type, value_type>,
                  "multimap's allocator must allocate its value_type");

    class value_compare
    {
        friend class multimap;

    public:
        bool operator()(const value_type& left, const value_type& right) const
        {
            return comp(left.first, right.first);
        }

    protected:
        Compare comp;
        value_compare(Compare compare) : comp(_FSTD::move(compare)) {}
    };

    multimap() : multimap(Compare()) {}
    explicit multimap(const Compare& compare, const Allocator& allocator = Allocator())
        : m_tree(compare, allocator)
    {
    }
    explicit multimap(const Allocator& allocator) : m_tree(Compare(), allocator) {}

    template <__detail::ClassicInput I>
    multimap(I first, I last, const Compare& compare = Compare(),
             const Allocator& allocator = Allocator())
        : m_tree(compare, allocator)
    {
        insert(first, last);
    }
    template <__detail::ClassicInput I>
    multimap(I first, I last, const Allocator& allocator)
        : multimap(first, last, Compare(), allocator)
    {
    }

    template <__detail::ContainerCompatibleRange<pair<const Key, T>> R>
    multimap(from_range_t, R&& range, const Compare& compare = Compare(),
             const Allocator& allocator = Allocator())
        : m_tree(compare, allocator)
    {
        insert_range(_FSTD::forward<R>(range));
    }
    template <__detail::ContainerCompatibleRange<pair<const Key, T>> R>
    multimap(from_range_t, R&& range, const Allocator& allocator)
        : multimap(from_range, _FSTD::forward<R>(range), Compare(), allocator)
    {
    }

    multimap(const multimap& other)
        : m_tree(other.m_tree, allocator_traits<Allocator>::select_on_container_copy_construction(
                                   other.get_allocator()))
    {
    }
    multimap(multimap&& other) noexcept : m_tree(_FSTD::move(other.m_tree)) {}
    multimap(const multimap& other, const type_identity_t<Allocator>& allocator)
        : m_tree(other.m_tree, allocator)
    {
    }
    multimap(multimap&& other, const type_identity_t<Allocator>& allocator)
        : m_tree(_FSTD::move(other.m_tree), allocator)
    {
    }

    multimap(initializer_list<value_type> values, const Compare& compare = Compare(),
             const Allocator& allocator = Allocator())
        : m_tree(compare, allocator)
    {
        insert(values.begin(), values.end());
    }
    multimap(initializer_list<value_type> values, const Allocator& allocator)
        : multimap(values, Compare(), allocator)
    {
    }

    ~multimap() = default;

    multimap& operator=(const multimap& other)
    {
        m_tree.CopyAssign(other.m_tree);
        return *this;
    }
    multimap&
    operator=(multimap&& other) noexcept(noexcept(declval<Tree&>().MoveAssign(declval<Tree&>())) &&
                                         is_nothrow_move_assignable_v<Compare>)
    {
        m_tree.MoveAssign(other.m_tree);
        return *this;
    }
    multimap& operator=(initializer_list<value_type> values)
    {
        clear();
        insert(values.begin(), values.end());
        return *this;
    }

    allocator_type get_allocator() const noexcept
    {
        return m_tree.GetAllocator();
    }

    iterator begin() noexcept
    {
        return m_tree.Begin();
    }
    const_iterator begin() const noexcept
    {
        return m_tree.Begin();
    }
    iterator end() noexcept
    {
        return m_tree.End();
    }
    const_iterator end() const noexcept
    {
        return m_tree.End();
    }
    reverse_iterator rbegin() noexcept
    {
        return reverse_iterator(end());
    }
    const_reverse_iterator rbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    reverse_iterator rend() noexcept
    {
        return reverse_iterator(begin());
    }
    const_reverse_iterator rend() const noexcept
    {
        return const_reverse_iterator(begin());
    }
    const_iterator cbegin() const noexcept
    {
        return begin();
    }
    const_iterator cend() const noexcept
    {
        return end();
    }
    const_reverse_iterator crbegin() const noexcept
    {
        return rbegin();
    }
    const_reverse_iterator crend() const noexcept
    {
        return rend();
    }

    [[nodiscard]] bool empty() const noexcept
    {
        return m_tree.Size() == 0;
    }
    size_type size() const noexcept
    {
        return m_tree.Size();
    }
    size_type max_size() const noexcept
    {
        return m_tree.MaxSize();
    }

    template <class... Args> iterator emplace(Args&&... args)
    {
        return m_tree.EmplaceMulti(_FSTD::forward<Args>(args)...);
    }
    template <class... Args> iterator emplace_hint(const_iterator hint, Args&&... args)
    {
        return m_tree.EmplaceHintMulti(hint, _FSTD::forward<Args>(args)...);
    }

    iterator insert(const value_type& value)
    {
        return emplace(value);
    }
    iterator insert(value_type&& value)
    {
        return emplace(_FSTD::move(value));
    }
    template <class P>
        requires is_constructible_v<value_type, P&&>
    iterator insert(P&& value)
    {
        return emplace(_FSTD::forward<P>(value));
    }
    iterator insert(const_iterator hint, const value_type& value)
    {
        return emplace_hint(hint, value);
    }
    iterator insert(const_iterator hint, value_type&& value)
    {
        return emplace_hint(hint, _FSTD::move(value));
    }
    template <class P>
        requires is_constructible_v<value_type, P&&>
    iterator insert(const_iterator hint, P&& value)
    {
        return emplace_hint(hint, _FSTD::forward<P>(value));
    }
    template <__detail::ClassicInput I> void insert(I first, I last)
    {
        for (; first != last; ++first)
        {
            emplace_hint(end(), *first);
        }
    }
    void insert(initializer_list<value_type> values)
    {
        insert(values.begin(), values.end());
    }
    template <__detail::ContainerCompatibleRange<value_type> R> void insert_range(R&& range)
    {
        for (auto&& value : range)
        {
            emplace_hint(end(), _FSTD::forward<decltype(value)>(value));
        }
    }

    iterator insert(node_type&& node)
    {
        if (node.empty())
        {
            return end();
        }
        return m_tree.InsertNodeMulti(node.Take());
    }
    iterator insert(const_iterator hint, node_type&& node)
    {
        if (node.empty())
        {
            return end();
        }
        return m_tree.InsertNodeHintMulti(hint, node.Take());
    }

    iterator erase(iterator position)
    {
        return m_tree.Erase(position);
    }
    iterator erase(const_iterator position)
    {
        return m_tree.Erase(position);
    }
    size_type erase(const key_type& key)
    {
        return m_tree.EraseKey(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare> && (!is_convertible_v<K&&, iterator>) &&
                 (!is_convertible_v<K&&, const_iterator>)
    size_type erase(K&& key)
    {
        return m_tree.EraseKey(key);
    }
    iterator erase(const_iterator first, const_iterator last)
    {
        return m_tree.Erase(first, last);
    }

    node_type extract(const_iterator position)
    {
        return node_type(m_tree.Extract(position), get_allocator());
    }
    node_type extract(const key_type& key)
    {
        const iterator position = find(key);
        return position == end() ? node_type() : extract(position);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare> && (!is_convertible_v<K&&, iterator>) &&
                 (!is_convertible_v<K&&, const_iterator>)
    node_type extract(K&& key)
    {
        const iterator position = find(key);
        return position == end() ? node_type() : extract(position);
    }

    template <class C> void merge(multimap<Key, T, C, Allocator>& source)
    {
        m_tree.MergeMulti(source.m_tree);
    }
    template <class C> void merge(multimap<Key, T, C, Allocator>&& source)
    {
        m_tree.MergeMulti(source.m_tree);
    }
    template <class C> void merge(map<Key, T, C, Allocator>& source)
    {
        m_tree.MergeMulti(source.m_tree);
    }
    template <class C> void merge(map<Key, T, C, Allocator>&& source)
    {
        m_tree.MergeMulti(source.m_tree);
    }

    void swap(multimap& other) noexcept(noexcept(declval<Tree&>().Swap(declval<Tree&>())))
    {
        m_tree.Swap(other.m_tree);
    }
    void clear() noexcept
    {
        m_tree.Clear();
    }

    key_compare key_comp() const
    {
        return m_tree.KeyCompare();
    }
    value_compare value_comp() const
    {
        return value_compare(m_tree.KeyCompare());
    }

    iterator find(const key_type& key)
    {
        return m_tree.Find(key);
    }
    const_iterator find(const key_type& key) const
    {
        return m_tree.Find(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    iterator find(const K& key)
    {
        return m_tree.Find(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    const_iterator find(const K& key) const
    {
        return m_tree.Find(key);
    }

    size_type count(const key_type& key) const
    {
        return m_tree.CountMulti(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    size_type count(const K& key) const
    {
        return m_tree.CountMulti(key);
    }

    bool contains(const key_type& key) const
    {
        return find(key) != end();
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    bool contains(const K& key) const
    {
        return find(key) != end();
    }

    iterator lower_bound(const key_type& key)
    {
        return m_tree.LowerBound(key);
    }
    const_iterator lower_bound(const key_type& key) const
    {
        return m_tree.LowerBound(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    iterator lower_bound(const K& key)
    {
        return m_tree.LowerBound(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    const_iterator lower_bound(const K& key) const
    {
        return m_tree.LowerBound(key);
    }

    iterator upper_bound(const key_type& key)
    {
        return m_tree.UpperBound(key);
    }
    const_iterator upper_bound(const key_type& key) const
    {
        return m_tree.UpperBound(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    iterator upper_bound(const K& key)
    {
        return m_tree.UpperBound(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    const_iterator upper_bound(const K& key) const
    {
        return m_tree.UpperBound(key);
    }

    pair<iterator, iterator> equal_range(const key_type& key)
    {
        return m_tree.EqualRange(key);
    }
    pair<const_iterator, const_iterator> equal_range(const key_type& key) const
    {
        return m_tree.EqualRange(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    pair<iterator, iterator> equal_range(const K& key)
    {
        return m_tree.EqualRange(key);
    }
    template <class K>
        requires __detail::TransparentCompare<Compare>
    pair<const_iterator, const_iterator> equal_range(const K& key) const
    {
        return m_tree.EqualRange(key);
    }

private:
    Tree m_tree;
};

#define FEATHEROS_MAP_FREE_FUNCTIONS(Map)                                                          \
    template <class Key, class T, class Compare, class Allocator>                                  \
    bool operator==(const Map<Key, T, Compare, Allocator>& left,                                   \
                    const Map<Key, T, Compare, Allocator>& right)                                  \
    {                                                                                              \
        return left.size() == right.size() &&                                                      \
               _FSTD::equal(left.begin(), left.end(), right.begin());                              \
    }                                                                                              \
    template <class Key, class T, class Compare, class Allocator>                                  \
    __detail::SynthThreeWayResult<pair<const Key, T>> operator<=>(                                 \
        const Map<Key, T, Compare, Allocator>& left, const Map<Key, T, Compare, Allocator>& right) \
    {                                                                                              \
        return _FSTD::lexicographical_compare_three_way(left.begin(), left.end(), right.begin(),   \
                                                        right.end(), __detail::synth_three_way);   \
    }                                                                                              \
    template <class Key, class T, class Compare, class Allocator>                                  \
    void swap(Map<Key, T, Compare, Allocator>& left,                                               \
              Map<Key, T, Compare, Allocator>& right) noexcept(noexcept(left.swap(right)))         \
    {                                                                                              \
        left.swap(right);                                                                          \
    }                                                                                              \
    template <class Key, class T, class Compare, class Allocator, class Predicate>                 \
    typename Map<Key, T, Compare, Allocator>::size_type erase_if(                                  \
        Map<Key, T, Compare, Allocator>& container, Predicate predicate)                           \
    {                                                                                              \
        const auto before = container.size();                                                      \
        for (auto position = container.begin(); position != container.end();)                      \
        {                                                                                          \
            if (predicate(*position))                                                              \
            {                                                                                      \
                position = container.erase(position);                                              \
            }                                                                                      \
            else                                                                                   \
            {                                                                                      \
                ++position;                                                                        \
            }                                                                                      \
        }                                                                                          \
        return before - container.size();                                                          \
    }                                                                                              \
                                                                                                   \
    template <__detail::ClassicInput I, class Compare = less<__detail::IterKey<I>>,                \
              class Allocator = allocator<__detail::IterToAllocated<I>>>                           \
        requires(!__detail::AllocatorLike<Compare>) && __detail::AllocatorLike<Allocator>          \
    Map(I, I, Compare = Compare(), Allocator = Allocator())                                        \
        -> Map<__detail::IterKey<I>, __detail::IterMapped<I>, Compare, Allocator>;                 \
    template <ranges::input_range R, class Compare = less<__detail::RangeKey<R>>,                  \
              class Allocator = allocator<__detail::RangeToAllocated<R>>>                          \
        requires(!__detail::AllocatorLike<Compare>) && __detail::AllocatorLike<Allocator>          \
    Map(from_range_t, R&&, Compare = Compare(), Allocator = Allocator())                           \
        -> Map<__detail::RangeKey<R>, __detail::RangeMapped<R>, Compare, Allocator>;               \
    template <class Key, class T, class Compare = less<Key>,                                       \
              class Allocator = allocator<pair<const Key, T>>>                                     \
        requires(!__detail::AllocatorLike<Compare>) && __detail::AllocatorLike<Allocator>          \
    Map(initializer_list<pair<Key, T>>, Compare = Compare(), Allocator = Allocator())              \
        -> Map<Key, T, Compare, Allocator>;                                                        \
    template <__detail::ClassicInput I, class Allocator>                                           \
        requires __detail::AllocatorLike<Allocator>                                                \
    Map(I, I, Allocator) -> Map<__detail::IterKey<I>, __detail::IterMapped<I>,                     \
                                less<__detail::IterKey<I>>, Allocator>;                            \
    template <ranges::input_range R, class Allocator>                                              \
        requires __detail::AllocatorLike<Allocator>                                                \
    Map(from_range_t, R&&, Allocator) -> Map<__detail::RangeKey<R>, __detail::RangeMapped<R>,      \
                                             less<__detail::RangeKey<R>>, Allocator>;              \
    template <class Key, class T, class Allocator>                                                 \
        requires __detail::AllocatorLike<Allocator>                                                \
    Map(initializer_list<pair<Key, T>>, Allocator) -> Map<Key, T, less<Key>, Allocator>;

FEATHEROS_MAP_FREE_FUNCTIONS(map)
FEATHEROS_MAP_FREE_FUNCTIONS(multimap)

#undef FEATHEROS_MAP_FREE_FUNCTIONS

