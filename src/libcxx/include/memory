template <class T> class enable_shared_from_this
{
public:
    shared_ptr<T> shared_from_this()
    {
        return shared_ptr<T>(m_weak_this);
    }

    shared_ptr<const T> shared_from_this() const
    {
        return shared_ptr<const T>(m_weak_this);
    }

    weak_ptr<T> weak_from_this() noexcept
    {
        return m_weak_this;
    }

    weak_ptr<const T> weak_from_this() const noexcept
    {
        return m_weak_this;
    }

protected:
    constexpr enable_shared_from_this() noexcept {}
    enable_shared_from_this(const enable_shared_from_this&) noexcept {}
    enable_shared_from_this& operator=(const enable_shared_from_this&) noexcept
    {
        return *this;
    }
    ~enable_shared_from_this() = default;

private:
    template <class U> friend class shared_ptr;

    mutable weak_ptr<T> m_weak_this;
};

template <class T, class... Args>
    requires(!is_array_v<T>)
shared_ptr<T> make_shared(Args&&... args)
{
    auto* block = new __detail::SharedObjectCount<T>(__detail::SharedInPlace{},
                                                     _FSTD::forward<Args>(args)...);
    return shared_ptr<T>(__detail::SharedAdopt{}, block->Object(), block);
}

template <class T>
    requires(!is_array_v<T>)
shared_ptr<T> make_shared_for_overwrite()
{
    auto* block = new __detail::SharedObjectCount<T>(__detail::SharedForOverwrite{});
    return shared_ptr<T>(__detail::SharedAdopt{}, block->Object(), block);
}

template <class T, class U>
bool operator==(const shared_ptr<T>& left, const shared_ptr<U>& right) noexcept
{
    return left.get() == right.get();
}

template <class T, class U>
strong_ordering operator<=>(const shared_ptr<T>& left, const shared_ptr<U>& right) noexcept
{
    return compare_three_way()(left.get(), right.get());
}

template <class T> bool operator==(const shared_ptr<T>& value, nullptr_t) noexcept
{
    return !value;
}

template <class T> strong_ordering operator<=>(const shared_ptr<T>& value, nullptr_t) noexcept
{
    return compare_three_way()(value.get(),
                               static_cast<typename shared_ptr<T>::element_type*>(nullptr));
}

template <class T> void swap(shared_ptr<T>& left, shared_ptr<T>& right) noexcept
{
    left.swap(right);
}

template <class T> void swap(weak_ptr<T>& left, weak_ptr<T>& right) noexcept
{
    left.swap(right);
}

template <class T, class U> shared_ptr<T> static_pointer_cast(const shared_ptr<U>& value) noexcept
{
    return shared_ptr<T>(value, static_cast<typename shared_ptr<T>::element_type*>(value.get()));
}

template <class T, class U> shared_ptr<T> static_pointer_cast(shared_ptr<U>&& value) noexcept
{
    auto* pointer = static_cast<typename shared_ptr<T>::element_type*>(value.get());
    return shared_ptr<T>(_FSTD::move(value), pointer);
}

template <class T, class U> shared_ptr<T> const_pointer_cast(const shared_ptr<U>& value) noexcept
{
    return shared_ptr<T>(value, const_cast<typename shared_ptr<T>::element_type*>(value.get()));
}

template <class T, class U> shared_ptr<T> const_pointer_cast(shared_ptr<U>&& value) noexcept
{
    auto* pointer = const_cast<typename shared_ptr<T>::element_type*>(value.get());
    return shared_ptr<T>(_FSTD::move(value), pointer);
}

template <class T, class U>
shared_ptr<T> reinterpret_pointer_cast(const shared_ptr<U>& value) noexcept
{
    return shared_ptr<T>(value,
                         reinterpret_cast<typename shared_ptr<T>::element_type*>(value.get()));
}

template <class T, class U> shared_ptr<T> reinterpret_pointer_cast(shared_ptr<U>&& value) noexcept
{
    auto* pointer = reinterpret_cast<typename shared_ptr<T>::element_type*>(value.get());
    return shared_ptr<T>(_FSTD::move(value), pointer);
}

template <class D, class T> D* get_deleter(const shared_ptr<T>& value) noexcept
{
    __detail::SharedCount* block = value.__control_block();
    return block != nullptr ? static_cast<D*>(block->FindDeleter(&__detail::TypeTag<D>)) : nullptr;
}

template <class T = void> struct owner_less;

template <class T> struct owner_less<shared_ptr<T>>
{
    bool operator()(const shared_ptr<T>& left, const shared_ptr<T>& right) const noexcept
    {
        return left.owner_before(right);
    }
    bool operator()(const shared_ptr<T>& left, const weak_ptr<T>& right) const noexcept
    {
        return left.owner_before(right);
    }
    bool operator()(const weak_ptr<T>& left, const shared_ptr<T>& right) const noexcept
    {
        return left.owner_before(right);
    }
};

template <class T> struct owner_less<weak_ptr<T>>
{
    bool operator()(const weak_ptr<T>& left, const weak_ptr<T>& right) const noexcept
    {
        return left.owner_before(right);
    }
    bool operator()(const shared_ptr<T>& left, const weak_ptr<T>& right) const noexcept
    {
        return left.owner_before(right);
    }
    bool operator()(const weak_ptr<T>& left, const shared_ptr<T>& right) const noexcept
    {
        return left.owner_before(right);
    }
};

template <> struct owner_less<void>
{
    template <class T, class U>
    bool operator()(const shared_ptr<T>& left, const shared_ptr<U>& right) const noexcept
    {
        return left.owner_before(right);
    }
    template <class T, class U>
    bool operator()(const shared_ptr<T>& left, const weak_ptr<U>& right) const noexcept
    {
        return left.owner_before(right);
    }
    template <class T, class U>
    bool operator()(const weak_ptr<T>& left, const shared_ptr<U>& right) const noexcept
    {
        return left.owner_before(right);
    }
    template <class T, class U>
    bool operator()(const weak_ptr<T>& left, const weak_ptr<U>& right) const noexcept
    {
        return left.owner_before(right);
    }
    using is_transparent = void;
};

template <class T> struct hash<shared_ptr<T>>
{
    size_t operator()(const shared_ptr<T>& value) const noexcept
    {
        return hash<typename shared_ptr<T>::element_type*>()(value.get());
    }
};

