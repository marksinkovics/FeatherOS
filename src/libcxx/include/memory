// Left out: shared_ptr's allocator-taking constructors and allocate_shared, make_shared of
// arrays, dynamic_pointer_cast (needs RTTI), atomic<shared_ptr>, out_ptr and inout_ptr, and
// the ranges:: forms of the uninitialized-memory algorithms. A shared_ptr made from an expired
// weak_ptr calls the library's abort hook instead of throwing bad_weak_ptr. Without exceptions
// a constructor cannot fail, so the uninitialized-memory algorithms never roll back.

namespace FEATHEROS_STD_NAMESPACE
{

template <class Pointer, class SizeType = size_t> struct allocation_result
{
    Pointer ptr;
    SizeType count;
};

template <class T> class allocator
{
public:
    using value_type = T;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using propagate_on_container_move_assignment = true_type;
    using is_always_equal = true_type;

    constexpr allocator() noexcept = default;
    constexpr allocator(const allocator&) noexcept = default;
    template <class U> constexpr allocator(const allocator<U>&) noexcept {}
    constexpr ~allocator() = default;
    constexpr allocator& operator=(const allocator&) = default;

    [[nodiscard]] constexpr T* allocate(size_t count)
    {
        static_assert(sizeof(T) != 0, "allocator needs a complete type");
        if (count > static_cast<size_t>(-1) / sizeof(T))
        {
            __detail::LibraryAbort("allocator::allocate: the size overflows");
        }
        if (__builtin_is_constant_evaluated())
        {
            // Constant evaluation allows ::operator new only inside std::allocator<T>::allocate.
#if FEATHEROS_STD_IS_STD
            return static_cast<T*>(::operator new(count * sizeof(T)));
#else
            return ::std::allocator<T>().allocate(count);
#endif
        }
        if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__)
        {
            return static_cast<T*>(::operator new(count * sizeof(T), align_val_t(alignof(T))));
        }
        else
        {
            return static_cast<T*>(::operator new(count * sizeof(T)));
        }
    }

    [[nodiscard]] constexpr allocation_result<T*> allocate_at_least(size_t count)
    {
        return {allocate(count), count};
    }

    constexpr void deallocate(T* pointer, size_t count)
    {
        if (__builtin_is_constant_evaluated())
        {
#if FEATHEROS_STD_IS_STD
            ::operator delete(pointer);
#else
            ::std::allocator<T>().deallocate(pointer, count);
#endif
            return;
        }
        if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__)
        {
            ::operator delete(pointer, count * sizeof(T), align_val_t(alignof(T)));
        }
        else
        {
            ::operator delete(pointer, count * sizeof(T));
        }
    }
};

template <class T, class U>
constexpr bool operator==(const allocator<T>&, const allocator<U>&) noexcept
{
    return true;
}

