// Each member type of allocator_traits is the allocator's own when it has one.
template <class Alloc> constexpr auto AllocatorPointer()
{
    if constexpr (requires { typename Alloc::pointer; })
    {
        return type_identity<typename Alloc::pointer>{};
    }
    else
    {
        return type_identity<typename Alloc::value_type*>{};
    }
}

