// A shared_ptr's control block. m_owners counts shared_ptrs; m_weak counts weak_ptrs plus one
// for all the owners together, so the block outlives the object while any weak_ptr remains.
class SharedCount
{
public:
    SharedCount(const SharedCount&) = delete;
    SharedCount& operator=(const SharedCount&) = delete;

    void AddOwner() noexcept
    {
        __atomic_fetch_add(&m_owners, 1, __ATOMIC_RELAXED);
    }

    void ReleaseOwner() noexcept
    {
        if (__atomic_fetch_sub(&m_owners, 1, __ATOMIC_ACQ_REL) == 1)
        {
            DestroyObject();
            ReleaseWeak();
        }
    }

    // weak_ptr::lock: a new owner only while another still keeps the object alive.
    bool TryAddOwner() noexcept
    {
        long owners = __atomic_load_n(&m_owners, __ATOMIC_RELAXED);
        while (owners != 0)
        {
            if (__atomic_compare_exchange_n(&m_owners, &owners, owners + 1, true, __ATOMIC_ACQ_REL,
                                            __ATOMIC_RELAXED))
            {
                return true;
            }
        }
        return false;
    }

    void AddWeak() noexcept
    {
        __atomic_fetch_add(&m_weak, 1, __ATOMIC_RELAXED);
    }

    void ReleaseWeak() noexcept
    {
        if (__atomic_fetch_sub(&m_weak, 1, __ATOMIC_ACQ_REL) == 1)
        {
            DestroyBlock();
        }
    }

    long Owners() const noexcept
    {
        return __atomic_load_n(&m_owners, __ATOMIC_RELAXED);
    }

    virtual void* FindDeleter(const void*) noexcept
    {
        return nullptr;
    }

protected:
    SharedCount() = default;
    ~SharedCount() = default;

    virtual void DestroyObject() noexcept = 0;
    virtual void DestroyBlock() noexcept = 0;

private:
    long m_owners = 1;
    long m_weak = 1;
};

template <class Pointer, class Deleter> class SharedPointerCount final : public SharedCount
{
public:
    SharedPointerCount(Pointer pointer, Deleter deleter) noexcept
        : m_pointer(pointer), m_deleter(_FSTD::move(deleter))
    {
    }

    void* FindDeleter(const void* type) noexcept override
    {
        return type == &TypeTag<Deleter> ? _FSTD::addressof(m_deleter) : nullptr;
    }

private:
    void DestroyObject() noexcept override
    {
        m_deleter(m_pointer);
    }

    void DestroyBlock() noexcept override
    {
        delete this;
    }

    Pointer m_pointer;
    [[no_unique_address]] Deleter m_deleter;
};

struct SharedInPlace
{
    explicit SharedInPlace() = default;
};
struct SharedForOverwrite
{
    explicit SharedForOverwrite() = default;
};

// make_shared's block, which holds the object itself, so one allocation serves both.
template <class T> class SharedObjectCount final : public SharedCount
{
public:
    template <class... Args>
    explicit SharedObjectCount(SharedInPlace, Args&&... args)
        : m_object(_FSTD::forward<Args>(args)...)
    {
    }

    explicit SharedObjectCount(SharedForOverwrite)
    {
        ::new (static_cast<void*>(_FSTD::addressof(m_object))) remove_cv_t<T>;
    }

    ~SharedObjectCount() {}

    T* Object() noexcept
    {
        return _FSTD::addressof(m_object);
    }

private:
    void DestroyObject() noexcept override
    {
        _FSTD::destroy_at(_FSTD::addressof(m_object));
    }

    void DestroyBlock() noexcept override
    {
        delete this;
    }

    // In a union, so the block's destructor leaves the object to DestroyObject.
    union
    {
        remove_cv_t<T> m_object;
    };
};

struct SharedAdopt
{
    explicit SharedAdopt() = default;
};

// Y* is compatible with T*: it converts, or Y is U[N] and T is cv U[].
template <class Y, class T>
concept SharedCompatible =
    is_convertible_v<Y*, T*> ||
    (is_bounded_array_v<Y> && is_unbounded_array_v<T> &&
     is_same_v<remove_cv_t<remove_extent_t<Y>>, remove_cv_t<remove_extent_t<T>>> &&
     is_convertible_v<remove_extent_t<Y>*, remove_extent_t<T>*>);

// The pointers shared_ptr<T> takes ownership of.
template <class Y, class T>
concept SharedConvertiblePointer =
    (!is_array_v<T> && is_convertible_v<Y*, T*>) ||
    (is_unbounded_array_v<T> && is_convertible_v<Y (*)[], T*>) ||
    (is_bounded_array_v<T> && is_convertible_v<Y (*)[extent_v<T>], T*>);

template <class Y>
concept Deletable = requires(Y* pointer) { delete pointer; };
template <class Y>
concept ArrayDeletable = requires(Y* pointer) { delete[] pointer; };

template <class X>
const enable_shared_from_this<X>*
SharedFromThisBase(const enable_shared_from_this<X>* base) noexcept
{
    return base;
}
} // namespace __detail

template <class T> class shared_ptr
{
public:
    using element_type = remove_extent_t<T>;
    using weak_type = weak_ptr<T>;

    constexpr shared_ptr() noexcept = default;
    constexpr shared_ptr(nullptr_t) noexcept {}

    template <class Y>
        requires __detail::SharedConvertiblePointer<Y, T> &&
                 (is_array_v<T> ? __detail::ArrayDeletable<Y> : __detail::Deletable<Y>)
    explicit shared_ptr(Y* pointer)
        : shared_ptr(pointer,
                     conditional_t<is_array_v<T>, default_delete<Y[]>, default_delete<Y>>())
    {
    }

    template <class Y, class D>
        requires __detail::SharedConvertiblePointer<Y, T> && is_move_constructible_v<D> &&
                     is_invocable_v<D&, Y*&>
    shared_ptr(Y* pointer, D deleter)
        : m_pointer(pointer),
          m_count(new __detail::SharedPointerCount<Y*, D>(pointer, _FSTD::move(deleter)))
    {
        EnableSharedFromThis(pointer);
    }

    template <class D>
        requires is_move_constructible_v<D> && is_invocable_v<D&, nullptr_t&>
    shared_ptr(nullptr_t, D deleter)
        : m_count(new __detail::SharedPointerCount<nullptr_t, D>(nullptr, _FSTD::move(deleter)))
    {
    }

    // Aliasing: shares other's ownership but points elsewhere.
    template <class Y>
    shared_ptr(const shared_ptr<Y>& other, element_type* pointer) noexcept
        : m_pointer(pointer), m_count(other.m_count)
    {
        AddOwner();
    }

    template <class Y>
    shared_ptr(shared_ptr<Y>&& other, element_type* pointer) noexcept
        : m_pointer(pointer), m_count(_FSTD::exchange(other.m_count, nullptr))
    {
        other.m_pointer = nullptr;
    }

    shared_ptr(const shared_ptr& other) noexcept
        : m_pointer(other.m_pointer), m_count(other.m_count)
    {
        AddOwner();
    }

    template <class Y>
        requires __detail::SharedCompatible<Y, T>
    shared_ptr(const shared_ptr<Y>& other) noexcept
        : m_pointer(other.m_pointer), m_count(other.m_count)
    {
        AddOwner();
    }

    shared_ptr(shared_ptr&& other) noexcept
        : m_pointer(_FSTD::exchange(other.m_pointer, nullptr)),
          m_count(_FSTD::exchange(other.m_count, nullptr))
    {
    }

    template <class Y>
        requires __detail::SharedCompatible<Y, T>
    shared_ptr(shared_ptr<Y>&& other) noexcept
        : m_pointer(_FSTD::exchange(other.m_pointer, nullptr)),
          m_count(_FSTD::exchange(other.m_count, nullptr))
    {
    }

    // The pointer is converted only once the object is known to live, since converting to a
    // virtual base reads the object.
    template <class Y>
        requires __detail::SharedCompatible<Y, T>
    explicit shared_ptr(const weak_ptr<Y>& other)
    {
        if (other.m_count == nullptr || !other.m_count->TryAddOwner())
        {
            __detail::LibraryAbort("bad_weak_ptr: shared_ptr from an expired weak_ptr");
        }
        m_count = other.m_count;
        m_pointer = other.m_pointer;
    }

    template <class Y, class D>
        requires __detail::SharedCompatible<Y, T> &&
                 is_convertible_v<typename unique_ptr<Y, D>::pointer, element_type*>
    shared_ptr(unique_ptr<Y, D>&& other)
    {
        using Pointer = typename unique_ptr<Y, D>::pointer;
        using Deleter =
            conditional_t<is_reference_v<D>, reference_wrapper<remove_reference_t<D>>, D>;
        if (other.get() == nullptr)
        {
            return;
        }
        Pointer owned = other.get();
        m_count = new __detail::SharedPointerCount<Pointer, Deleter>(
            owned, Deleter(_FSTD::forward<D>(other.get_deleter())));
        m_pointer = owned;
        other.release();
        if constexpr (is_pointer_v<Pointer>)
        {
            EnableSharedFromThis(owned);
        }
    }

    // make_shared's: the block already holds the object.
    shared_ptr(__detail::SharedAdopt, element_type* pointer, __detail::SharedCount* count) noexcept
        : m_pointer(pointer), m_count(count)
    {
        EnableSharedFromThis(pointer);
    }

    ~shared_ptr()
    {
        if (m_count != nullptr)
        {
            m_count->ReleaseOwner();
        }
    }

    shared_ptr& operator=(const shared_ptr& other) noexcept
    {
        shared_ptr(other).swap(*this);
        return *this;
    }

    template <class Y>
        requires __detail::SharedCompatible<Y, T>
    shared_ptr& operator=(const shared_ptr<Y>& other) noexcept
    {
        shared_ptr(other).swap(*this);
        return *this;
    }

    shared_ptr& operator=(shared_ptr&& other) noexcept
    {
        shared_ptr(_FSTD::move(other)).swap(*this);
        return *this;
    }

    template <class Y>
        requires __detail::SharedCompatible<Y, T>
    shared_ptr& operator=(shared_ptr<Y>&& other) noexcept
    {
        shared_ptr(_FSTD::move(other)).swap(*this);
        return *this;
    }

    template <class Y, class D>
        requires is_constructible_v<shared_ptr, unique_ptr<Y, D>>
    shared_ptr& operator=(unique_ptr<Y, D>&& other)
    {
        shared_ptr(_FSTD::move(other)).swap(*this);
        return *this;
    }

    void swap(shared_ptr& other) noexcept
    {
        _FSTD::swap(m_pointer, other.m_pointer);
        _FSTD::swap(m_count, other.m_count);
    }

    void reset() noexcept
    {
        shared_ptr().swap(*this);
    }

    template <class Y>
        requires is_constructible_v<shared_ptr, Y*>
    void reset(Y* pointer)
    {
        shared_ptr(pointer).swap(*this);
    }

    template <class Y, class D>
        requires is_constructible_v<shared_ptr, Y*, D>
    void reset(Y* pointer, D deleter)
    {
        shared_ptr(pointer, _FSTD::move(deleter)).swap(*this);
    }

    element_type* get() const noexcept
    {
        return m_pointer;
    }

    template <class Self = T>
        requires(!is_array_v<Self> && !is_void_v<Self>)
    Self& operator*() const noexcept
    {
        return *m_pointer;
    }

    template <class Self = T>
        requires(!is_array_v<Self>)
    element_type* operator->() const noexcept
    {
        return m_pointer;
    }

    template <class Self = T>
        requires is_array_v<Self>
    element_type& operator[](ptrdiff_t index) const
    {
        return m_pointer[index];
    }

    long use_count() const noexcept
    {
        return m_count != nullptr ? m_count->Owners() : 0;
    }

    explicit operator bool() const noexcept
    {
        return m_pointer != nullptr;
    }

    template <class U> bool owner_before(const shared_ptr<U>& other) const noexcept
    {
        return less<__detail::SharedCount*>()(m_count, other.m_count);
    }

    template <class U> bool owner_before(const weak_ptr<U>& other) const noexcept
    {
        return less<__detail::SharedCount*>()(m_count, other.m_count);
    }

    // get_deleter's way into the control block.
    __detail::SharedCount* __control_block() const noexcept
    {
        return m_count;
    }

private:
    template <class U> friend class shared_ptr;
    template <class U> friend class weak_ptr;

    void AddOwner() noexcept
    {
        if (m_count != nullptr)
        {
            m_count->AddOwner();
        }
    }

    // An object that derives from enable_shared_from_this (once, publicly) learns its first
    // owner.
    template <class Y> void EnableSharedFromThis(Y* pointer) noexcept
    {
        if constexpr (requires { __detail::SharedFromThisBase(pointer); })
        {
            if (pointer == nullptr)
            {
                return;
            }
            const auto* base = __detail::SharedFromThisBase(pointer);
            if (base->m_weak_this.expired())
            {
                base->m_weak_this =
                    shared_ptr<remove_cv_t<Y>>(*this, const_cast<remove_cv_t<Y>*>(pointer));
            }
        }
    }

    element_type* m_pointer = nullptr;
    __detail::SharedCount* m_count = nullptr;
};

template <class T> shared_ptr(weak_ptr<T>) -> shared_ptr<T>;
template <class T, class D> shared_ptr(unique_ptr<T, D>) -> shared_ptr<T>;

template <class T> class weak_ptr
{
public:
    using element_type = remove_extent_t<T>;

    constexpr weak_ptr() noexcept = default;

    weak_ptr(const weak_ptr& other) noexcept : m_pointer(other.m_pointer), m_count(other.m_count)
    {
        AddWeak();
    }

    template <class Y>
        requires __detail::SharedCompatible<Y, T>
    weak_ptr(const shared_ptr<Y>& other) noexcept
        : m_pointer(other.m_pointer), m_count(other.m_count)
    {
        AddWeak();
    }

    // From another weak_ptr type the object may be gone, and converting its pointer to a
    // virtual base would read it, so the conversion goes through lock().
    template <class Y>
        requires __detail::SharedCompatible<Y, T>
    weak_ptr(const weak_ptr<Y>& other) noexcept
        : m_pointer(other.lock().get()), m_count(other.m_count)
    {
        AddWeak();
    }

    weak_ptr(weak_ptr&& other) noexcept
        : m_pointer(_FSTD::exchange(other.m_pointer, nullptr)),
          m_count(_FSTD::exchange(other.m_count, nullptr))
    {
    }

    template <class Y>
        requires __detail::SharedCompatible<Y, T>
    weak_ptr(weak_ptr<Y>&& other) noexcept
        : m_pointer(other.lock().get()), m_count(_FSTD::exchange(other.m_count, nullptr))
    {
        other.m_pointer = nullptr;
    }

    ~weak_ptr()
    {
        if (m_count != nullptr)
        {
            m_count->ReleaseWeak();
        }
    }

    weak_ptr& operator=(const weak_ptr& other) noexcept
    {
        weak_ptr(other).swap(*this);
        return *this;
    }

    template <class Y>
        requires __detail::SharedCompatible<Y, T>
    weak_ptr& operator=(const weak_ptr<Y>& other) noexcept
    {
        weak_ptr(other).swap(*this);
        return *this;
    }

    template <class Y>
        requires __detail::SharedCompatible<Y, T>
    weak_ptr& operator=(const shared_ptr<Y>& other) noexcept
    {
        weak_ptr(other).swap(*this);
        return *this;
    }

    weak_ptr& operator=(weak_ptr&& other) noexcept
    {
        weak_ptr(_FSTD::move(other)).swap(*this);
        return *this;
    }

    template <class Y>
        requires __detail::SharedCompatible<Y, T>
    weak_ptr& operator=(weak_ptr<Y>&& other) noexcept
    {
        weak_ptr(_FSTD::move(other)).swap(*this);
        return *this;
    }

    void swap(weak_ptr& other) noexcept
    {
        _FSTD::swap(m_pointer, other.m_pointer);
        _FSTD::swap(m_count, other.m_count);
    }

    void reset() noexcept
    {
        weak_ptr().swap(*this);
    }

    long use_count() const noexcept
    {
        return m_count != nullptr ? m_count->Owners() : 0;
    }

    bool expired() const noexcept
    {
        return use_count() == 0;
    }

    shared_ptr<T> lock() const noexcept
    {
        shared_ptr<T> result;
        if (m_count != nullptr && m_count->TryAddOwner())
        {
            result.m_pointer = m_pointer;
            result.m_count = m_count;
        }
        return result;
    }

    template <class U> bool owner_before(const shared_ptr<U>& other) const noexcept
    {
        return less<__detail::SharedCount*>()(m_count, other.m_count);
    }

    template <class U> bool owner_before(const weak_ptr<U>& other) const noexcept
    {
        return less<__detail::SharedCount*>()(m_count, other.m_count);
    }

private:
    template <class U> friend class shared_ptr;
    template <class U> friend class weak_ptr;

    void AddWeak() noexcept
    {
        if (m_count != nullptr)
        {
            m_count->AddWeak();
        }
    }

    element_type* m_pointer = nullptr;
    __detail::SharedCount* m_count = nullptr;
};

