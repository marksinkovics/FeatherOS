template <class Alloc> struct allocator_traits
{
    using allocator_type = Alloc;
    using value_type = typename Alloc::value_type;
    using pointer = typename decltype(__detail::AllocatorPointer<Alloc>())::type;
    using const_pointer =
        typename decltype(__detail::AllocatorConstPointer<Alloc, pointer>())::type;
    using void_pointer = typename decltype(__detail::AllocatorVoidPointer<Alloc, pointer>())::type;
    using const_void_pointer =
        typename decltype(__detail::AllocatorConstVoidPointer<Alloc, pointer>())::type;
    using difference_type =
        typename decltype(__detail::AllocatorDifference<Alloc, pointer>())::type;
    using size_type = typename decltype(__detail::AllocatorSize<Alloc, difference_type>())::type;
    using propagate_on_container_copy_assignment =
        typename decltype(__detail::AllocatorPropagateOnCopy<Alloc>())::type;
    using propagate_on_container_move_assignment =
        typename decltype(__detail::AllocatorPropagateOnMove<Alloc>())::type;
    using propagate_on_container_swap =
        typename decltype(__detail::AllocatorPropagateOnSwap<Alloc>())::type;
    using is_always_equal = typename decltype(__detail::AllocatorAlwaysEqual<Alloc>())::type;

    template <class T> using rebind_alloc = typename __detail::AllocatorRebind<Alloc, T>::type;
    template <class T> using rebind_traits = allocator_traits<rebind_alloc<T>>;

    [[nodiscard]] static constexpr pointer allocate(Alloc& allocator, size_type count)
    {
        return allocator.allocate(count);
    }

    [[nodiscard]] static constexpr pointer allocate(Alloc& allocator, size_type count,
                                                    const_void_pointer hint)
    {
        if constexpr (requires { allocator.allocate(count, hint); })
        {
            return allocator.allocate(count, hint);
        }
        else
        {
            return allocator.allocate(count);
        }
    }

    [[nodiscard]] static constexpr allocation_result<pointer, size_type>
    allocate_at_least(Alloc& allocator, size_type count)
    {
        if constexpr (requires { allocator.allocate_at_least(count); })
        {
            return allocator.allocate_at_least(count);
        }
        else
        {
            return {allocator.allocate(count), count};
        }
    }

    static constexpr void deallocate(Alloc& allocator, pointer location, size_type count)
    {
        allocator.deallocate(location, count);
    }

    template <class T, class... Args>
    static constexpr void construct(Alloc& allocator, T* location, Args&&... args)
    {
        if constexpr (requires { allocator.construct(location, _FSTD::forward<Args>(args)...); })
        {
            allocator.construct(location, _FSTD::forward<Args>(args)...);
        }
        else
        {
            __detail::ConstructAt(location, _FSTD::forward<Args>(args)...);
        }
    }

    template <class T> static constexpr void destroy(Alloc& allocator, T* location)
    {
        if constexpr (requires { allocator.destroy(location); })
        {
            allocator.destroy(location);
        }
        else
        {
            _FSTD::destroy_at(location);
        }
    }

    static constexpr size_type max_size(const Alloc& allocator) noexcept
    {
        if constexpr (requires { allocator.max_size(); })
        {
            return allocator.max_size();
        }
        else
        {
            return numeric_limits<size_type>::max() / sizeof(value_type);
        }
    }

    static constexpr Alloc select_on_container_copy_construction(const Alloc& allocator)
    {
        if constexpr (requires { allocator.select_on_container_copy_construction(); })
        {
            return allocator.select_on_container_copy_construction();
        }
        else
        {
            return allocator;
        }
    }
};

template <class T, class Alloc, class... Args>
constexpr auto uses_allocator_construction_args(const Alloc& allocator, Args&&... args) noexcept
    -> decltype(__detail::UsesAllocatorConstruction<remove_cv_t<T>>::Arguments(
        allocator, _FSTD::forward<Args>(args)...))
{
    return __detail::UsesAllocatorConstruction<remove_cv_t<T>>::Arguments(
        allocator, _FSTD::forward<Args>(args)...);
}

template <class T, class Alloc, class... Args>
constexpr T make_obj_using_allocator(const Alloc& allocator, Args&&... args)
{
    return _FSTD::make_from_tuple<T>(
        _FSTD::uses_allocator_construction_args<T>(allocator, _FSTD::forward<Args>(args)...));
}

template <class T, class Alloc, class... Args>
constexpr T* uninitialized_construct_using_allocator(T* location, const Alloc& allocator,
                                                     Args&&... args)
{
    return _FSTD::apply(
        [location](auto&&... arguments)
        {
            return __detail::ConstructAt(location,
                                         _FSTD::forward<decltype(arguments)>(arguments)...);
        },
        _FSTD::uses_allocator_construction_args<T>(allocator, _FSTD::forward<Args>(args)...));
}

template <size_t Alignment, class T> [[nodiscard]] constexpr T* assume_aligned(T* pointer)
{
    static_assert(Alignment != 0 && (Alignment & (Alignment - 1)) == 0,
                  "assume_aligned needs a power of two");
    if (__builtin_is_constant_evaluated())
    {
        return pointer;
    }
    return static_cast<T*>(__builtin_assume_aligned(pointer, Alignment));
}

inline void* align(size_t alignment, size_t size, void*& pointer, size_t& space) noexcept
{
    const auto address = reinterpret_cast<__UINTPTR_TYPE__>(pointer);
    const auto aligned = (address + alignment - 1) & ~static_cast<__UINTPTR_TYPE__>(alignment - 1);
    const auto padding = static_cast<size_t>(aligned - address);
    if (size > space || padding > space - size)
    {
        return nullptr;
    }
    space -= padding;
    pointer = reinterpret_cast<void*>(aligned);
    return pointer;
}

// The uninitialized-memory algorithms.

namespace __detail
{
template <class I> constexpr auto* VoidifiedAddress(I& iterator)
{
    return _FSTD::addressof(*iterator);
}
} // namespace __detail

template <class I, class F> constexpr F uninitialized_copy(I first, I last, F out)
{
    for (; first != last; ++first, (void)++out)
    {
        __detail::ConstructAt(__detail::VoidifiedAddress(out), *first);
    }
    return out;
}

template <class I, class Size, class F> constexpr F uninitialized_copy_n(I first, Size count, F out)
{
    for (; count > 0; ++first, (void)++out, --count)
    {
        __detail::ConstructAt(__detail::VoidifiedAddress(out), *first);
    }
    return out;
}

template <class I, class F> constexpr F uninitialized_move(I first, I last, F out)
{
    for (; first != last; ++first, (void)++out)
    {
        __detail::ConstructAt(__detail::VoidifiedAddress(out), ranges::iter_move(first));
    }
    return out;
}

template <class I, class Size, class F>
constexpr pair<I, F> uninitialized_move_n(I first, Size count, F out)
{
    for (; count > 0; ++first, (void)++out, --count)
    {
        __detail::ConstructAt(__detail::VoidifiedAddress(out), ranges::iter_move(first));
    }
    return pair<I, F>(first, out);
}

template <class F, class T> constexpr void uninitialized_fill(F first, F last, const T& value)
{
    for (; first != last; ++first)
    {
        __detail::ConstructAt(__detail::VoidifiedAddress(first), value);
    }
}

template <class F, class Size, class T>
constexpr F uninitialized_fill_n(F first, Size count, const T& value)
{
    for (; count > 0; ++first, (void)--count)
    {
        __detail::ConstructAt(__detail::VoidifiedAddress(first), value);
    }
    return first;
}

template <class F> constexpr void uninitialized_value_construct(F first, F last)
{
    for (; first != last; ++first)
    {
        __detail::ConstructAt(__detail::VoidifiedAddress(first));
    }
}

template <class F, class Size> constexpr F uninitialized_value_construct_n(F first, Size count)
{
    for (; count > 0; ++first, (void)--count)
    {
        __detail::ConstructAt(__detail::VoidifiedAddress(first));
    }
    return first;
}

// Default-initialization has no form constant evaluation accepts, so these two are not
// constexpr.
template <class F> void uninitialized_default_construct(F first, F last)
{
    using Value = remove_cvref_t<decltype(*first)>;
    for (; first != last; ++first)
    {
        ::new (static_cast<void*>(__detail::VoidifiedAddress(first))) Value;
    }
}

template <class F, class Size> F uninitialized_default_construct_n(F first, Size count)
{
    using Value = remove_cvref_t<decltype(*first)>;
    for (; count > 0; ++first, (void)--count)
    {
        ::new (static_cast<void*>(__detail::VoidifiedAddress(first))) Value;
    }
    return first;
}

template <class F> constexpr void destroy(F first, F last)
{
    for (; first != last; ++first)
    {
        _FSTD::destroy_at(_FSTD::addressof(*first));
    }
}

template <class F, class Size> constexpr F destroy_n(F first, Size count)
{
    for (; count > 0; ++first, (void)--count)
    {
        _FSTD::destroy_at(_FSTD::addressof(*first));
    }
    return first;
}

template <class T> struct default_delete
{
    constexpr default_delete() noexcept = default;

    template <class U>
        requires is_convertible_v<U*, T*>
    constexpr default_delete(const default_delete<U>&) noexcept
    {
    }

    constexpr void operator()(T* pointer) const
    {
        static_assert(!is_void_v<T>, "default_delete cannot delete through void*");
        static_assert(sizeof(T) > 0, "default_delete needs a complete type");
        delete pointer;
    }
};

template <class T> struct default_delete<T[]>
{
    constexpr default_delete() noexcept = default;

    template <class U>
        requires is_convertible_v<U (*)[], T (*)[]>
    constexpr default_delete(const default_delete<U[]>&) noexcept
    {
    }

    template <class U>
        requires is_convertible_v<U (*)[], T (*)[]>
    constexpr void operator()(U* pointer) const
    {
        static_assert(sizeof(U) > 0, "default_delete needs a complete type");
        delete[] pointer;
    }
};

namespace __detail
{
template <class T, class Deleter> constexpr auto UniquePointerType()
{
    if constexpr (requires { typename remove_reference_t<Deleter>::pointer; })
    {
        return type_identity<typename remove_reference_t<Deleter>::pointer>{};
    }
    else
    {
        return type_identity<T*>{};
    }
}

template <class Deleter>
concept DefaultDeleter = is_default_constructible_v<Deleter> && !is_pointer_v<Deleter>;

// A deleter held by reference converts only from exactly that type, a deleter held by value
// from anything convertible.
template <class Deleter, class Other>
concept UniqueDeleterFrom = (is_reference_v<Deleter> && is_same_v<Other, Deleter>) ||
                            (!is_reference_v<Deleter> && is_convertible_v<Other, Deleter>);
} // namespace __detail

template <class T, class Deleter = default_delete<T>> class unique_ptr
{
public:
    using pointer = typename decltype(__detail::UniquePointerType<T, Deleter>())::type;
    using element_type = T;
    using deleter_type = Deleter;

    constexpr unique_ptr() noexcept
        requires __detail::DefaultDeleter<Deleter>
        : m_pointer(), m_deleter()
    {
    }

    constexpr unique_ptr(nullptr_t) noexcept
        requires __detail::DefaultDeleter<Deleter>
        : m_pointer(), m_deleter()
    {
    }

    constexpr explicit unique_ptr(pointer value) noexcept
        requires __detail::DefaultDeleter<Deleter>
        : m_pointer(value), m_deleter()
    {
    }

    // For a deleter held by reference, const Deleter& is that reference.
    constexpr unique_ptr(pointer value, const Deleter& deleter) noexcept
        requires is_constructible_v<Deleter, const Deleter&>
        : m_pointer(value), m_deleter(deleter)
    {
    }

    constexpr unique_ptr(pointer value, remove_reference_t<Deleter>&& deleter) noexcept
        requires(!is_reference_v<Deleter>) && is_constructible_v<Deleter, Deleter&&>
        : m_pointer(value), m_deleter(_FSTD::move(deleter))
    {
    }

    unique_ptr(pointer, remove_reference_t<Deleter>&&)
        requires is_reference_v<Deleter>
    = delete;

    constexpr unique_ptr(unique_ptr&& other) noexcept
        requires is_move_constructible_v<Deleter>
        : m_pointer(other.release()), m_deleter(_FSTD::forward<Deleter>(other.get_deleter()))
    {
    }

    template <class U, class E>
        requires is_convertible_v<typename unique_ptr<U, E>::pointer, pointer> &&
                     (!is_array_v<U>) && __detail::UniqueDeleterFrom<Deleter, E>
    constexpr unique_ptr(unique_ptr<U, E>&& other) noexcept
        : m_pointer(other.release()), m_deleter(_FSTD::forward<E>(other.get_deleter()))
    {
    }

    constexpr ~unique_ptr()
    {
        if (m_pointer != nullptr)
        {
            m_deleter(m_pointer);
        }
    }

    constexpr unique_ptr& operator=(unique_ptr&& other) noexcept
        requires is_move_assignable_v<Deleter>
    {
        reset(other.release());
        m_deleter = _FSTD::forward<Deleter>(other.get_deleter());
        return *this;
    }

    template <class U, class E>
        requires is_convertible_v<typename unique_ptr<U, E>::pointer, pointer> &&
                 (!is_array_v<U>) && is_assignable_v<Deleter&, E&&>
    constexpr unique_ptr& operator=(unique_ptr<U, E>&& other) noexcept
    {
        reset(other.release());
        m_deleter = _FSTD::forward<E>(other.get_deleter());
        return *this;
    }

    constexpr unique_ptr& operator=(nullptr_t) noexcept
    {
        reset();
        return *this;
    }

    constexpr add_lvalue_reference_t<T> operator*() const noexcept(noexcept(*declval<pointer>()))
    {
        return *m_pointer;
    }

    constexpr pointer operator->() const noexcept
    {
        return m_pointer;
    }

    constexpr pointer get() const noexcept
    {
        return m_pointer;
    }

    constexpr Deleter& get_deleter() noexcept
    {
        return m_deleter;
    }

    constexpr const Deleter& get_deleter() const noexcept
    {
        return m_deleter;
    }

    constexpr explicit operator bool() const noexcept
    {
        return m_pointer != nullptr;
    }

    constexpr pointer release() noexcept
    {
        return _FSTD::exchange(m_pointer, pointer());
    }

    constexpr void reset(pointer value = pointer()) noexcept
    {
        pointer old = _FSTD::exchange(m_pointer, value);
        if (old != nullptr)
        {
            m_deleter(old);
        }
    }

    constexpr void swap(unique_ptr& other) noexcept
    {
        using _FSTD::swap;
        swap(m_pointer, other.m_pointer);
        swap(m_deleter, other.m_deleter);
    }

private:
    pointer m_pointer;
    [[no_unique_address]] Deleter m_deleter;
};

template <class T, class Deleter> class unique_ptr<T[], Deleter>
{
public:
    using pointer = typename decltype(__detail::UniquePointerType<T, Deleter>())::type;
    using element_type = T;
    using deleter_type = Deleter;

private:
    // A pointer to elements of a type that converts as arrays do, such as T* from const T*'s
    // opposite, but never Derived* to Base*.
    template <class U>
    static constexpr bool AcceptsPointer =
        is_same_v<U, pointer> || (is_same_v<pointer, element_type*> && is_pointer_v<U> &&
                                  is_convertible_v<remove_pointer_t<U> (*)[], element_type (*)[]>);

public:
    constexpr unique_ptr() noexcept
        requires __detail::DefaultDeleter<Deleter>
        : m_pointer(), m_deleter()
    {
    }

    constexpr unique_ptr(nullptr_t) noexcept
        requires __detail::DefaultDeleter<Deleter>
        : m_pointer(), m_deleter()
    {
    }

    template <class U>
        requires __detail::DefaultDeleter<Deleter> && AcceptsPointer<U>
    constexpr explicit unique_ptr(U value) noexcept : m_pointer(value), m_deleter()
    {
    }

    template <class U>
        requires(AcceptsPointer<U> || is_same_v<U, nullptr_t>) &&
                    is_constructible_v<Deleter, const Deleter&>
    constexpr unique_ptr(U value, const Deleter& deleter) noexcept
        : m_pointer(value), m_deleter(deleter)
    {
    }

    template <class U>
        requires(AcceptsPointer<U> || is_same_v<U, nullptr_t>) && (!is_reference_v<Deleter>) &&
                    is_constructible_v<Deleter, Deleter&&>
    constexpr unique_ptr(U value, remove_reference_t<Deleter>&& deleter) noexcept
        : m_pointer(value), m_deleter(_FSTD::move(deleter))
    {
    }

    template <class U>
        requires is_reference_v<Deleter>
    unique_ptr(U, remove_reference_t<Deleter>&&) = delete;

    constexpr unique_ptr(unique_ptr&& other) noexcept
        requires is_move_constructible_v<Deleter>
        : m_pointer(other.release()), m_deleter(_FSTD::forward<Deleter>(other.get_deleter()))
    {
    }

    template <class U, class E>
        requires is_array_v<U> && is_same_v<pointer, element_type*> &&
                     is_same_v<typename unique_ptr<U, E>::pointer,
                               typename unique_ptr<U, E>::element_type*> &&
                     is_convertible_v<typename unique_ptr<U, E>::element_type (*)[],
                                      element_type (*)[]> &&
                     __detail::UniqueDeleterFrom<Deleter, E>
    constexpr unique_ptr(unique_ptr<U, E>&& other) noexcept
        : m_pointer(other.release()), m_deleter(_FSTD::forward<E>(other.get_deleter()))
    {
    }

    constexpr ~unique_ptr()
    {
        if (m_pointer != nullptr)
        {
            m_deleter(m_pointer);
        }
    }

    constexpr unique_ptr& operator=(unique_ptr&& other) noexcept
        requires is_move_assignable_v<Deleter>
    {
        reset(other.release());
        m_deleter = _FSTD::forward<Deleter>(other.get_deleter());
        return *this;
    }

    template <class U, class E>
        requires is_array_v<U> && is_same_v<pointer, element_type*> &&
                 is_same_v<typename unique_ptr<U, E>::pointer,
                           typename unique_ptr<U, E>::element_type*> &&
                 is_convertible_v<typename unique_ptr<U, E>::element_type (*)[],
                                  element_type (*)[]> &&
                 is_assignable_v<Deleter&, E&&>
    constexpr unique_ptr& operator=(unique_ptr<U, E>&& other) noexcept
    {
        reset(other.release());
        m_deleter = _FSTD::forward<E>(other.get_deleter());
        return *this;
    }

    constexpr unique_ptr& operator=(nullptr_t) noexcept
    {
        reset();
        return *this;
    }

    constexpr T& operator[](size_t index) const
    {
        return m_pointer[index];
    }

    constexpr pointer get() const noexcept
    {
        return m_pointer;
    }

    constexpr Deleter& get_deleter() noexcept
    {
        return m_deleter;
    }

    constexpr const Deleter& get_deleter() const noexcept
    {
        return m_deleter;
    }

    constexpr explicit operator bool() const noexcept
    {
        return m_pointer != nullptr;
    }

    constexpr pointer release() noexcept
    {
        return _FSTD::exchange(m_pointer, pointer());
    }

    template <class U>
        requires AcceptsPointer<U>
    constexpr void reset(U value) noexcept
    {
        pointer old = _FSTD::exchange(m_pointer, value);
        if (old != nullptr)
        {
            m_deleter(old);
        }
    }

    constexpr void reset(nullptr_t = nullptr) noexcept
    {
        reset(pointer());
    }

    constexpr void swap(unique_ptr& other) noexcept
    {
        using _FSTD::swap;
        swap(m_pointer, other.m_pointer);
        swap(m_deleter, other.m_deleter);
    }

private:
    pointer m_pointer;
    [[no_unique_address]] Deleter m_deleter;
};

