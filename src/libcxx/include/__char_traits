// -*- C++ -*-
#ifndef FEATHEROS_LIBCXX_CHAR_TRAITS
#define FEATHEROS_LIBCXX_CHAR_TRAITS

// char_traits, shared by <string_view> and <string>. Without iostreams there are no pos_type,
// off_type or state_type.

#include "__featheros_config"
#include "compare"
#include "cstdint"
#include "type_traits"

namespace FEATHEROS_STD_NAMESPACE
{

namespace __detail
{
// Lengths and searches are loops: the kernel has memcmp, memmove, memcpy and memset, which the
// builtins become, but no strlen or memchr.
template <class CharT, class IntT, IntT EndOfFile> struct CharTraitsBase
{
    using char_type = CharT;
    using int_type = IntT;
    using comparison_category = strong_ordering;

    static constexpr void assign(char_type& target, const char_type& source) noexcept
    {
        target = source;
    }
    static constexpr bool eq(char_type left, char_type right) noexcept
    {
        return left == right;
    }
    static constexpr bool lt(char_type left, char_type right) noexcept
    {
        if constexpr (is_same_v<CharT, char>)
        {
            return static_cast<unsigned char>(left) < static_cast<unsigned char>(right);
        }
        else
        {
            return left < right;
        }
    }

    static constexpr int compare(const char_type* left, const char_type* right,
                                 size_t count) noexcept
    {
        if (count == 0)
        {
            return 0;
        }
        if constexpr (sizeof(CharT) == 1)
        {
            if (!__builtin_is_constant_evaluated())
            {
                return __builtin_memcmp(left, right, count);
            }
        }
        for (size_t index = 0; index < count; ++index)
        {
            if (lt(left[index], right[index]))
            {
                return -1;
            }
            if (lt(right[index], left[index]))
            {
                return 1;
            }
        }
        return 0;
    }

    static constexpr size_t length(const char_type* text) noexcept
    {
        size_t count = 0;
        while (!eq(text[count], char_type()))
        {
            ++count;
        }
        return count;
    }

    static constexpr const char_type* find(const char_type* text, size_t count,
                                           const char_type& wanted) noexcept
    {
        for (size_t index = 0; index < count; ++index)
        {
            if (eq(text[index], wanted))
            {
                return text + index;
            }
        }
        return nullptr;
    }

    static constexpr char_type* move(char_type* target, const char_type* source,
                                     size_t count) noexcept
    {
        if (count == 0)
        {
            return target;
        }
        if (__builtin_is_constant_evaluated())
        {
            // Constant evaluation cannot compare unrelated pointers, so walk one of them.
            bool overlaps_after = false;
            for (const char_type* scan = source; scan != source + count; ++scan)
            {
                if (scan == target)
                {
                    overlaps_after = true;
                    break;
                }
            }
            if (overlaps_after)
            {
                for (size_t index = count; index > 0; --index)
                {
                    target[index - 1] = source[index - 1];
                }
            }
            else
            {
                for (size_t index = 0; index < count; ++index)
                {
                    target[index] = source[index];
                }
            }
            return target;
        }
        __builtin_memmove(target, source, count * sizeof(char_type));
        return target;
    }

    static constexpr char_type* copy(char_type* target, const char_type* source,
                                     size_t count) noexcept
    {
        if (count == 0)
        {
            return target;
        }
        if (__builtin_is_constant_evaluated())
        {
            for (size_t index = 0; index < count; ++index)
            {
                target[index] = source[index];
            }
            return target;
        }
        __builtin_memcpy(target, source, count * sizeof(char_type));
        return target;
    }

    static constexpr char_type* assign(char_type* target, size_t count, char_type value) noexcept
    {
        if constexpr (sizeof(CharT) == 1)
        {
            if (!__builtin_is_constant_evaluated())
            {
                if (count != 0)
                {
                    __builtin_memset(target, static_cast<unsigned char>(value), count);
                }
                return target;
            }
        }
        for (size_t index = 0; index < count; ++index)
        {
            target[index] = value;
        }
        return target;
    }

    static constexpr int_type not_eof(int_type value) noexcept
    {
        return eq_int_type(value, eof()) ? static_cast<int_type>(~eof()) : value;
    }
    static constexpr char_type to_char_type(int_type value) noexcept
    {
        return static_cast<char_type>(value);
    }
    static constexpr int_type to_int_type(char_type value) noexcept
    {
        if constexpr (is_same_v<CharT, char>)
        {
            return static_cast<int_type>(static_cast<unsigned char>(value));
        }
        else
        {
            return static_cast<int_type>(value);
        }
    }
    static constexpr bool eq_int_type(int_type left, int_type right) noexcept
    {
        return left == right;
    }
    static constexpr int_type eof() noexcept
    {
        return EndOfFile;
    }
};
} // namespace __detail

template <class CharT> struct char_traits;

template <> struct char_traits<char> : __detail::CharTraitsBase<char, int, -1>
{
};
template <>
struct char_traits<wchar_t>
    : __detail::CharTraitsBase<wchar_t, __WINT_TYPE__, static_cast<__WINT_TYPE__>(-1)>
{
};
template <>
struct char_traits<char8_t> : __detail::CharTraitsBase<char8_t, unsigned int, 0xFFFFFFFFu>
{
};
template <>
struct char_traits<char16_t>
    : __detail::CharTraitsBase<char16_t, uint_least16_t, static_cast<uint_least16_t>(0xFFFF)>
{
};
template <>
struct char_traits<char32_t>
    : __detail::CharTraitsBase<char32_t, uint_least32_t, static_cast<uint_least32_t>(0xFFFFFFFF)>
{
};

} // namespace FEATHEROS_STD_NAMESPACE

#endif
