// -*- C++ -*-
#ifndef FEATHEROS_LIBCXX_SPAN
#define FEATHEROS_LIBCXX_SPAN

#include "__featheros_config"
#include "__iterator_base"
#include "__memory_base"
#include "array"
#include "cstddef"
#include "type_traits"

namespace FEATHEROS_STD_NAMESPACE
{

inline constexpr size_t dynamic_extent = static_cast<size_t>(-1);

template <class T, size_t Extent = dynamic_extent> class span;

namespace __detail
{
template <class T> struct IsSpan : false_type
{
};
template <class T, size_t Extent> struct IsSpan<span<T, Extent>> : true_type
{
};

template <class T> struct IsStdArray : false_type
{
};
template <class T, size_t Size> struct IsStdArray<array<T, Size>> : true_type
{
};

// A qualification conversion only: span<const int> from int, never span<Base> from Derived.
template <class From, class To>
concept ArrayConvertible = is_convertible_v<From (*)[], To (*)[]>;

template <class Iterator, class T>
concept SpanCompatibleIterator =
    contiguous_iterator<Iterator> &&
    ArrayConvertible<remove_reference_t<iter_reference_t<Iterator>>, T>;

template <class Range, class T>
concept SpanCompatibleRange =
    ranges::contiguous_range<Range> && ranges::sized_range<Range> &&
    (ranges::borrowed_range<Range> || is_const_v<T>) && !IsSpan<remove_cvref_t<Range>>::value &&
    !IsStdArray<remove_cvref_t<Range>>::value && !is_array_v<remove_cvref_t<Range>> &&
    ArrayConvertible<remove_reference_t<ranges::range_reference_t<Range>>, T>;

// A span of fixed extent is one pointer; only a dynamic one stores its size.
template <size_t Extent> struct SpanSize
{
    constexpr explicit SpanSize(size_t) noexcept {}
    static constexpr size_t Get() noexcept
    {
        return Extent;
    }
};
template <> struct SpanSize<dynamic_extent>
{
    constexpr explicit SpanSize(size_t size) noexcept : m_size(size) {}
    constexpr size_t Get() const noexcept
    {
        return m_size;
    }
    size_t m_size;
};
} // namespace __detail

template <class T, size_t Extent> class span
{
public:
    using element_type = T;
    using value_type = remove_cv_t<T>;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using pointer = T*;
    using const_pointer = const T*;
    using reference = T&;
    using const_reference = const T&;
    using iterator = T*;
    using const_iterator = const T*;
    using reverse_iterator = _FSTD::reverse_iterator<iterator>;
    using const_reverse_iterator = _FSTD::reverse_iterator<const_iterator>;

    static constexpr size_type extent = Extent;

    constexpr span() noexcept
        requires(Extent == dynamic_extent || Extent == 0)
        : m_data(nullptr), m_size(0)
    {
    }

    template <__detail::SpanCompatibleIterator<T> Iterator>
    constexpr explicit(Extent != dynamic_extent) span(Iterator first, size_type count)
        : m_data(_FSTD::to_address(first)), m_size(count)
    {
    }

    template <__detail::SpanCompatibleIterator<T> Iterator, sized_sentinel_for<Iterator> End>
        requires(!is_convertible_v<End, size_t>)
    constexpr explicit(Extent != dynamic_extent) span(Iterator first, End last)
        : m_data(_FSTD::to_address(first)), m_size(static_cast<size_type>(last - first))
    {
    }

    template <size_t Size>
        requires(Extent == dynamic_extent || Extent == Size)
    constexpr span(type_identity_t<element_type> (&elements)[Size]) noexcept
        : m_data(elements), m_size(Size)
    {
    }

    template <class U, size_t Size>
        requires(Extent == dynamic_extent || Extent == Size) && __detail::ArrayConvertible<U, T>
    constexpr span(array<U, Size>& elements) noexcept : m_data(elements.data()), m_size(Size)
    {
    }

    template <class U, size_t Size>
        requires(Extent == dynamic_extent || Extent == Size) &&
                    __detail::ArrayConvertible<const U, T>
    constexpr span(const array<U, Size>& elements) noexcept : m_data(elements.data()), m_size(Size)
    {
    }

    template <__detail::SpanCompatibleRange<T> Range>
    constexpr explicit(Extent != dynamic_extent) span(Range&& range)
        : m_data(ranges::data(range)), m_size(static_cast<size_type>(ranges::size(range)))
    {
    }

    template <class U, size_t OtherExtent>
        requires(Extent == dynamic_extent || OtherExtent == dynamic_extent ||
                 Extent == OtherExtent) &&
                    __detail::ArrayConvertible<U, T>
    constexpr explicit(Extent != dynamic_extent && OtherExtent == dynamic_extent)
        span(const span<U, OtherExtent>& other) noexcept
        : m_data(other.data()), m_size(other.size())
    {
    }

    constexpr span(const span&) noexcept = default;
    constexpr span& operator=(const span&) noexcept = default;

    template <size_t Count> constexpr span<T, Count> first() const
    {
        static_assert(Extent == dynamic_extent || Count <= Extent, "span::first beyond extent");
        return span<T, Count>(data(), Count);
    }

    template <size_t Count> constexpr span<T, Count> last() const
    {
        static_assert(Extent == dynamic_extent || Count <= Extent, "span::last beyond extent");
        return span<T, Count>(data() + (size() - Count), Count);
    }

    template <size_t Offset, size_t Count = dynamic_extent> constexpr auto subspan() const
    {
        static_assert(Extent == dynamic_extent || Offset <= Extent, "span::subspan beyond extent");
        static_assert(Count == dynamic_extent || Extent == dynamic_extent ||
                          Count <= Extent - Offset,
                      "span::subspan beyond extent");
        constexpr size_t Result = Count != dynamic_extent    ? Count
                                  : Extent != dynamic_extent ? Extent - Offset
                                                             : dynamic_extent;
        return span<T, Result>(data() + Offset, Count == dynamic_extent ? size() - Offset : Count);
    }

    constexpr span<T, dynamic_extent> first(size_type count) const
    {
        return {data(), count};
    }

    constexpr span<T, dynamic_extent> last(size_type count) const
    {
        return {data() + (size() - count), count};
    }

    constexpr span<T, dynamic_extent> subspan(size_type offset,
                                              size_type count = dynamic_extent) const
    {
        return {data() + offset, count == dynamic_extent ? size() - offset : count};
    }

    constexpr size_type size() const noexcept
    {
        return m_size.Get();
    }
    constexpr size_type size_bytes() const noexcept
    {
        return size() * sizeof(T);
    }
    [[nodiscard]] constexpr bool empty() const noexcept
    {
        return size() == 0;
    }

    constexpr reference operator[](size_type index) const
    {
        return m_data[index];
    }
    constexpr reference at(size_type index) const
    {
        if (index >= size())
        {
            __detail::LibraryAbort("span::at: index out of range");
        }
        return m_data[index];
    }
    constexpr reference front() const
    {
        return m_data[0];
    }
    constexpr reference back() const
    {
        return m_data[size() - 1];
    }
    constexpr pointer data() const noexcept
    {
        return m_data;
    }

    constexpr iterator begin() const noexcept
    {
        return m_data;
    }
    constexpr iterator end() const noexcept
    {
        return m_data + size();
    }
    constexpr const_iterator cbegin() const noexcept
    {
        return begin();
    }
    constexpr const_iterator cend() const noexcept
    {
        return end();
    }
    constexpr reverse_iterator rbegin() const noexcept
    {
        return reverse_iterator(end());
    }
    constexpr reverse_iterator rend() const noexcept
    {
        return reverse_iterator(begin());
    }
    constexpr const_reverse_iterator crbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    constexpr const_reverse_iterator crend() const noexcept
    {
        return const_reverse_iterator(begin());
    }

private:
    pointer m_data;
    [[no_unique_address]] __detail::SpanSize<Extent> m_size;
};

template <contiguous_iterator Iterator, class End>
span(Iterator, End) -> span<remove_reference_t<iter_reference_t<Iterator>>>;
template <class T, size_t Size> span(T (&)[Size]) -> span<T, Size>;
template <class T, size_t Size> span(array<T, Size>&) -> span<T, Size>;
template <class T, size_t Size> span(const array<T, Size>&) -> span<const T, Size>;
template <class Range> span(Range&&) -> span<remove_reference_t<ranges::range_reference_t<Range>>>;

namespace ranges
{
template <class T, size_t Extent>
inline constexpr bool enable_borrowed_range<span<T, Extent>> = true;
template <class T, size_t Extent> inline constexpr bool enable_view<span<T, Extent>> = true;
} // namespace ranges

template <class T, size_t Extent>
span<const byte, Extent == dynamic_extent ? dynamic_extent : sizeof(T) * Extent>
as_bytes(span<T, Extent> elements) noexcept
{
    return span<const byte, Extent == dynamic_extent ? dynamic_extent : sizeof(T) * Extent>(
        reinterpret_cast<const byte*>(elements.data()), elements.size_bytes());
}

template <class T, size_t Extent>
    requires(!is_const_v<T>)
span<byte, Extent == dynamic_extent ? dynamic_extent : sizeof(T) * Extent>
as_writable_bytes(span<T, Extent> elements) noexcept
{
    return span<byte, Extent == dynamic_extent ? dynamic_extent : sizeof(T) * Extent>(
        reinterpret_cast<byte*>(elements.data()), elements.size_bytes());
}

} // namespace FEATHEROS_STD_NAMESPACE

#endif
