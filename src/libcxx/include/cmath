}

template <class A, class B, class C>
    requires(is_arithmetic_v<A> && is_arithmetic_v<B> && is_arithmetic_v<C>)
inline __detail::MathPromoted<A, B, C> hypot(A x, B y, C z)
{
    using P = __detail::MathPromoted<A, B, C>;
    const P a = _FSTD::fabs(static_cast<P>(x));
    const P b = _FSTD::fabs(static_cast<P>(y));
    const P c = _FSTD::fabs(static_cast<P>(z));
    const P largest = a > b ? (a > c ? a : c) : (b > c ? b : c);
    if (largest == P(0) || __builtin_isinf(largest))
    {
        return largest;
    }
    // Scaled by the largest, so the squares neither overflow nor vanish.
    const P sa = a / largest;
    const P sb = b / largest;
    const P sc = c / largest;
    return largest * _FSTD::sqrt(sa * sa + sb * sb + sc * sc);
}

// [c.math.lerp]: exact at both ends, monotonic, and lerp(a, a, t) is a.
template <class T>
    requires is_floating_point_v<T>
constexpr T lerp(T a, T b, T t) noexcept
{
    if ((a <= 0 && b >= 0) || (a >= 0 && b <= 0))
    {
        return t * b + (1 - t) * a;
    }
    if (t == 1)
    {
        return b;
    }
    const T x = a + t * (b - a);
    if ((t > 1) == (b > a))
    {
        return b < x ? x : b;
    }
    return x < b ? x : b;
}
template <class A, class B, class C>
    requires __detail::MathNeedsPromotion<A, B, C>
constexpr __detail::MathPromoted<A, B, C> lerp(A a, B b, C t) noexcept
{
    using P = __detail::MathPromoted<A, B, C>;
    return _FSTD::lerp(static_cast<P>(a), static_cast<P>(b), static_cast<P>(t));
}

template <class T>
    requires is_arithmetic_v<T>
constexpr int fpclassify(T x) noexcept
{
    if constexpr (is_integral_v<T>)
    {
        return x == 0 ? FP_ZERO : FP_NORMAL;
    }
    else
    {
        return __builtin_fpclassify(FP_NAN, FP_INFINITE, FP_NORMAL, FP_SUBNORMAL, FP_ZERO, x);
    }
}

template <class T>
    requires is_arithmetic_v<T>
constexpr bool isfinite(T x) noexcept
{
    if constexpr (is_integral_v<T>)
    {
        return true;
    }
    else
    {
        return __builtin_isfinite(x);
    }
}

template <class T>
    requires is_arithmetic_v<T>
constexpr bool isinf(T x) noexcept
{
    if constexpr (is_integral_v<T>)
    {
        return false;
    }
    else
    {
        return __builtin_isinf(x);
    }
}

template <class T>
    requires is_arithmetic_v<T>
constexpr bool isnan(T x) noexcept
{
    if constexpr (is_integral_v<T>)
    {
        return false;
    }
    else
    {
        return __builtin_isnan(x);
    }
}

template <class T>
    requires is_arithmetic_v<T>
constexpr bool isnormal(T x) noexcept
{
    if constexpr (is_integral_v<T>)
    {
        return x != 0;
    }
    else
    {
        return __builtin_isnormal(x);
    }
}

template <class T>
    requires is_arithmetic_v<T>
constexpr bool signbit(T x) noexcept
{
    if constexpr (is_integral_v<T>)
    {
        return x < 0;
    }
    else
    {
        return __builtin_signbit(x);
    }
}

#define __FEATHEROS_CMATH_COMPARISON(name)                                                         \
    template <class A, class B>                                                                    \
        requires(is_arithmetic_v<A> && is_arithmetic_v<B>)                                         \
    constexpr bool name(A x, B y) noexcept                                                         \
    {                                                                                              \
        using P = __detail::MathPromoted<A, B>;                                                    \
        return __builtin_##name(static_cast<P>(x), static_cast<P>(y));                             \
    }
