// FLT_EVAL_METHOD is 0 on both targets.
using float_t = float;
using double_t = double;

// The double forms are wrappers rather than using-declarations, since a host's <math.h> may
// already declare the float and long double overloads in the global namespace.
namespace __detail
{
// [cmath.syn]: integer arguments are taken as double, and mixed arguments as the widest type.
template <class... T>
using MathPromoted = conditional_t<
    (is_same_v<T, long double> || ...), long double,
    conditional_t<((is_same_v<T, double> || is_integral_v<T>) || ...), double, float>>;

// Arguments that the exact overloads do not take: an integer, or floating-point types that
// differ. Equal floating-point types without an overload (long double where the C library has no
// l function) must stay an ambiguity rather than recurse.
template <class... T>
inline constexpr bool MathNeedsPromotion =
    ((is_arithmetic_v<T> && ...) && !(is_floating_point_v<T> && ...)) ||
    ((is_floating_point_v<T> && ...) && !(is_same_v<MathPromoted<T...>, T> && ...));
} // namespace __detail

#define __FEATHEROS_CMATH_GENERIC_1(name)                                                          \
    template <class T>                                                                             \
        requires is_integral_v<T>                                                                  \
    inline double name(T x)                                                                        \
    {                                                                                              \
        return ::name(static_cast<double>(x));                                                     \
    }
#define __FEATHEROS_CMATH_GENERIC_2(name)                                                          \
    template <class A, class B>                                                                    \
        requires __detail::MathNeedsPromotion<A, B>                                                \
    inline __detail::MathPromoted<A, B> name(A x, B y)                                             \
    {                                                                                              \
        using P = __detail::MathPromoted<A, B>;                                                    \
        return _FSTD::name(static_cast<P>(x), static_cast<P>(y));                                  \
    }
