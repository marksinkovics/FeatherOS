// The C library has no float forms of these; through double they are exact.
inline double frexp(double x, int* exponent)
{
    return ::frexp(x, exponent);
}
inline double ldexp(double x, int exponent)
{
    return ::ldexp(x, exponent);
}
inline double scalbn(double x, int exponent)
{
    return ::scalbn(x, exponent);
}
inline double modf(double x, double* integer)
{
    return ::modf(x, integer);
}
inline float frexp(float x, int* exponent)
{
    return static_cast<float>(::frexp(x, exponent));
}
inline float ldexp(float x, int exponent)
{
    return static_cast<float>(::ldexp(x, exponent));
}
inline float scalbn(float x, int exponent)
{
    return static_cast<float>(::scalbn(x, exponent));
}
inline float modf(float x, float* integer)
{
    double whole = 0;
    const auto fraction = static_cast<float>(::modf(x, &whole));
    *integer = static_cast<float>(whole);
    return fraction;
}
