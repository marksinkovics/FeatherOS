// No std::bind or its placeholders, no move_only_function, no searchers, and function has no
// target_type, which needs RTTI. Calling an empty function calls the library's abort hook
// instead of throwing bad_function_call.

namespace FEATHEROS_STD_NAMESPACE
{

template <class Callable, class... Args>
    requires is_invocable_v<Callable, Args...>
constexpr invoke_result_t<Callable, Args...>
invoke(Callable&& callable, Args&&... args) noexcept(is_nothrow_invocable_v<Callable, Args...>)
{
    return __detail::Invoke(_FSTD::forward<Callable>(callable), _FSTD::forward<Args>(args)...);
}

template <class Result, class Callable, class... Args>
    requires is_invocable_r_v<Result, Callable, Args...>
constexpr Result
invoke_r(Callable&& callable,
         Args&&... args) noexcept(is_nothrow_invocable_r_v<Result, Callable, Args...>)
{
    if constexpr (is_void_v<Result>)
    {
        __detail::Invoke(_FSTD::forward<Callable>(callable), _FSTD::forward<Args>(args)...);
    }
    else
    {
        return __detail::Invoke(_FSTD::forward<Callable>(callable), _FSTD::forward<Args>(args)...);
    }
}

namespace __detail
