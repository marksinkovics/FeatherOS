// The operator function objects. The typed ones return T (or bool), so bit_not<unsigned char>
// does not promote; the void forms deduce their operands and are transparent.
#define FEATHEROS_BINARY_FUNCTION_OBJECT(name, op, Result)                                         \
    template <class T = void> struct name                                                          \
    {                                                                                              \
        constexpr Result operator()(const T& left, const T& right) const                           \
        {                                                                                          \
            return left op right;                                                                  \
        }                                                                                          \
    };                                                                                             \
    template <> struct name<void>                                                                  \
    {                                                                                              \
        template <class T, class U>                                                                \
        constexpr auto operator()(T&& left, U&& right) const                                       \
            noexcept(noexcept(_FSTD::forward<T>(left) op _FSTD::forward<U>(right)))                \
                -> decltype(_FSTD::forward<T>(left) op _FSTD::forward<U>(right))                   \
        {                                                                                          \
            return _FSTD::forward<T>(left) op _FSTD::forward<U>(right);                            \
        }                                                                                          \
        using is_transparent = void;                                                               \
    };

FEATHEROS_BINARY_FUNCTION_OBJECT(plus, +, T)
FEATHEROS_BINARY_FUNCTION_OBJECT(minus, -, T)
FEATHEROS_BINARY_FUNCTION_OBJECT(multiplies, *, T)
FEATHEROS_BINARY_FUNCTION_OBJECT(divides, /, T)
FEATHEROS_BINARY_FUNCTION_OBJECT(modulus, %, T)
FEATHEROS_BINARY_FUNCTION_OBJECT(equal_to, ==, bool)
FEATHEROS_BINARY_FUNCTION_OBJECT(not_equal_to, !=, bool)
FEATHEROS_BINARY_FUNCTION_OBJECT(greater, >, bool)
FEATHEROS_BINARY_FUNCTION_OBJECT(less, <, bool)
FEATHEROS_BINARY_FUNCTION_OBJECT(greater_equal, >=, bool)
FEATHEROS_BINARY_FUNCTION_OBJECT(less_equal, <=, bool)
FEATHEROS_BINARY_FUNCTION_OBJECT(logical_and, &&, bool)
FEATHEROS_BINARY_FUNCTION_OBJECT(logical_or, ||, bool)
FEATHEROS_BINARY_FUNCTION_OBJECT(bit_and, &, T)
FEATHEROS_BINARY_FUNCTION_OBJECT(bit_or, |, T)
FEATHEROS_BINARY_FUNCTION_OBJECT(bit_xor, ^, T)

#undef FEATHEROS_BINARY_FUNCTION_OBJECT

#define FEATHEROS_UNARY_FUNCTION_OBJECT(name, op, Result)                                          \
    template <class T = void> struct name                                                          \
    {                                                                                              \
        constexpr Result operator()(const T& value) const                                          \
        {                                                                                          \
            return op value;                                                                       \
        }                                                                                          \
    };                                                                                             \
    template <> struct name<void>                                                                  \
    {                                                                                              \
        template <class T>                                                                         \
        constexpr auto operator()(T&& value) const noexcept(noexcept(op _FSTD::forward<T>(value))) \
            -> decltype(op _FSTD::forward<T>(value))                                               \
        {                                                                                          \
            return op _FSTD::forward<T>(value);                                                    \
        }                                                                                          \
        using is_transparent = void;                                                               \
    };

FEATHEROS_UNARY_FUNCTION_OBJECT(negate, -, T)
FEATHEROS_UNARY_FUNCTION_OBJECT(logical_not, !, bool)
FEATHEROS_UNARY_FUNCTION_OBJECT(bit_not, ~, T)

#undef FEATHEROS_UNARY_FUNCTION_OBJECT

struct identity
{
    template <class T> [[nodiscard]] constexpr T&& operator()(T&& value) const noexcept
    {
        return _FSTD::forward<T>(value);
    }
    using is_transparent = void;
};

// The constrained comparisons of ranges' algorithms. less, greater and their kin compare
// pointers by address order, which the built-in < already does in GCC and Clang.
namespace ranges
{
struct equal_to
{
    template <class T, class U>
        requires equality_comparable_with<T, U>
    constexpr bool operator()(T&& left, U&& right) const
        noexcept(noexcept(bool(_FSTD::forward<T>(left) == _FSTD::forward<U>(right))))
    {
        return _FSTD::forward<T>(left) == _FSTD::forward<U>(right);
    }
    using is_transparent = void;
};

struct not_equal_to
{
    template <class T, class U>
        requires equality_comparable_with<T, U>
    constexpr bool operator()(T&& left, U&& right) const
        noexcept(noexcept(bool(_FSTD::forward<T>(left) == _FSTD::forward<U>(right))))
    {
        return !(_FSTD::forward<T>(left) == _FSTD::forward<U>(right));
    }
    using is_transparent = void;
};

struct less
{
    template <class T, class U>
        requires totally_ordered_with<T, U>
    constexpr bool operator()(T&& left, U&& right) const
        noexcept(noexcept(bool(_FSTD::forward<T>(left) < _FSTD::forward<U>(right))))
    {
        return _FSTD::forward<T>(left) < _FSTD::forward<U>(right);
    }
    using is_transparent = void;
};

struct greater
{
    template <class T, class U>
        requires totally_ordered_with<T, U>
    constexpr bool operator()(T&& left, U&& right) const
        noexcept(noexcept(bool(_FSTD::forward<U>(right) < _FSTD::forward<T>(left))))
    {
        return _FSTD::forward<U>(right) < _FSTD::forward<T>(left);
    }
    using is_transparent = void;
};

struct greater_equal
{
    template <class T, class U>
        requires totally_ordered_with<T, U>
    constexpr bool operator()(T&& left, U&& right) const
        noexcept(noexcept(bool(_FSTD::forward<T>(left) < _FSTD::forward<U>(right))))
    {
        return !(_FSTD::forward<T>(left) < _FSTD::forward<U>(right));
    }
    using is_transparent = void;
};

struct less_equal
{
    template <class T, class U>
        requires totally_ordered_with<T, U>
    constexpr bool operator()(T&& left, U&& right) const
        noexcept(noexcept(bool(_FSTD::forward<U>(right) < _FSTD::forward<T>(left))))
    {
        return !(_FSTD::forward<U>(right) < _FSTD::forward<T>(left));
    }
    using is_transparent = void;
};
} // namespace ranges

