template <class T> constexpr T& BindReference(T& value) noexcept
{
    return value;
}
template <class T> void BindReference(T&&) = delete;
} // namespace __detail

template <class T> class reference_wrapper
{
public:
    using type = T;

    template <class U>
        requires requires { __detail::BindReference<T>(declval<U>()); } &&
                 (!is_same_v<remove_cvref_t<U>, reference_wrapper>)
    constexpr reference_wrapper(U&& value) noexcept(
        noexcept(__detail::BindReference<T>(declval<U>())))
        : m_pointer(_FSTD::addressof(__detail::BindReference<T>(_FSTD::forward<U>(value))))
    {
    }

    constexpr reference_wrapper(const reference_wrapper&) noexcept = default;
    constexpr reference_wrapper& operator=(const reference_wrapper&) noexcept = default;

    constexpr operator T&() const noexcept
    {
        return *m_pointer;
    }
    constexpr T& get() const noexcept
    {
        return *m_pointer;
    }

    template <class... Args>
    constexpr invoke_result_t<T&, Args...> operator()(Args&&... args) const
        noexcept(is_nothrow_invocable_v<T&, Args...>)
    {
        return __detail::Invoke(get(), _FSTD::forward<Args>(args)...);
    }

private:
    T* m_pointer;
};

template <class T> reference_wrapper(T&) -> reference_wrapper<T>;

template <class T> constexpr reference_wrapper<T> ref(T& value) noexcept
{
    return reference_wrapper<T>(value);
}
template <class T> constexpr reference_wrapper<T> ref(reference_wrapper<T> value) noexcept
{
    return value;
}
template <class T> void ref(const T&&) = delete;

template <class T> constexpr reference_wrapper<const T> cref(const T& value) noexcept
{
