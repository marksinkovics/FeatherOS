template <class Result, class... Args>
bool operator==(const function<Result(Args...)>& callable, nullptr_t) noexcept
{
    return !callable;
}

template <class Result, class... Args>
void swap(function<Result(Args...)>& left, function<Result(Args...)>& right) noexcept
{
    left.swap(right);
