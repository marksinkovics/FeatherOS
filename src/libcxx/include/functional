struct WrapCallable
{
    explicit WrapCallable() = default;
};

// The perfect forwarding call wrapper of not_fn, bind_front and bind_back. Each call operator
// passes the stored callable and arguments on with the wrapper's own constness and value
// category, and where that call is ill-formed it is deleted, so an rvalue wrapper does not
// fall back to the const lvalue overload.
template <class Operation, class... State> class ForwardingWrapper
{
public:
    template <class... T>
    constexpr explicit ForwardingWrapper(WrapCallable, T&&... state)
        : m_state(_FSTD::forward<T>(state)...)
    {
    }

#define FEATHEROS_FORWARDING_CALL(qualifiers, cast)                                                \
    template <class... Args>                                                                       \
        requires requires {                                                                        \
            Operation::Call(declval<tuple<State...> qualifiers>(), declval<Args>()...);            \
        }                                                                                          \
    constexpr decltype(auto) operator()(Args&&... args) qualifiers noexcept(                       \
        noexcept(Operation::Call(declval<tuple<State...> qualifiers>(), declval<Args>()...)))      \
    {                                                                                              \
        return Operation::Call(cast(m_state), _FSTD::forward<Args>(args)...);                      \
    }                                                                                              \
    template <class... Args>                                                                       \
        requires(!requires {                                                                       \
                    Operation::Call(declval<tuple<State...> qualifiers>(), declval<Args>()...);    \
                })                                                                                 \
    void operator()(Args&&...) qualifiers = delete;

    FEATHEROS_FORWARDING_CALL(&, )
    FEATHEROS_FORWARDING_CALL(const&, )
    FEATHEROS_FORWARDING_CALL(&&, _FSTD::move)
    FEATHEROS_FORWARDING_CALL(const&&, _FSTD::move)

#undef FEATHEROS_FORWARDING_CALL

private:
    tuple<State...> m_state;
};

struct NotCall
{
    template <class State, class... Args>
    static constexpr auto Call(State&& state, Args&&... args) noexcept(noexcept(!__detail::Invoke(
        _FSTD::get<0>(_FSTD::forward<State>(state)), _FSTD::forward<Args>(args)...)))
        -> decltype(!__detail::Invoke(_FSTD::get<0>(_FSTD::forward<State>(state)),
                                      _FSTD::forward<Args>(args)...))
    {
        return !__detail::Invoke(_FSTD::get<0>(_FSTD::forward<State>(state)),
                                 _FSTD::forward<Args>(args)...);
    }
};

template <class Indices> struct BindFrontCall;
template <size_t... Index> struct BindFrontCall<index_sequence<Index...>>
{
    template <class State, class... Args>
    static constexpr auto Call(State&& state, Args&&... args) noexcept(noexcept(__detail::Invoke(
        _FSTD::get<0>(_FSTD::forward<State>(state)),
        _FSTD::get<Index + 1>(_FSTD::forward<State>(state))..., _FSTD::forward<Args>(args)...)))
        -> decltype(__detail::Invoke(_FSTD::get<0>(_FSTD::forward<State>(state)),
                                     _FSTD::get<Index + 1>(_FSTD::forward<State>(state))...,
                                     _FSTD::forward<Args>(args)...))
    {
        return __detail::Invoke(_FSTD::get<0>(_FSTD::forward<State>(state)),
                                _FSTD::get<Index + 1>(_FSTD::forward<State>(state))...,
                                _FSTD::forward<Args>(args)...);
    }
};

template <class Indices> struct BindBackCall;
template <size_t... Index> struct BindBackCall<index_sequence<Index...>>
{
    template <class State, class... Args>
    static constexpr auto Call(State&& state, Args&&... args) noexcept(noexcept(
        __detail::Invoke(_FSTD::get<0>(_FSTD::forward<State>(state)), _FSTD::forward<Args>(args)...,
                         _FSTD::get<Index + 1>(_FSTD::forward<State>(state))...)))
        -> decltype(__detail::Invoke(_FSTD::get<0>(_FSTD::forward<State>(state)),
                                     _FSTD::forward<Args>(args)...,
                                     _FSTD::get<Index + 1>(_FSTD::forward<State>(state))...))
    {
        return __detail::Invoke(_FSTD::get<0>(_FSTD::forward<State>(state)),
                                _FSTD::forward<Args>(args)...,
                                _FSTD::get<Index + 1>(_FSTD::forward<State>(state))...);
    }
};

template <class T>
concept DecayCopyable = is_constructible_v<decay_t<T>, T> && is_move_constructible_v<decay_t<T>>;
} // namespace __detail

template <__detail::DecayCopyable F> constexpr auto not_fn(F&& callable)
{
    return __detail::ForwardingWrapper<__detail::NotCall, decay_t<F>>(__detail::WrapCallable{},
                                                                      _FSTD::forward<F>(callable));
}

template <__detail::DecayCopyable F, __detail::DecayCopyable... Args>
constexpr auto bind_front(F&& callable, Args&&... args)
{
    return __detail::ForwardingWrapper<__detail::BindFrontCall<index_sequence_for<Args...>>,
                                       decay_t<F>, decay_t<Args>...>(
        __detail::WrapCallable{}, _FSTD::forward<F>(callable), _FSTD::forward<Args>(args)...);
}

template <__detail::DecayCopyable F, __detail::DecayCopyable... Args>
constexpr auto bind_back(F&& callable, Args&&... args)
{
    return __detail::ForwardingWrapper<__detail::BindBackCall<index_sequence_for<Args...>>,
                                       decay_t<F>, decay_t<Args>...>(
        __detail::WrapCallable{}, _FSTD::forward<F>(callable), _FSTD::forward<Args>(args)...);
}

