template <class T> struct IsFunctionWrapper : false_type
{
};
template <class Signature> struct IsFunctionWrapper<function<Signature>> : true_type
{
};

template <class T> constexpr bool IsNullCallable(const T& callable) noexcept
{
    if constexpr (is_pointer_v<T> || is_member_pointer_v<T>)
    {
        return callable == nullptr;
    }
    else if constexpr (IsFunctionWrapper<T>::value)
    {
        return !callable;
    }
    else
    {
        return false;
    }
}

// Callables up to three pointers in size live inside the function, so function pointers,
// reference_wrappers and lambdas capturing a few references do not allocate.
union FunctionStorage
{
    void* pointer;
    alignas(void*) unsigned char buffer[3 * sizeof(void*)];
};

template <class T>
inline constexpr bool StoredInPlace =
    sizeof(T) <= sizeof(FunctionStorage) && alignof(T) <= alignof(FunctionStorage) &&
    is_nothrow_move_constructible_v<T>;

template <class T> T* StoredCallable(FunctionStorage& storage) noexcept
{
    if constexpr (StoredInPlace<T>)
    {
        return _FSTD::launder(reinterpret_cast<T*>(storage.buffer));
    }
    else
    {
        return static_cast<T*>(storage.pointer);
    }
}

template <class T> const T* StoredCallable(const FunctionStorage& storage) noexcept
{
    if constexpr (StoredInPlace<T>)
    {
        return _FSTD::launder(reinterpret_cast<const T*>(storage.buffer));
    }
    else
    {
        return static_cast<const T*>(storage.pointer);
    }
}

template <class Result, class... Args> struct FunctionOperations
{
    Result (*call)(FunctionStorage&, Args&&...);
    void (*copy)(const FunctionStorage& source, FunctionStorage& target);
    // Moves the callable out of source and ends its lifetime there.
    void (*move)(FunctionStorage& source, FunctionStorage& target) noexcept;
    void (*destroy)(FunctionStorage&) noexcept;
    const void* type;
};

template <class T, class Result, class... Args> struct FunctionOperationsFor
{
    static Result Call(FunctionStorage& storage, Args&&... args)
    {
        return _FSTD::invoke_r<Result>(*StoredCallable<T>(storage), _FSTD::forward<Args>(args)...);
    }

    static void Copy(const FunctionStorage& source, FunctionStorage& target)
    {
        if constexpr (StoredInPlace<T>)
        {
            ::new (static_cast<void*>(target.buffer)) T(*StoredCallable<T>(source));
        }
        else
        {
            target.pointer = new T(*StoredCallable<T>(source));
        }
    }

    static void Move(FunctionStorage& source, FunctionStorage& target) noexcept
    {
        if constexpr (StoredInPlace<T>)
        {
            T* callable = StoredCallable<T>(source);
            ::new (static_cast<void*>(target.buffer)) T(_FSTD::move(*callable));
            _FSTD::destroy_at(callable);
        }
        else
        {
            target.pointer = source.pointer;
        }
    }

    static void Destroy(FunctionStorage& storage) noexcept
    {
        if constexpr (StoredInPlace<T>)
        {
            _FSTD::destroy_at(StoredCallable<T>(storage));
        }
        else
        {
            delete StoredCallable<T>(storage);
        }
    }

    static constexpr FunctionOperations<Result, Args...> Table = {&Call, &Copy, &Move, &Destroy,
                                                                  &TypeTag<T>};
};
} // namespace __detail

template <class Result, class... Args> class function<Result(Args...)>
{
    template <class F>
    static constexpr bool Accepts =
        !is_same_v<remove_cvref_t<F>, function> && is_copy_constructible_v<decay_t<F>> &&
        is_invocable_r_v<Result, decay_t<F>&, Args...>;

public:
    using result_type = Result;

    function() noexcept = default;
    function(nullptr_t) noexcept {}

    function(const function& other)
    {
        if (other.m_operations != nullptr)
        {
            other.m_operations->copy(other.m_storage, m_storage);
            m_operations = other.m_operations;
        }
    }

    function(function&& other) noexcept
    {
        TakeFrom(other);
    }

    template <class F>
        requires Accepts<F>
    function(F&& callable)
    {
        using T = decay_t<F>;
        if (__detail::IsNullCallable<T>(callable))
        {
            return;
        }
        if constexpr (__detail::StoredInPlace<T>)
        {
            ::new (static_cast<void*>(m_storage.buffer)) T(_FSTD::forward<F>(callable));
        }
        else
        {
            m_storage.pointer = new T(_FSTD::forward<F>(callable));
        }
        m_operations = &__detail::FunctionOperationsFor<T, Result, Args...>::Table;
    }

    ~function()
    {
        Reset();
    }

    function& operator=(const function& other)
    {
        function(other).swap(*this);
        return *this;
    }

    function& operator=(function&& other) noexcept
    {
        if (this != &other)
        {
            Reset();
            TakeFrom(other);
        }
        return *this;
    }

    function& operator=(nullptr_t) noexcept
    {
        Reset();
        return *this;
    }

    template <class F>
        requires Accepts<F>
    function& operator=(F&& callable)
    {
        function(_FSTD::forward<F>(callable)).swap(*this);
        return *this;
    }

    template <class F> function& operator=(reference_wrapper<F> callable) noexcept
    {
        function(callable).swap(*this);
        return *this;
    }

    void swap(function& other) noexcept
    {
        if (this == &other)
        {
            return;
        }
        function moved(_FSTD::move(other));
        other.TakeFrom(*this);
        TakeFrom(moved);
    }

    explicit operator bool() const noexcept
    {
        return m_operations != nullptr;
    }

    Result operator()(Args... args) const
    {
        if (m_operations == nullptr)
        {
            __detail::LibraryAbort("bad_function_call: an empty std::function was called");
        }
        return m_operations->call(m_storage, _FSTD::forward<Args>(args)...);
    }

    template <class T> T* target() noexcept
    {
        return Holds<T>() ? __detail::StoredCallable<T>(m_storage) : nullptr;
    }

    template <class T> const T* target() const noexcept
    {
        return Holds<T>() ? __detail::StoredCallable<T>(m_storage) : nullptr;
    }

private:
    template <class T> bool Holds() const noexcept
    {
        return m_operations != nullptr && m_operations->type == &__detail::TypeTag<T>;
    }

    // Only into an empty function.
    void TakeFrom(function& other) noexcept
    {
        if (other.m_operations != nullptr)
        {
            other.m_operations->move(other.m_storage, m_storage);
            m_operations = _FSTD::exchange(other.m_operations, nullptr);
        }
    }

    void Reset() noexcept
    {
        if (m_operations != nullptr)
        {
            m_operations->destroy(m_storage);
            m_operations = nullptr;
        }
    }

    // Mutable because the standard calls a non-const callable through a const function.
    mutable __detail::FunctionStorage m_storage{};
    const __detail::FunctionOperations<Result, Args...>* m_operations = nullptr;
};

