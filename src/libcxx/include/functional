// The call signature of a class's operator(), for function's deduction guide.
template <class T> struct CallSignature
{
};
template <class Result, class... Args> struct CallSignature<Result (*)(Args...)>
{
    using type = Result(Args...);
};
template <class Result, class... Args> struct CallSignature<Result (*)(Args...) noexcept>
{
    using type = Result(Args...);
};

#define FEATHEROS_CALL_SIGNATURE(qualifiers)                                                       \
    template <class Result, class Class, class... Args>                                            \
    struct CallSignature<Result (Class::*)(Args...) qualifiers>                                    \
    {                                                                                              \
        using type = Result(Args...);                                                              \
    };
#define FEATHEROS_CALL_SIGNATURES(cv)                                                              \
    FEATHEROS_CALL_SIGNATURE(cv)                                                                   \
    FEATHEROS_CALL_SIGNATURE(cv&)                                                                  \
    FEATHEROS_CALL_SIGNATURE(cv&&)                                                                 \
    FEATHEROS_CALL_SIGNATURE(cv noexcept)                                                          \
    FEATHEROS_CALL_SIGNATURE(cv& noexcept)                                                         \
    FEATHEROS_CALL_SIGNATURE(cv&& noexcept)

FEATHEROS_CALL_SIGNATURES()
FEATHEROS_CALL_SIGNATURES(const)
FEATHEROS_CALL_SIGNATURES(volatile)
FEATHEROS_CALL_SIGNATURES(const volatile)

#undef FEATHEROS_CALL_SIGNATURES
#undef FEATHEROS_CALL_SIGNATURE
