// mutex and recursive_mutex are pthread mutexes. The C library has no pthread_mutex_timedlock, so
// the timed mutexes are a flag under a pthread mutex with a condition variable to wait on, as
// libstdc++ does without it. What would throw system_error (unique_lock::lock without a mutex or
// when it already owns one, unlock when it owns none, a failing pthread call) calls the library's
// abort hook. The mutexes and lock_guard carry Clang's thread-safety annotations; unique_lock,
// whose ownership changes at run time, does not.

namespace FEATHEROS_STD_NAMESPACE
{

class FEATHEROS_CAPABILITY mutex
{
public:
    constexpr mutex() noexcept = default;
    mutex(const mutex&) = delete;
    mutex& operator=(const mutex&) = delete;

    void lock() FEATHEROS_ACQUIRE();
    [[nodiscard]] bool try_lock() FEATHEROS_TRY_ACQUIRE(true);
    void unlock() FEATHEROS_RELEASE();

    using native_handle_type = pthread_mutex_t*;
    [[nodiscard]] native_handle_type native_handle()
    {
        return &m_handle;
    }

private:
    pthread_mutex_t m_handle = PTHREAD_MUTEX_INITIALIZER;
};

class FEATHEROS_CAPABILITY recursive_mutex
{
public:
    recursive_mutex();
    ~recursive_mutex();
    recursive_mutex(const recursive_mutex&) = delete;
    recursive_mutex& operator=(const recursive_mutex&) = delete;

    void lock() FEATHEROS_ACQUIRE();
    [[nodiscard]] bool try_lock() noexcept FEATHEROS_TRY_ACQUIRE(true);
    void unlock() FEATHEROS_RELEASE();

    using native_handle_type = pthread_mutex_t*;
    [[nodiscard]] native_handle_type native_handle()
    {
        return &m_handle;
    }

private:
    pthread_mutex_t m_handle;
};

class FEATHEROS_CAPABILITY timed_mutex
{
public:
    timed_mutex() = default;
    timed_mutex(const timed_mutex&) = delete;
    timed_mutex& operator=(const timed_mutex&) = delete;

    void lock() FEATHEROS_ACQUIRE();
    [[nodiscard]] bool try_lock() FEATHEROS_TRY_ACQUIRE(true);
    template <class Rep, class Period>
    [[nodiscard]] bool try_lock_for(const chrono::duration<Rep, Period>& timeout)
        FEATHEROS_TRY_ACQUIRE(true)
    {
        return TryLockUntil(__detail::SteadyDeadlineAfter(timeout));
    }
    template <class Clock, class Duration>
    [[nodiscard]] bool try_lock_until(const chrono::time_point<Clock, Duration>& deadline)
        FEATHEROS_TRY_ACQUIRE(true)
    {
        static_assert(chrono::is_clock_v<Clock>);
        while (!TryLockUntil(__detail::SteadyDeadline(deadline)))
        {
            if (Clock::now() >= deadline)
            {
                return false;
            }
        }
        return true;
    }
    void unlock() FEATHEROS_RELEASE();

private:
    bool TryLockUntil(chrono::steady_clock::time_point deadline) FEATHEROS_TRY_ACQUIRE(true);

    pthread_mutex_t m_mutex = PTHREAD_MUTEX_INITIALIZER;
    __detail::Condition m_released;
    bool m_locked = false;
};

