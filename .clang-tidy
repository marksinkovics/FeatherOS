# Left out because a kernel and its C library do these on purpose: integers become pointers for
# MMIO and physical memory, enums match hardware and ABI widths, flag enums combine bits, layouts
# follow hardware, and libc implements strcpy and malloc(0) itself.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-signed-bitwise,
  -bugprone-branch-clone,
  -performance-no-int-to-ptr,
  -performance-enum-size,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-optin.performance.Padding,
  -clang-analyzer-security.insecureAPI.strcpy,
  -clang-analyzer-optin.portability.UnixAPI,
  clang-diagnostic-thread-safety*
# Clang's lock checking over the annotations in src/user/thread_safety.h; GCC has no such flag.
ExtraArgsBefore: ['-Wthread-safety']
CheckOptions:
  bugprone-implicit-widening-of-multiplication-result.IgnoreConstantIntExpr: true
WarningsAsErrors: '*'
HeaderFilterRegex: '.*src/.*'
FormatStyle: file
